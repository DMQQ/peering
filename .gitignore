# Xcode / SwiftPM build output.
# `build/` is also where xcodebuild is pointed via -derivedDataPath, so it holds
# several hundred MB of products and intermediate objects.
build/
DerivedData/
.build/
*.xcarchive

# Xcode per-user state. The shared schemes under xcshareddata are tracked; the
# per-user ones (window layout, which scheme was last selected) are not.
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# SwiftPM scratch state. Package.resolved is deliberately NOT ignored: once
# MacCastHost takes a dependency on swift-certificates, committing the resolved
# versions is what keeps a checkout reproducible.
.swiftpm/

# Cargo's build output for the relay, including the pinned toolchain's artefacts.
# `cargo init` writes its own .gitignore only when it creates a git repository,
# and the relay is a subdirectory of one that already exists — so the rule has to
# live here or several hundred MB of intermediates get committed.
Relay/target/

# macOS
.DS_Store

# Published Mac releases: the disk images are served by the relay out of `site/`, and they are
# build artefacts — tens of megabytes each, replaced on every version. The appcast beside them is
# generated by Sparkle's `generate_appcast` and is tracked only in its empty, pre-release form.
Relay/site/download/*.dmg
Relay/site/updates/*.dmg
Relay/site/updates/*.zip

# Claude Code session transcripts. The CLI writes one into the working directory at the start of
# a session, named from the session's own opening line — so the filenames are a date and whatever
# the first prompt happened to be, and a new one arrives every time. They are logs of a
# conversation, not inputs to the build, and nothing reads them.
*-local-command-caveatcaveat-the-messages-below.txt
*-this-session-is-being-continued-from-a-previous-c.txt

# Design-tool scratch state, written beside whatever it was pointed at.
.impeccable/
