<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The widget's privacy manifest, which is short because the widget is short.

  It collects nothing and tracks nothing, and it talks to nothing: a widget extension cannot open
  a socket to the relay, cannot see the app's own defaults and has no network of its own. What it
  does is read the App Group container, which is the whole reason that container exists — see the
  entitlement in `Config/MacCast.entitlements` and the note in `Shared/SessionActivityAttributes`.

  So one reason code, `1C8F.1`, for user defaults shared between the app and a member of its own
  App Group. The app's manifest carries the same code for the same store and the extra one for the
  store it keeps to itself.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
