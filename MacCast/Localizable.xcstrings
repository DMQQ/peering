    "Keep the Mac awake and on the network this iPhone is on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass den Mac wach und im selben Netzwerk wie dieses iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el Mac activo y en la red en la que está este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le Mac éveillé et sur le réseau de cet iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
