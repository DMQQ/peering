    "Forgot %@. Unpair this device on the Mac as well.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se olvidó %@. Desempareja también este dispositivo en el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oublié. Dissociez aussi cet appareil sur le Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entfernt. Löse die Kopplung dieses Geräts auch am Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esquecido. Desfaça também o pareamento deste dispositivo no Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を削除しました。Mac側でもこのデバイスのペアリングを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 삭제했습니다. Mac에서도 이 기기의 페어링을 해제하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除%@。也请在 Mac 上取消配对此设备。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ забыт. Отмените связывание этого устройства и на Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dimenticato. Annulla l'associazione di questo dispositivo anche sul Mac."
          }
        }
      }
    },
    "Looking for Macs on this network…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando Mac en esta red…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de Mac sur ce réseau…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Macs in diesem Netzwerk…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procurando Macs nesta rede…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワーク上のMacを探しています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 네트워크에서 Mac을 찾는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在此网络上查找 Mac…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск Mac в этой сети…"
          }
        },
        "it": {
