    "This shell has ended. Open a new shell to browse the server's files.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este shell ha terminado. Abre un shell nuevo para explorar los archivos del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce shell est terminé. Ouvrez un nouveau shell pour parcourir les fichiers du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Shell ist beendet. Öffne eine neue Shell, um die Dateien des Servers zu durchsuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este shell terminou. Abra um novo shell para navegar pelos arquivos do servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシェルは終了しました。サーバのファイルを閲覧するには、新しいシェルを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 셸은 종료되었습니다. 서버의 파일을 탐색하려면 새 셸을 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Shell 已结束。请打开一个新 Shell 来浏览服务器的文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот shell завершён. Откройте новый shell, чтобы просматривать файлы сервера."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa shell è terminata. Apri una nuova shell per sfogliare i file del server."
          }
        }
      }
    },
    "This cannot be undone on the server.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible sur le serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich auf dem Server nicht rückgängig machen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não pode ser desfeito no servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ上では取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서는 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在服务器上无法撤销。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нельзя отменить на сервере."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare sul server."
          }
        }
      }
    },
