    "Files an agent changed gather in one place, so you can look before you keep them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Agenten geänderte Dateien sammeln sich an einer Stelle, damit du sie prüfen kannst, bevor du sie behältst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos que cambia un agente se reúnen en un solo lugar para que los revises antes de conservarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers modifiés par un agent sont rassemblés au même endroit pour que vous les examiniez avant de les garder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file modificati da un agente si raccolgono in un unico posto, così puoi controllarli prima di tenerli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが変更したファイルは1か所に集まり、保存する前に確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 변경한 파일이 한곳에 모여 유지하기 전에 확인할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos que um agente alterou ficam reunidos em um só lugar, para você revisar antes de mantê-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы, изменённые агентом, собираются в одном месте, чтобы вы могли просмотреть их, прежде чем оставить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理更改过的文件会汇集在一处，方便你在保留前查看。"
          }
        }
      }
    },
