      }
    },
    "The server's key has changed since you last connected. If this was not you, do not continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüssel des Servers hat sich seit deiner letzten Verbindung geändert. Warst du das nicht, fahre nicht fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave del servidor ha cambiado desde la última vez que te conectaste. Si no fuiste tú, no continúes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé du serveur a changé depuis votre dernière connexion. Si ce n'était pas vous, ne continuez pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave del server è cambiata dall'ultima volta che ti sei connesso. Se non sei stato tu, non proseguire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の接続以降、サーバのキーが変わりました。心当たりがない場合は、続行しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막으로 연결한 이후 서버의 키가 바뀌었습니다. 본인이 한 일이 아니라면 계속하지 마세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave do servidor mudou desde a última vez que você se conectou. Se não foi você, não continue."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ сервера изменился с момента вашего последнего подключения. Если это были не вы, не продолжайте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自你上次连接以来，服务器的密钥已更改。如果这不是你所为，请不要继续。"
          }
        }
      }
    },
    "The server's side" : {
      "localizations" : {
