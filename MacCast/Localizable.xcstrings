        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기가 아니라 Mac에서 실행됩니다. 연결을 해제해도 계속 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
