          "stringUnit": {
            "state": "translated",
            "value": "제어 센터에서 세로 방향 잠금을 끄고 휴대폰을 옆으로 돌리세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在控制中心关闭“旋转锁定”，然后把手机横过来。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите блокировку ориентации в Пункте управления, затем поверните телефон на бок."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva il blocco della rotazione nel Centro di Controllo, poi metti il telefono di lato."
          }
        }
      }
    },
