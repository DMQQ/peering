    "Install Peering on your Mac, compare a six-digit code, and you are connected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Peering en tu Mac, compara un código de seis dígitos y ya estás conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Peering sur votre Mac, comparez un code à six chiffres, et vous êtes connecté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Peering auf deinem Mac, vergleiche einen sechsstelligen Code, und du bist verbunden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Peering no seu Mac, compare um código de seis dígitos e você está conectado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacにPeeringをインストールし、6桁のコードを照合すれば、接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 Peering을 설치하고 여섯 자리 코드를 비교하면 연결됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Mac 上安装 Peering，比对一个六位数字代码，就已连接。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите Peering на Mac, сравните шестизначный код, и вы подключены."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa Peering sul tuo Mac, confronta un codice a sei cifre e sei connesso."
          }
        }
      }
    },
    "Your whole Mac, not a compromise": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo tu Mac, sin concesiones"
