    "Touch, and zoom": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar y hacer zoom"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher et zoomer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühren und zoomen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar e dar zoom"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチとズーム"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치와 확대"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控与缩放"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Касание и масштаб"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e zoom"
          }
        }
      }
    },
    "Tap and drag to control the Mac; pinch to zoom in and out of the picture.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y arrastra para controlar el Mac; pellizca para acercar y alejar la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et faites glisser pour contrôler le Mac ; pincez pour zoomer et dézoomer sur l'image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe und ziehe, um den Mac zu steuern; spreize, um in das Bild hinein- und herauszuzoomen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e arraste para controlar o Mac; faça o gesto de pinça para aproximar e afastar a imagem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップとドラッグでMacを操作し、ピンチで映像を拡大縮小します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하고 드래그해 Mac을 제어하고, 핀치로 화면을 확대하거나 축소합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点并拖动来控制 Mac；双指张合来放大和缩小画面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Касайтесь и перетаскивайте, чтобы управлять Mac; сводите пальцы, чтобы приближать и отдалять картинку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e trascina per controllare il Mac; pizzica per ingrandire e rimpicciolire l'immagine."
          }
        }
      }
    },
    "Trackpad, pointer and scroll wheel": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad, puntero y rueda de desplazamiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad, pointeur et molette"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad, Zeiger und Scrollrad"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad, ponteiro e roda de rolagem"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックパッド、ポインタ、スクロールホイール"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙패드, 포인터, 스크롤 휠"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控板、指针和滚轮"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трекпад, указатель и колесо прокрутки"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad, puntatore e rotella"
          }
        }
      }
    },
    "A relative pointer for the small corrections a fingertip cannot make, and a notched wheel that scrolls the Mac a line at a time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un puntero relativo para las pequeñas correcciones que un dedo no puede hacer, y una rueda con muescas que desplaza el Mac línea a línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pointeur relatif pour les petites corrections qu'un doigt ne peut pas faire, et une molette crantée qui fait défiler le Mac ligne par ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein relativer Zeiger für die kleinen Korrekturen, die eine Fingerspitze nicht schafft, und ein gerastetes Rad, das den Mac zeilenweise scrollt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ponteiro relativo para as pequenas correções que a ponta do dedo não faz, e uma roda com entalhes que rola o Mac uma linha por vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指先ではできない細かい調整のための相対ポインタと、Macを1行ずつスクロールするクリック感のあるホイール。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손끝으로는 할 수 없는 작은 보정을 위한 상대 포인터와, Mac을 한 줄씩 스크롤하는 클릭감 있는 휠."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于指尖做不到的微小修正的相对指针，以及一次滚动 Mac 一行的带档位滚轮。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Относительный указатель для мелких поправок, которые не сделать кончиком пальца, и колесо с щелчками, прокручивающее Mac по строке."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un puntatore relativo per le piccole correzioni che un polpastrello non può fare, e una rotella a scatti che scorre il Mac una riga alla volta."
          }
        }
      }
    },
    "Keyboard, on screen or attached": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclado, en pantalla o conectado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clavier, à l'écran ou connecté"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastatur, auf dem Bildschirm oder angeschlossen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclado, na tela ou conectado"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード、画面上でも接続でも"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드, 화면 또는 연결된 것"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘，屏幕上的或外接的"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура на экране или подключённая"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastiera, su schermo o collegata"
          }
        }
      }
    },
    "Type with the system keyboard or a Bluetooth one, with the modifier keys the Mac expects.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe con el teclado del sistema o uno Bluetooth, con las teclas modificadoras que espera el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez avec le clavier du système ou un clavier Bluetooth, avec les touches de modification qu'attend le Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe mit der Systemtastatur oder einer Bluetooth-Tastatur, mit den Sondertasten, die der Mac erwartet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite com o teclado do sistema ou um Bluetooth, com as teclas modificadoras que o Mac espera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのキーボードやBluetoothキーボードで、Macが期待する修飾キー付きで入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 키보드나 블루투스 키보드로, Mac이 기대하는 수정자 키와 함께 입력합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用系统键盘或蓝牙键盘输入，带有 Mac 期望的修饰键。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печатайте системной клавиатурой или Bluetooth, с клавишами-модификаторами, которых ждёт Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi con la tastiera di sistema o una Bluetooth, con i tasti modificatori che il Mac si aspetta."
          }
        }
      }
    },
    "Observe without touching": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observar sin tocar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observer sans toucher"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachten ohne Berühren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Observar sem tocar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "触らずに見る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만지지 않고 관찰"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只看不碰"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наблюдать, не касаясь"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osserva senza toccare"
          }
        }
      }
    },
    "A mode that shows the screen and sends no input at all.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modo que muestra la pantalla y no envía ninguna entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mode qui affiche l'écran et n'envoie aucune saisie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Modus, der den Bildschirm zeigt und gar keine Eingaben sendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um modo que mostra a tela e não envia nenhuma entrada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を表示し、入力をまったく送らないモードです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 보여 주고 입력은 전혀 보내지 않는 모드입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一种显示屏幕但完全不发送任何输入的模式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим, который показывает экран и вообще не отправляет ввод."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una modalità che mostra lo schermo e non invia alcun input."
          }
        }
      }
    },
    "Lock the Mac, or darken it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea el Mac, u oscurécelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller le Mac, ou l'assombrir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Mac sperren oder abdunkeln"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear o Mac, ou escurecê-lo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macをロック、または暗くする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 잠그기 또는 어둡게"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定 Mac，或调暗它"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировать Mac или затемнить его"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca il Mac, o oscuralo"
          }
        }
      }
    },
    "Lock the Mac from the session screen, or put its displays out without ending the session.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea el Mac desde la pantalla de sesión, o apaga sus pantallas sin terminar la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillez le Mac depuis l'écran de session, ou éteignez ses écrans sans terminer la session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperre den Mac vom Sitzungsbildschirm aus oder schalte seine Displays aus, ohne die Sitzung zu beenden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueie o Mac pela tela da sessão, ou apague suas telas sem encerrar a sessão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッション画面からMacをロックするか、セッションを終えずにディスプレイを消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 화면에서 Mac을 잠그거나, 세션을 끝내지 않고 디스플레이를 끕니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从会话屏幕锁定 Mac，或在不结束会话的情况下关闭它的显示器。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокируйте Mac с экрана сеанса или погасите его дисплеи, не завершая сеанс."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca il Mac dalla schermata di sessione, o spegni i suoi display senza terminare la sessione."
          }
        }
      }
    },
    "Clipboard, and its history": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles y su historial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers et son historique"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablage und ihr Verlauf"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Área de transferência e seu histórico"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードとその履歴"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드와 그 기록"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板及其历史记录"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена и его история"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appunti e la loro cronologia"
          }
        }
      }
    },
    "Pull the Mac's clipboard onto the phone, and keep what you pulled earlier.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae el portapapeles del Mac al teléfono y conserva lo que trajiste antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérez le presse-papiers du Mac sur le téléphone et gardez ce que vous avez récupéré plus tôt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hole die Zwischenablage des Macs auf das Telefon und behalte, was du früher geholt hast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe a área de transferência do Mac para o telefone e guarde o que você puxou antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacのクリップボードをiPhoneに取得し、以前に取得したものも保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 클립보드를 iPhone으로 가져오고, 이전에 가져온 것도 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Mac 的剪贴板取回到手机，并保留你之前取回的内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забирайте буфер обмена Mac на телефон и сохраняйте то, что забрали раньше."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preleva gli appunti del Mac sul telefono e tieni ciò che hai prelevato prima."
          }
        }
      }
    },
    "Save a sequence and fire it with one tap, for the things you type every time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una secuencia y ejecútala con un toque, para lo que escribes siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une séquence et lancez-la d'un toucher, pour ce que vous tapez à chaque fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eine Abfolge und löse sie mit einem Tippen aus, für das, was du jedes Mal tippst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve uma sequência e dispare com um toque, para o que você digita sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎回入力するものを、一連の操作として保存し、ワンタップで実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매번 입력하는 것을 시퀀스로 저장해 탭 한 번으로 실행하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存一个序列并轻点一下执行，用于你每次都要输入的内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните последовательность и запускайте одним касанием, для того, что вы печатаете каждый раз."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una sequenza e lanciala con un tocco, per ciò che scrivi ogni volta."
          }
        }
      }
    },
    "Snippets and quick commands": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragmentos y comandos rápidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extraits et commandes rapides"
          }
        },
        "de": {
          "stringUnit": {
