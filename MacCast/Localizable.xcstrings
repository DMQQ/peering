    "The name shown to Macs when you connect. Tap the name to edit it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre que ven los Mac al conectarte. Toca el nombre para editarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom montré aux Mac quand vous vous connectez. Touchez le nom pour le modifier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name, den Macs beim Verbinden sehen. Tippe auf den Namen, um ihn zu bearbeiten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome mostrado aos Macs quando você se conecta. Toque no nome para editá-lo."
          }
        },
        "ja": {
