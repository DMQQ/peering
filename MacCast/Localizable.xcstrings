    "A notification when a Mac is waiting on a pairing code, a password prompt, or a terminal that has stopped for an answer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación cuando un Mac espera un código de emparejamiento, una solicitud de contraseña o un terminal que se ha detenido esperando una respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification quand un Mac attend un code d'association, une demande de mot de passe, ou un terminal arrêté en attente d'une réponse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung, wenn ein Mac auf einen Kopplungscode, eine Passwortabfrage oder ein Terminal wartet, das für eine Antwort angehalten hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação quando um Mac espera por um código de pareamento, um pedido de senha ou um terminal que parou esperando uma resposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがペアリングコード、パスワードの要求、または応答を待って止まったターミナルを待っているとき、通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 페어링 코드, 비밀번호 요청 또는 답을 기다리며 멈춘 터미널을 기다릴 때 알림을 보냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Mac 在等待配对代码、密码提示，或因等待回答而停下的终端时发出通知。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомление, когда Mac ждёт код связывания, запрос пароля или терминал, остановившийся в ожидании ответа."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notifica quando un Mac attende un codice di associazione, una richiesta di password o un terminale fermo in attesa di una risposta."
          }
        }
      }
    },
    "What you have used": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que has usado"
          }
        },
        "fr": {
