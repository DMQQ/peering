    "Allow or deny Claude Code prompts from any terminal or editor, and reply to a finished turn right from its notification." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube oder verweigere Claude-Code-Anfragen aus jedem Terminal oder Editor und antworte auf eine abgeschlossene Runde direkt in der Mitteilung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite o deniega las solicitudes de Claude Code desde cualquier terminal o editor, y responde a un turno terminado directamente desde su notificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez ou refusez les demandes de Claude Code depuis n'importe quel terminal ou éditeur, et répondez à un tour terminé directement depuis sa notification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti o nega le richieste di Claude Code da qualsiasi terminale o editor, e rispondi a un turno concluso direttamente dalla notifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのターミナルやエディタからでも Claude Code の確認を許可・拒否でき、完了したターンへの返信も通知からそのまま行えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 터미널이나 편집기에서 오는 Claude Code 요청이든 허용하거나 거부할 수 있고, 끝난 턴에 대한 답장도 알림에서 바로 보낼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita ou negue os pedidos do Claude Code de qualquer terminal ou editor e responda a um turno concluído direto da notificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешайте или отклоняйте запросы Claude Code из любого терминала или редактора и отвечайте на завершённый ход прямо из уведомления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何终端或编辑器中，都可以允许或拒绝 Claude Code 的请求，并直接在通知里回复已完成的一轮。"
          }
        }
      }
    },
