            "value": "No hay compras que restaurar en este Apple Account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat à restaurer sur cet Apple Account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Käufe zum Wiederherstellen für diesen Apple Account."
          }
        },
        "pt-BR": {
          "stringUnit": {
