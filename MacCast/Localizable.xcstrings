    "Runs on your Mac, not here. It keeps going when you disconnect.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta en tu Mac, no aquí. Sigue funcionando al desconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'exécute sur votre Mac, pas ici. Continue de tourner après la déconnexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft auf deinem Mac, nicht hier. Läuft weiter, wenn du die Verbindung trennst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda no seu Mac, não aqui. Continua quando você desconecta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではなくMacで動いています。切断しても動き続けます。"
          }
