        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Snippet e comandi rapidi"
          }
        }
      }
    },
    "The commands you keep one tap away, above the keyboard, in every terminal.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comandos que tienes a un toque, sobre el teclado, en cada terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes que vous gardez à un toucher, au-dessus du clavier, dans chaque terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Befehle, die du einen Tipp entfernt hast, über der Tastatur, in jedem Terminal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comandos que você mantém a um toque, acima do teclado, em todo terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの上に、すべてのターミナルで、ワンタップの距離にあるコマンド。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 위, 모든 터미널에서 탭 한 번 거리에 두는 명령."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你放在一键之遥的命令，在键盘上方，在每个终端中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды, которые вы держите на расстоянии касания, над клавиатурой, в каждом терминале."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I comandi che tieni a un tocco, sopra la tastiera, in ogni terminale."
          }
        }
      }
    },
    "Terminals and files": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminales y archivos"
          }
        },
        "fr": {
