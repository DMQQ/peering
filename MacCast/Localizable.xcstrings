    "Text from another app. Allow pasting in Settings > Peering to skip the prompt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text aus einer anderen App. Erlaube das Einfügen unter Einstellungen > Peering, um die Nachfrage zu überspringen."
