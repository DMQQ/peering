          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя, которое видят Mac при подключении. Коснитесь имени, чтобы изменить его."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
