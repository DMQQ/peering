    "The connection ended while %@ was held on the Mac. It may still be held there.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión terminó mientras %@ estaba retenido en el Mac. Puede que siga retenido allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion s'est terminée pendant que %@ était maintenu sur le Mac. Il l'est peut-être encore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung endete, während %@ auf dem Mac gehalten wurde. Möglicherweise wird es dort noch gehalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão terminou enquanto %@ estava retido no Mac. Ele ainda pode estar retido lá."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がMacで保持されている間に接続が終了しました。まだそこで保持されている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) Mac에 유지되는 동안 연결이 끝났습니다. 아직 그곳에 유지되고 있을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在 Mac 上被按住时连接结束了。它可能仍被按在那里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение завершилось, пока %@ удерживалось на Mac. Оно может всё ещё удерживаться там."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione è terminata mentre %@ era trattenuto sul Mac. Potrebbe essere ancora trattenuto lì."
          }
        }
      }
    },
