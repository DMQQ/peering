    "That passcode is not right for this server.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no es correcto para este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code n'est pas le bon pour ce serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist für diesen Server nicht richtig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código não está certo para este servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバのパスコードが正しくありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버의 암호가 맞지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密码对该服务器不正确。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код-пароль не подходит для этого сервера."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice non è giusto per questo server."
          }
        }
      }
    },
    "The passcode you set for this server, not the one for your iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código que definiste para este servidor, no el de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code que vous avez défini pour ce serveur, pas celui de votre iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code, den du für diesen Server festgelegt hast, nicht der deines iPhones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código que você definiu para este servidor, não o do seu iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバ用に設定したパスコードです。iPhoneのパスコードではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에 설정한 암호이며, iPhone 암호가 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你为此服务器设置的密码，不是 iPhone 的密码。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код-пароль, который вы задали для этого сервера, а не от вашего iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice che hai impostato per questo server, non quello del tuo iPhone."
          }
        }
      }
    },
    "This server is locked to the owner of this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está bloqueado para el propietario de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur est verrouillé pour le propriétaire de cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server ist für den Besitzer dieses Geräts gesperrt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está bloqueado para o dono deste dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバは、このデバイスの所有者用にロックされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 이 기기의 소유자에게 잠겨 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器已锁定，仅限此设备的所有者使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер заблокирован для владельца этого устройства."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server è bloccato per il proprietario di questo dispositivo."
          }
        }
      }
    },
    "This iPhone has no passcode set, so there is no way to answer this server's lock. Set one in Settings, or turn the lock off for this server.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no tiene código, así que no hay forma de responder al bloqueo de este servidor. Configura uno en Ajustes, o desactiva el bloqueo de este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone n'a pas de code, il est donc impossible de répondre au verrouillage de ce serveur. Définissez-en un dans Réglages, ou désactivez le verrouillage pour ce serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone ist kein Code eingerichtet, die Sperre dieses Servers kann also nicht beantwortet werden. Richte einen in den Einstellungen ein oder schalte die Sperre für diesen Server aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone não tem código definido, então não há como responder ao bloqueio deste servidor. Defina um em Ajustes ou desative o bloqueio deste servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneにはパスコードが設定されていないため、このサーバのロックに応答できません。設定でパスコードを設定するか、このサーバのロックをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에는 암호가 설정되어 있지 않아 이 서버의 잠금에 응답할 수 없습니다. 설정에서 암호를 설정하거나 이 서버의 잠금을 끄세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 未设置密码，因此无法回应此服务器的锁定。请在“设置”中设置密码，或关闭此服务器的锁定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом iPhone не задан код-пароль, поэтому ответить на блокировку этого сервера нельзя. Задайте его в Настройках или отключите блокировку для этого сервера."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPhone non ha un codice impostato, quindi non c'è modo di rispondere al blocco di questo server. Impostane uno in Impostazioni o disattiva il blocco per questo server."
          }
        }
      }
    },
    "%lld of %lld digits entered": {
