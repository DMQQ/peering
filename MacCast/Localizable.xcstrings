    "Lock the Mac from the session screen, or put its displays out without ending the session." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre den Mac vom Sitzungsbildschirm aus oder schalte seine Displays aus, ohne die Sitzung zu beenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea el Mac desde la pantalla de sesión, o apaga sus pantallas sin terminar la sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillez le Mac depuis l'écran de session, ou éteignez ses écrans sans terminer la session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca il Mac dalla schermata di sessione, o spegni i suoi display senza terminare la sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション画面からMacをロックするか、セッションを終えずにディスプレイを消します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 화면에서 Mac을 잠그거나, 세션을 끝내지 않고 디스플레이를 끕니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueie o Mac pela tela da sessão, ou apague suas telas sem encerrar a sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокируйте Mac с экрана сеанса или погасите его дисплеи, не завершая сеанс."
