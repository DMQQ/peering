    },
    "It appears with the suggestions in every new chat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er erscheint in jedem neuen Chat bei den Vorschlägen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece con las sugerencias en cada chat nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il apparaît avec les suggestions dans chaque nouveau chat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appare con i suggerimenti in ogni nuova chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいチャットごとに候補と一緒に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 채팅마다 추천 항목과 함께 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
