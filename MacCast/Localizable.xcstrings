    "The Mac's own clipboard is untouched. This only forgets what this device kept.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles del Mac no se toca. Esto solo olvida lo que guardó este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers du Mac n'est pas touché. Cela n'oublie que ce que cet appareil a gardé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage des Macs bleibt unberührt. Dies vergisst nur, was dieses Gerät gespeichert hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência do Mac não é alterada. Isso só esquece o que este dispositivo guardou."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac自体のクリップボードには影響しません。このデバイスが保持していた内容だけを消去します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 클립보드는 건드리지 않습니다. 이 기기가 보관한 내용만 지웁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会影响 Mac 自己的剪贴板。这只会忘记此设备保存的内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена Mac не затрагивается. Это лишь забывает то, что сохранило это устройство."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli appunti del Mac non vengono toccati. Questo dimentica solo ciò che ha conservato questo dispositivo."
          }
        }
      }
    },
