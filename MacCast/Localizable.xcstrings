          "stringUnit": {
            "state": "translated",
            "value": "연결을 보호하는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保护连接…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защита соединения…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messa in sicurezza della connessione…"
          }
        }
      }
    },
