    "The connection ended before the server answered.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión terminó antes de que el servidor respondiera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion s'est terminée avant que le serveur ne réponde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wurde beendet, bevor der Server antwortete."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão terminou antes de o servidor responder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバが応答する前に接続が終了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 응답하기 전에 연결이 종료되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
