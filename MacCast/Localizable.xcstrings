    "Download what you are looking at to the phone and hand it to Files, or to anything else in the share sheet." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade das, was du ansiehst, auf das Telefon und übergib es an Dateien oder alles andere im Teilen-Menü."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga lo que estás viendo en el teléfono y pásalo a Archivos o a cualquier otra cosa de la hoja de compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez ce que vous regardez sur le téléphone et confiez-le à Fichiers, ou à tout autre élément de la feuille de partage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica ciò che stai guardando sul telefono e passalo a File, o a qualsiasi altra cosa del foglio di condivisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見ているものをiPhoneにダウンロードして、「ファイル」や共有シートの他のものに渡します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고 있는 것을 iPhone으로 다운로드하고 파일 앱이나 공유 시트의 다른 어디로든 넘깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe o que você está vendo para o telefone e entregue ao Arquivos, ou a qualquer outra coisa da folha de compartilhamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачайте то, на что вы смотрите, на телефон и передайте в «Файлы» или во что угодно из меню «Поделиться»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你正在看的内容下载到手机，并交给“文件”或共享表单中的任何其他选项。"
          }
        }
