    "%@ It is not in %@. %@ adds it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ No está en %@. %@ lo añade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ce n'est pas dans %@. %@ l'ajoute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Es ist nicht in %@ enthalten. %@ fügt es hinzu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Não está no %@. O %@ o acrescenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ これは%@には含まれていません。%@で追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@에는 없습니다. %@에서 추가됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@中没有它。%@会添加它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Этого нет в %@. %@ добавляет это."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Non è in %@. %@ lo aggiunge."
          }
        }
      }
    },
    "%@ Your plan already includes it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tu plan ya lo incluye."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Votre formule l'inclut déjà."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Dein Tarif enthält es bereits."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Seu plano já o inclui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ご利用のプランにはすでに含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 현재 플랜에 이미 포함되어 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 你的套餐已包含它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ваш тариф уже это включает."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Il tuo piano lo include già."
          }
        }
      }
    },
    "Your free relay time for today is used up. Upgrade to connect from anywhere without limits.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has agotado tu tiempo de relay gratuito de hoy. Mejora para conectarte desde cualquier lugar sin límites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre temps de relais gratuit d'aujourd'hui est épuisé. Passez à une formule supérieure pour vous connecter de n'importe où sans limite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine kostenlose Relay-Zeit für heute ist aufgebraucht. Upgrade, um dich ohne Limit von überall zu verbinden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu tempo de relay grátis de hoje acabou. Faça upgrade para se conectar de qualquer lugar sem limites."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の無料リレー時間を使い切りました。アップグレードすると、どこからでも制限なく接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 무료 릴레이 시간을 모두 사용했습니다. 업그레이드하면 어디서든 제한 없이 연결할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天的免费中继时间已用完。升级后即可无限制地从任何地方连接。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше бесплатное время релея на сегодня исчерпано. Перейдите на другой тариф, чтобы подключаться откуда угодно без ограничений."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo tempo di relay gratuito di oggi è esaurito. Passa a un piano superiore per connetterti da ovunque senza limiti."
          }
        }
      }
    },
    "The relay counted this connection against a quota your plan does not have. Try again, and tell us if it keeps happening.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relay contó esta conexión contra un cupo que tu plan no tiene. Inténtalo de nuevo y avísanos si sigue ocurriendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais a compté cette connexion sur un quota que votre formule n'a pas. Réessayez, et dites-le-nous si cela continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Relay hat diese Verbindung gegen ein Kontingent gezählt, das dein Tarif nicht hat. Versuche es erneut und sag uns Bescheid, wenn es weiter passiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relay contou esta conexão contra uma cota que seu plano não tem. Tente de novo e nos avise se continuar acontecendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーは、ご利用のプランにはない枠にこの接続を数えました。もう一度お試しください。繰り返し起こる場合はお知らせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이가 이 연결을 현재 플랜에 없는 허용량으로 계산했습니다. 다시 시도해 보시고, 계속되면 알려 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中继把此次连接计入了你的套餐没有的额度。请重试，如果持续发生请告诉我们。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Релей засчитал это подключение против лимита, которого нет у вашего тарифа. Повторите попытку и сообщите нам, если это повторяется."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relay ha contato questa connessione su una quota che il tuo piano non ha. Riprova e faccelo sapere se continua a succedere."
          }
        }
      }
    },
    "Reaching a Mac on another network runs on the relay, which is metered. Free includes %@ a day. Any paid plan removes the limit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegar a un Mac en otra red funciona con el relay, que tiene medidor. Lo gratuito incluye %@ al día. Cualquier plan de pago elimina el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteindre un Mac sur un autre réseau passe par le relais, qui est mesuré. Le gratuit comprend %@ par jour. Toute formule payante supprime la limite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Mac in einem anderen Netzwerk zu erreichen läuft über das Relay, das gemessen wird. Kostenlos enthält %@ pro Tag. Jeder bezahlte Tarif hebt das Limit auf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcançar um Mac em outra rede usa o relay, que é medido. O grátis inclui %@ por dia. Qualquer plano pago remove o limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のネットワークにあるMacへの接続はリレーを使い、従量で計測されます。無料プランには1日%@が含まれます。有料プランなら上限がなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 네트워크의 Mac에 닿는 것은 계량되는 릴레이로 동작합니다. 무료에는 하루 %@가 포함됩니다. 유료 플랜은 제한을 없앱니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接其他网络上的 Mac 要通过中继，中继是计量的。免费版每天包含 %@。任何付费套餐都会取消限制。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к Mac в другой сети идёт через релей, который измеряется. Бесплатный тариф включает %@ в день. Любой платный тариф снимает лимит."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiungere un Mac su un'altra rete passa dal relay, che è misurato. Il gratis include %@ al giorno. Qualsiasi piano a pagamento rimuove il limite."
          }
        }
      }
    },
    "That was your first session. Relay is the part of Peering that reaches your Mac when this device is not on the same network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa fue tu primera sesión. El relay es la parte de Peering que llega a tu Mac cuando este dispositivo no está en la misma red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'était votre première session. Le relais est la partie de Peering qui atteint votre Mac quand cet appareil n'est pas sur le même réseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war deine erste Sitzung. Das Relay ist der Teil von Peering, der deinen Mac erreicht, wenn dieses Gerät nicht im selben Netzwerk ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa foi sua primeira sessão. O relay é a parte do Peering que alcança seu Mac quando este dispositivo não está na mesma rede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のセッションでした。リレーは、このデバイスが同じネットワークにないときにMacへ届くPeeringの部分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 세션이었습니다. 릴레이는 이 기기가 같은 네트워크에 없을 때 Mac에 닿는 Peering의 부분입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那是你的第一次会话。中继是 Peering 在此设备与 Mac 不在同一网络时到达你的 Mac 的部分。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это был ваш первый сеанс. Релей это часть Peering, которая достигает вашего Mac, когда это устройство не в той же сети."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella era la tua prima sessione. Il relay è la parte di Peering che raggiunge il tuo Mac quando questo dispositivo non è sulla stessa rete."
          }
        }
      }
    },
    "%@ Free includes %@ of relay a day. Any paid plan removes the limit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Lo gratuito incluye %@ de relay al día. Cualquier plan de pago elimina el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Le gratuit comprend %@ de relais par jour. Toute formule payante supprime la limite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kostenlos enthält %@ Relay pro Tag. Jeder bezahlte Tarif hebt das Limit auf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ O grátis inclui %@ de relay por dia. Qualquer plano pago remove o limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無料プランには1日%@のリレーが含まれます。有料プランなら上限がなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 무료에는 하루 %@의 릴레이가 포함됩니다. 유료 플랜은 제한을 없앱니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 免费版每天包含 %@ 的中继。任何付费套餐都会取消限制。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Бесплатный тариф включает %@ релея в день. Любой платный тариф снимает лимит."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Il gratis include %@ di relay al giorno. Qualsiasi piano a pagamento rimuove il limite."
          }
        }
      }
    },
    "%@ You are already subscribed, so there was no meter on this one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ya estás suscrito, así que no había medidor en esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vous êtes déjà abonné, il n'y avait donc pas de compteur sur celle-ci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Du hast bereits abonniert, daher gab es bei dieser keine Messung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Você já é assinante, então não havia medidor nesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ すでに購読中なので、このセッションにはメーターがありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 이미 구독 중이므로 이 세션에는 미터가 없었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 你已订阅，所以这次会话没有计量。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Вы уже подписаны, так что на этом сеансе счётчика не было."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sei già abbonato, quindi su questa non c'era un contatore."
          }
        }
      }
    },
    "%@ Your plan already includes unlimited relay, so there is nothing here to buy.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tu plan ya incluye relay ilimitado, así que aquí no hay nada que comprar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Votre formule inclut déjà un relais illimité, il n'y a donc rien à acheter ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Dein Tarif enthält bereits unbegrenztes Relay, es gibt hier also nichts zu kaufen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Seu plano já inclui relay ilimitado, então não há nada para comprar aqui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ご利用のプランにはすでに無制限のリレーが含まれているので、ここで購入するものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 현재 플랜에 이미 무제한 릴레이가 포함되어 있어 여기서 살 것은 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 你的套餐已包含无限中继，所以这里没有可买的东西。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ваш тариф уже включает безлимитный релей, так что покупать здесь нечего."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Il tuo piano include già il relay illimitato, quindi qui non c'è nulla da comprare."
          }
        }
      }
    },
    "%@ left today. When it runs out, reaching a Mac on another network stops until the allowance comes back. Any paid plan removes the limit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restantes hoy. Cuando se agote, llegar a un Mac en otra red se detiene hasta que vuelva el cupo. Cualquier plan de pago elimina el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restant aujourd'hui. Quand il sera épuisé, atteindre un Mac sur un autre réseau s'arrête jusqu'au retour du quota. Toute formule payante supprime la limite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heute übrig. Ist sie aufgebraucht, hört das Erreichen eines Macs in einem anderen Netzwerk auf, bis das Kontingent zurückkommt. Jeder bezahlte Tarif hebt das Limit auf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restantes hoje. Quando acabar, alcançar um Mac em outra rede para até a cota voltar. Qualquer plano pago remove o limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 今日は残り。なくなると、枠が戻るまで別のネットワークにあるMacへは接続できません。有料プランなら上限がなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 오늘 남음. 다 되면 허용량이 돌아올 때까지 다른 네트워크의 Mac에 닿는 것이 중단됩니다. 유료 플랜은 제한을 없앱니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 今天还剩。用完后，连接其他网络上的 Mac 会停止，直到额度恢复。任何付费套餐都会取消限制。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ осталось на сегодня. Когда оно закончится, доступ к Mac в другой сети прекратится до возвращения лимита. Любой платный тариф снимает лимит."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rimasti oggi. Quando finisce, raggiungere un Mac su un'altra rete si ferma finché la quota non torna. Qualsiasi piano a pagamento rimuove il limite."
          }
        }
      }
    },
    "%@ left of today's relay time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restantes del tiempo de relay de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restant du temps de relais d'aujourd'hui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ der heutigen Relay-Zeit übrig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restantes do tempo de relay de hoje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のリレー時間は残り%@です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 릴레이 시간 %@ 남음."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的中继时间还剩 %@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ осталось от сегодняшнего времени релея."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rimasti del tempo di relay di oggi."
          }
        }
      }
    },
    "Free pairs with one Mac. This is every Mac after it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis empareja con un Mac. Esto es cada Mac a partir de ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le gratuit s'associe à un Mac. Ceci couvre tous les Mac suivants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos koppelt mit einem Mac. Das hier ist jeder weitere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O grátis pareia com um Mac. Isto é cada Mac depois dele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料では1台のMacとペアリングできます。これはその後のすべてのMacです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료는 Mac 한 대와 페어링됩니다. 이것은 그 이후의 모든 Mac입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版可与一台 Mac 配对。这是之后的每一台 Mac。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный тариф связывается с одним Mac. Это каждый следующий Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gratis si associa a un Mac. Questo è ogni Mac dopo."
          }
        }
      }
    },
    "One Mac at a time is free. This keeps them all open, so switching is a tap rather than a reconnection.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac a la vez es gratis. Esto los mantiene todos abiertos, así que cambiar es un toque y no una reconexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac à la fois est gratuit. Ceci les garde tous ouverts, si bien que passer de l'un à l'autre est un toucher et non une reconnexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Mac zur Zeit ist kostenlos. Das hier hält alle offen, sodass der Wechsel ein Tippen statt einer neuen Verbindung ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Mac por vez é grátis. Isto mantém todos abertos, então alternar é um toque e não uma reconexão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に1台のMacまでは無料です。これはすべてを開いたままにするので、切り替えは再接続ではなくタップ一つです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 Mac 한 대는 무료입니다. 이것은 모두 열어 두므로, 전환이 재연결이 아니라 탭 한 번입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次一台 Mac 是免费的。这会让它们全部保持打开，所以切换只需轻点一下而不是重新连接。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один Mac за раз бесплатно. Это держит все открытыми, так что переключение это касание, а не переподключение."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac alla volta è gratis. Questo li tiene tutti aperti, quindi passare dall'uno all'altro è un tocco e non una riconnessione."
          }
        }
      }
    },
    "Whatever the Mac is playing comes out of this device, from the music you left running to the alert it makes in answer to a key you sent it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que reproduce el Mac sale por este dispositivo, desde la música que dejaste sonando hasta el aviso que hace en respuesta a una tecla que enviaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que le Mac joue sort de cet appareil, de la musique laissée en route à l'alerte qu'il émet en réponse à une touche que vous avez envoyée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was der Mac abspielt, kommt aus diesem Gerät, von der Musik, die du laufen ließest, bis zum Signalton, den er als Antwort auf eine gesendete Taste macht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo que o Mac está tocando sai por este dispositivo, da música que você deixou tocando ao alerta que ele faz em resposta a uma tecla que você enviou."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが再生するものはすべてこのデバイスから出ます。流しっぱなしの音楽から、送ったキーに対して鳴らす通知音まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 재생하는 것은 모두 이 기기에서 나옵니다. 틀어 둔 음악부터 내가 보낸 키에 대한 응답으로 내는 알림음까지."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 播放的所有声音都从此设备发出，从你留着播放的音乐，到它为响应你发送的按键而发出的提示音。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что воспроизводит Mac, звучит на этом устройстве, от оставленной музыки до сигнала в ответ на отправленную клавишу."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che il Mac riproduce esce da questo dispositivo, dalla musica lasciata in esecuzione all'avviso che emette in risposta a un tasto che hai inviato."
          }
        }
      }
    },
    "The Mac's screen floats over your other apps, and iOS floats it by itself when you leave.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla del Mac flota sobre tus otras apps, y iOS la hace flotar sola cuando sales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran du Mac flotte au-dessus de vos autres apps, et iOS le fait flotter tout seul quand vous partez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm des Macs schwebt über deinen anderen Apps, und iOS lässt ihn selbst schweben, wenn du gehst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela do Mac flutua sobre seus outros apps, e o iOS a faz flutuar sozinho quando você sai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの画面が他のAppの上に浮かび、離れるとiOSが自動で浮かせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 화면이 다른 앱 위에 떠 있고, 앱을 떠나면 iOS가 알아서 띄웁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 的屏幕浮在你的其他 App 之上，当你离开时 iOS 会自动让它浮起来。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран Mac плавает поверх ваших других приложений, и iOS сама заставляет его плавать, когда вы уходите."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo del Mac fluttua sopra le tue altre app, e iOS lo fa fluttuare da solo quando esci."
          }
        }
      }
    },
    "The last twelve things that crossed between the two, still there when you think of them. Copying and pasting are on every plan.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las últimas doce cosas que pasaron entre ambos, aún ahí cuando te acuerdes. Copiar y pegar están en todos los planes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les douze dernières choses passées entre les deux, toujours là quand vous y pensez. Copier et coller sont sur toutes les formules."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten zwölf Dinge, die zwischen beiden gewandert sind, noch da, wenn du daran denkst. Kopieren und Einfügen gibt es in jedem Tarif."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As últimas doze coisas que passaram entre os dois, ainda lá quando você lembrar. Copiar e colar estão em todos os planos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2台の間でやり取りした直近12件が、思い出したときにそのまま残っています。コピーとペーストはどのプランでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 사이에서 오간 최근 열두 개가 생각날 때까지 그대로 있습니다. 복사와 붙여넣기는 모든 플랜에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这两者之间传输过的最近十二项内容，在你想起来时仍在那里。拷贝和粘贴在所有套餐中都有。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние двенадцать вещей, прошедших между ними, всё ещё там, когда о них вспомните. Копирование и вставка есть на каждом тарифе."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ultime dodici cose passate tra i due, ancora lì quando ci pensi. Copiare e incollare sono su ogni piano."
          }
        }
      }
    },
    "Pick several of the Mac's windows and see them together, arranged the way you want on this screen. Every tile is captured separately on the Mac, so the picture stays live rather than being a screenshot, and tapping one takes you into it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige varias ventanas del Mac y míralas juntas, dispuestas como quieras en esta pantalla. Cada mosaico se captura por separado en el Mac, así que la imagen sigue en vivo y no es una captura, y al tocar uno entras en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez plusieurs fenêtres du Mac et voyez-les ensemble, disposées comme vous voulez sur cet écran. Chaque vignette est capturée séparément sur le Mac, si bien que l'image reste en direct au lieu d'être une capture, et toucher l'une vous y emmène."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mehrere Fenster des Macs und sieh sie zusammen, angeordnet, wie du willst, auf diesem Bildschirm. Jede Kachel wird separat auf dem Mac aufgenommen, das Bild bleibt also live statt ein Screenshot zu sein, und das Antippen einer bringt dich hinein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha várias janelas do Mac e veja todas juntas, dispostas do jeito que quiser nesta tela. Cada bloco é capturado separadamente no Mac, então a imagem continua ao vivo e não é uma captura, e tocar em um leva você para dentro dele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのウインドウを複数選んで、この画面で好きなように並べて一緒に見られます。各タイルはMac上で個別に取り込まれるため、スクリーンショットではなく映像はライブのままで、タップするとそこに入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 윈도우를 여러 개 골라 이 화면에 원하는 대로 배열해 함께 보세요. 각 타일은 Mac에서 따로 캡처되므로 스크린샷이 아니라 실시간 화면이 유지되며, 하나를 탭하면 그 안으로 들어갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Mac 的多个窗口，按你想要的方式排列在这块屏幕上一起查看。每个磁贴都在 Mac 上单独捕捉，所以画面保持实时而不是截图，轻点其中一个就能进入它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите несколько окон Mac и смотрите их вместе, расположенные так, как вам нужно, на этом экране. Каждая плитка захватывается на Mac отдельно, так что картинка остаётся живой, а не снимком, и касание одной переносит вас в неё."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli più finestre del Mac e guardale insieme, disposte come vuoi su questo schermo. Ogni riquadro è catturato separatamente sul Mac, quindi l'immagine resta dal vivo e non è uno screenshot, e toccarne uno ti porta dentro."
          }
        }
      }
    },
    "A screen the Mac does not physically have, made from this phone and looked at from it: somewhere else for its windows to go, named and taken away from the same list.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pantalla que el Mac no tiene físicamente, hecha desde este teléfono y vista desde él: otro lugar para sus ventanas, con nombre y que se quita desde la misma lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écran que le Mac n'a pas physiquement, créé depuis ce téléphone et regardé depuis lui : un autre endroit où ranger ses fenêtres, nommé et retiré depuis la même liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bildschirm, den der Mac physisch nicht hat, von diesem Telefon erzeugt und von ihm aus angesehen: ein anderer Ort für seine Fenster, benannt und aus derselben Liste entfernt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tela que o Mac não tem fisicamente, criada a partir deste telefone e vista por ele: outro lugar para as janelas dele, com nome e removido da mesma lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが物理的に持っていない画面を、このiPhoneから作り、このiPhoneで見ます。ウインドウの行き先がもう一つ増え、名前を付けて、同じ一覧から取り除けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 물리적으로 없는 화면을 이 iPhone에서 만들어 이 iPhone으로 봅니다. 윈도우가 갈 또 다른 곳이며, 이름을 붙이고 같은 목록에서 제거할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一块 Mac 实际并不具备的屏幕，由这部手机创建，也从这部手机查看：为它的窗口多一个去处，可以命名并从同一份列表中移除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран, которого у Mac физически нет, созданный с этого телефона и просматриваемый с него: ещё одно место для его окон, с именем, удаляемое из того же списка."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno schermo che il Mac non ha fisicamente, creato da questo telefono e guardato da esso: un altro posto per le sue finestre, con nome e rimosso dalla stessa lista."
          }
        }
      }
    },
    "A banner when a shell on the Mac or on one of your servers stops and waits for you, on this device while it is open and through the Mac when it is not. The terminal and its own attention mark are on every plan.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso cuando un shell del Mac o de uno de tus servidores se detiene y te espera, en este dispositivo mientras está abierto y a través del Mac cuando no. El terminal y su propia marca de atención están en todos los planes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bannière quand un shell sur le Mac ou sur l'un de vos serveurs s'arrête et vous attend, sur cet appareil quand il est ouvert et via le Mac quand il ne l'est pas. Le terminal et sa propre marque d'attention sont sur toutes les formules."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Banner, wenn eine Shell auf dem Mac oder auf einem deiner Server anhält und auf dich wartet, auf diesem Gerät, solange es offen ist, und über den Mac, wenn nicht. Das Terminal und sein eigenes Aufmerksamkeitszeichen gibt es in jedem Tarif."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um banner quando um shell no Mac ou em um dos seus servidores para e espera por você, neste dispositivo enquanto está aberto e pelo Mac quando não está. O terminal e a própria marca de atenção estão em todos os planos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macまたはサーバのシェルがあなたを待って止まったとき、このデバイスが開いていればここに、そうでなければMac経由でバナーを表示します。ターミナルと専用の注意マークはどのプランでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이나 내 서버의 셸이 멈추어 나를 기다리면 배너를 표시합니다. 이 기기가 열려 있으면 여기에, 아니면 Mac을 통해서입니다. 터미널과 자체 주의 표시는 모든 플랜에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Mac 或你某台服务器上的 Shell 停下来等你时显示横幅：此设备打开时在此设备上，否则通过 Mac。终端及其自己的注意标记在所有套餐中都有。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баннер, когда shell на Mac или на одном из ваших серверов останавливается и ждёт вас, на этом устройстве, пока оно открыто, и через Mac, когда нет. Терминал и его собственная отметка внимания есть на каждом тарифе."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banner quando una shell sul Mac o su uno dei tuoi server si ferma e ti attende, su questo dispositivo mentre è aperto e tramite il Mac quando non lo è. Il terminale e il suo segno di attenzione sono su ogni piano."
          }
        }
      }
    },
    "Takes what you are looking at off a machine and hands it to Files or the share sheet, and puts a file from the phone into the folder you are looking at, up to 2 GB.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saca lo que estás viendo de una máquina y se lo pasa a Archivos o a la hoja de compartir, y coloca un archivo del teléfono en la carpeta que estás viendo, hasta 2 GB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort ce que vous regardez d'une machine et le confie à Fichiers ou à la feuille de partage, et place un fichier du téléphone dans le dossier que vous regardez, jusqu'à 2 Go."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holt das, was du ansiehst, von einer Maschine und übergibt es an Dateien oder das Teilen-Menü, und legt eine Datei vom Telefon in den Ordner, den du ansiehst, bis 2 GB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira o que você está vendo de uma máquina e entrega ao Arquivos ou à folha de compartilhamento, e coloca um arquivo do telefone na pasta que você está vendo, até 2 GB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見ているものをマシンから取り出して「ファイル」や共有シートに渡し、iPhoneのファイルを今見ているフォルダに入れます。最大2 GBです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고 있는 것을 머신에서 꺼내 파일 앱이나 공유 시트에 넘기고, iPhone의 파일을 보고 있는 폴더에 넣습니다. 최대 2 GB입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你正在看的内容从机器上取出并交给“文件”或共享表单，并把手机上的文件放进你正在看的文件夹，最大 2 GB。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забирает то, на что вы смотрите, с машины и передаёт в «Файлы» или меню «Поделиться», и кладёт файл с телефона в папку, на которую вы смотрите, до 2 ГБ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta fuori da una macchina ciò che stai guardando e lo passa a File o al foglio di condivisione, e mette un file dal telefono nella cartella che stai guardando, fino a 2 GB."
          }
        }
      }
    },
    "One shell at a time is free, on your Mac and on any server. This is naming tabs and keeping several open.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un shell a la vez es gratis, en tu Mac y en cualquier servidor. Esto es poner nombre a las pestañas y mantener varias abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un shell à la fois est gratuit, sur votre Mac et sur n'importe quel serveur. Ceci permet de nommer des onglets et d'en garder plusieurs ouverts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Shell zur Zeit ist kostenlos, auf deinem Mac und auf jedem Server. Das hier ist das Benennen von Tabs und das Offenhalten mehrerer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um shell por vez é grátis, no seu Mac e em qualquer servidor. Isto é dar nome às abas e manter várias abertas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に1つのシェルは、Macでもどのサーバでも無料です。これはタブに名前を付け、複数を開いたままにする機能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 셸 하나는 Mac에서도 어떤 서버에서도 무료입니다. 이것은 탭에 이름을 붙이고 여러 개를 열어 두는 것입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次一个 Shell 在 Mac 和任何服务器上都是免费的。这是给标签页命名并保持多个打开。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один shell за раз бесплатно, на вашем Mac и на любом сервере. Это именование вкладок и держание нескольких открытыми."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una shell alla volta è gratis, sul tuo Mac e su qualsiasi server. Questo è dare un nome alle schede e tenerne aperte diverse."
          }
        }
      }
    },
    "Save a sequence and fire it with a tap. The commands you type most wait as chips above the terminal keyboard, in every shell.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una secuencia y ejecútala con un toque. Los comandos que más escribes esperan como chips sobre el teclado del terminal, en cada shell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une séquence et lancez-la d'un toucher. Les commandes que vous tapez le plus attendent en pastilles au-dessus du clavier du terminal, dans chaque shell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eine Abfolge und löse sie mit einem Tippen aus. Die Befehle, die du am häufigsten tippst, warten als Chips über der Terminal-Tastatur, in jeder Shell."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve uma sequência e dispare com um toque. Os comandos que você mais digita esperam como chips acima do teclado do terminal, em todo shell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一連の操作を保存して、タップ一つで実行します。よく入力するコマンドは、すべてのシェルでターミナルキーボードの上にチップとして待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시퀀스를 저장해 탭 한 번으로 실행하세요. 가장 많이 입력하는 명령은 모든 셸에서 터미널 키보드 위의 칩으로 기다립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存一个序列并轻点一下执行。你最常输入的命令会作为标签等在终端键盘上方，在每个 Shell 中都有。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните последовательность и запускайте касанием. Команды, которые вы набираете чаще всего, ждут плашками над клавиатурой терминала в каждом shell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una sequenza e lanciala con un tocco. I comandi che scrivi di più aspettano come chip sopra la tastiera del terminale, in ogni shell."
          }
        }
      }
    },
    "A sharper picture when the session is relayed. On your own network it is already uncapped on every plan.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen más nítida cuando la sesión pasa por el relay. En tu propia red ya no tiene tope en todos los planes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image plus nette quand la session passe par le relais. Sur votre propre réseau, elle n'est déjà plus plafonnée sur toutes les formules."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schärferes Bild, wenn die Sitzung über das Relay läuft. In deinem eigenen Netzwerk ist es in jedem Tarif bereits unbegrenzt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem mais nítida quando a sessão passa pelo relay. Na sua própria rede ela já não tem limite em todos os planos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションがリレー経由のときに、より鮮明な映像になります。自分のネットワークでは、どのプランでもすでに上限がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 릴레이를 거칠 때 더 선명한 화면. 내 네트워크에서는 이미 모든 플랜에서 제한이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话经中继时画面更清晰。在你自己的网络上，所有套餐都已不设上限。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более чёткая картинка, когда сеанс идёт через релей. В вашей собственной сети она уже без ограничения на каждом тарифе."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'immagine più nitida quando la sessione passa dal relay. Sulla tua rete è già senza tetto su ogni piano."
          }
        }
      }
    },
