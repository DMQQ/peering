          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Mac sperren?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear este Mac?"
          }
        },
        "ja": {
          "stringUnit": {
