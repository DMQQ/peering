          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённый доступ отключён в Настройках. Включите его, чтобы подключаться к Mac из другой сети."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso remoto è disattivato in Impostazioni. Attivalo per raggiungere un Mac da un'altra rete."
          }
        }
      }
