          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versteckte Dateien ausblenden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar arquivos ocultos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隠しファイルを隠す"
          }
        },
