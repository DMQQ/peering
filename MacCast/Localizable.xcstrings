          }
        }
      }
    },
    "Pair once, with no account": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja una vez, sin cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez une fois, sans compte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal koppeln, ohne Konto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareie uma vez, sem conta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント不要で一度だけペアリング"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없이 한 번만 페어링"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户，只需配对一次"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свяжите один раз, без учётной записи"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associa una volta, senza account"
          }
        }
      }
    },
    "Two devices confirm a six-digit code and keep their own keys. Nothing is stored on a server.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos dispositivos confirman un código de seis dígitos y guardan sus propias claves. No se guarda nada en un servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux appareils confirment un code à six chiffres et gardent leurs propres clés. Rien n'est stocké sur un serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Geräte bestätigen einen sechsstelligen Code und behalten ihre eigenen Schlüssel. Nichts wird auf einem Server gespeichert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois dispositivos confirmam um código de seis dígitos e guardam suas próprias chaves. Nada é guardado em um servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのデバイスが6桁のコードを確認し、それぞれ自分のキーを保持します。サーバには何も保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 기기가 여섯 자리 코드를 확인하고 각자의 키를 보관합니다. 서버에는 아무것도 저장되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台设备确认一个六位数字代码，并各自保管自己的密钥。服务器上不存储任何内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два устройства подтверждают шестизначный код и хранят собственные ключи. Ничего не хранится на сервере."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due dispositivi confermano un codice a sei cifre e tengono le proprie chiavi. Nulla è memorizzato su un server."
          }
        }
      }
    },
    "Nearby, or by address": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca, o por dirección"
          }
        },
