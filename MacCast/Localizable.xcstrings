    "%@\n\nIt will run with your permissions on the machine this folder is on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nSe ejecutará con tus permisos en la máquina donde está esta carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nIl s'exécutera avec vos autorisations sur la machine où se trouve ce dossier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nSie wird mit deinen Berechtigungen auf dem Gerät ausgeführt, auf dem dieser Ordner liegt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nSerá executado com as suas permissões na máquina onde esta pasta está."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nこのフォルダがあるマシン上で、あなたの権限で実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n이 폴더가 있는 기기에서 내 권한으로 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n它将以你的权限在此文件夹所在的机器上运行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nОн запустится с вашими правами на машине, где находится эта папка."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nVerrà eseguito con i tuoi permessi sulla macchina in cui si trova questa cartella."
          }
        }
      }
    },
