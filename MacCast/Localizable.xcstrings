    "Backgrounding no longer burns relay time, and a warning appears when your connection is too poor to work over." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Hintergrund verbraucht die App keine Relay-Zeit mehr, und eine Warnung erscheint, wenn die Verbindung zu schlecht zum Arbeiten ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasar la app a segundo plano ya no gasta tiempo de relay, y aparece un aviso cuando la conexión es demasiado mala para trabajar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer l'app en arrière-plan ne consomme plus de temps de relais, et un avertissement s'affiche quand la connexion est trop mauvaise pour travailler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandare l'app in background non consuma più tempo di relay, e compare un avviso quando la connessione è troppo scarsa per lavorare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドに回してもリレー時間を消費しなくなり、接続が悪すぎて作業できないときは警告が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드로 보내도 더 이상 릴레이 시간이 소모되지 않으며, 연결이 너무 나빠 작업하기 어려울 때는 경고가 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixar o app em segundo plano não gasta mais tempo de relay, e um aviso aparece quando a conexão está ruim demais para trabalhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свёрнутое приложение больше не расходует время релея, а при слишком плохом соединении появляется предупреждение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用退到后台不再消耗中继时间，连接差到无法正常使用时还会显示警告。"
          }
        }
      }
    },
