    "Still trying. The Mac has not answered yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue intentándolo. El Mac aún no ha respondido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours en cours. Le Mac n'a pas encore répondu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche es weiter. Der Mac hat noch nicht geantwortet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda tentando. O Mac ainda não respondeu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ試行中です。Macがまだ応答していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 시도하는 중입니다. Mac이 아직 응답하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在尝试。Mac 尚未响应。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ещё пытаемся. Mac пока не ответил."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto ancora provando. Il Mac non ha ancora risposto."
          }
        }
      }
    },
    "Pairing, privacy, and what moves between your devices.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparejamiento, privacidad y lo que viaja entre tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Association, confidentialité, et ce qui circule entre vos appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplung, Datenschutz und was zwischen deinen Geräten wandert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareamento, privacidade e o que circula entre seus dispositivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング、プライバシー、デバイス間でやり取りされるもの。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링, 개인정보, 그리고 기기 간에 오가는 것들."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对、隐私，以及在你的设备之间传输的内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связывание, конфиденциальность и то, что передаётся между вашими устройствами."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associazione, privacy e ciò che si sposta tra i tuoi dispositivi."
          }
        }
      }
    },
