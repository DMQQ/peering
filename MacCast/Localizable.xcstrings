          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel file non ha potuto essere letto: %@"
          }
        }
      }
    },
    "Password saved": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña guardada"
          }
        },
        "fr": {
