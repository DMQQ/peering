    "End-to-end encrypted, with no account and nothing for the relay to read.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrado de extremo a extremo, sin cuenta y sin nada que el relay pueda leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré de bout en bout, sans compte et sans rien que le relais puisse lire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende-zu-Ende-verschlüsselt, ohne Konto und ohne etwas, das das Relay lesen könnte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografado de ponta a ponta, sem conta e sem nada que o relay possa ler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドツーエンドで暗号化。アカウントなし、リレーが読めるものもなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종단간 암호화, 계정 없음, 릴레이가 읽을 수 있는 것도 없음."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端到端加密，无需账户，也没有任何内容是中继能读取的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
