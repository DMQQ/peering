    "This server has no forwards. Add one under the server's own settings, and it opens with the next shell.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no tiene reenvíos. Añade uno en los ajustes del propio servidor y se abrirá con el siguiente shell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n'a aucune redirection. Ajoutez-en une dans les réglages du serveur, et elle s'ouvrira avec le prochain shell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server hat keine Weiterleitungen. Füge in den Einstellungen des Servers eine hinzu, dann wird sie mit der nächsten Shell geöffnet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não tem encaminhamentos. Adicione um nos ajustes do próprio servidor e ele abre com o próximo shell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバにはフォワードがありません。サーバ自体の設定で追加すると、次のシェルで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에는 포워드가 없습니다. 서버 자체 설정에서 추가하면 다음 셸과 함께 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器没有转发。在服务器自己的设置中添加一个，它会随下一个 Shell 一起打开。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого сервера нет перенаправлений. Добавьте одно в настройках самого сервера, и оно откроется со следующим shell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server non ha inoltri. Aggiungine uno nelle impostazioni del server e si aprirà con la prossima shell."
          }
        }
      }
    },
