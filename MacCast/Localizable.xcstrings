    "Drag to nudge the cursor, tap for left click, hold for right click, tap twice to change speed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para mover el cursor, toca para clic izquierdo, mantén para clic derecho, toca dos veces para cambiar la velocidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour déplacer le curseur, touchez pour un clic gauche, maintenez pour un clic droit, touchez deux fois pour changer la vitesse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen, um den Cursor zu bewegen, tippen für Linksklick, halten für Rechtsklick, zweimal tippen, um die Geschwindigkeit zu ändern"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para mover o cursor, toque para clique esquerdo, segure para clique direito, toque duas vezes para mudar a velocidade"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグでカーソルを動かし、タップで左クリック、長押しで右クリック、2回タップで速度を変更します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 커서 이동, 탭하여 왼쪽 클릭, 길게 눌러 오른쪽 클릭, 두 번 탭하여 속도 변경"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以移动光标，轻点为左键点按，按住为右键点按，轻点两下可更改速度"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы сдвинуть курсор, коснитесь для левого клика, удерживайте для правого, коснитесь дважды, чтобы сменить скорость"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per spostare il cursore, tocca per il clic sinistro, tieni premuto per il clic destro, tocca due volte per cambiare velocità"
          }
        }
      }
    },
