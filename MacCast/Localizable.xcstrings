          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernzugriff ist in den Einstellungen ausgeschaltet. Schalte ihn ein, um einen Mac aus einem anderen Netzwerk zu erreichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso remoto está desativado em Ajustes. Ative para alcançar um Mac de outra rede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートアクセスは設定でオフになっています。別のネットワークからMacに接続するにはオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 원격 접근이 꺼져 있습니다. 다른 네트워크의 Mac에 접속하려면 켜세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
