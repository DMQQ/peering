    "Ask for %@, or your device passcode, when Peering is opened again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ oder den Gerätecode verlangen, wenn Peering erneut geöffnet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedir %@, o el código de tu dispositivo, al volver a abrir Peering."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander %@, ou le code de votre appareil, à la réouverture de Peering."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiedi %@, o il codice del dispositivo, quando Peering viene riaperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peeringを再び開くときに、%@またはデバイスのパスコードを求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peering을 다시 열 때 %@ 또는 기기 암호를 요청합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedir %@, ou o código do dispositivo, quando o Peering for aberto de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрашивать %@ или код-пароль устройства при повторном открытии Peering."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次打开 Peering 时，要求%@或设备密码。"
          }
        }
      }
    },
    "Ask the agent to start the server, or check the port, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte den Agenten, den Server zu starten, oder prüfe den Port, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al agente que inicie el servidor, o comprueba el puerto, y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à l'agent de démarrer le serveur, ou vérifiez le port, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi all'agente di avviare il server, o controlla la porta, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントにサーバを起動してもらうか、ポートを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트에게 서버를 시작하도록 요청하거나 포트를 확인한 뒤 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao agente para iniciar o servidor, ou confira a porta, e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите агента запустить сервер или проверьте порт, затем повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请让代理启动服务器，或检查端口，然后重试。"
          }
        }
      }
    },
    "Ask to connect, or to end what is open, without opening the app." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte darum, dich zu verbinden oder zu beenden, was offen ist, ohne die App zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide conectar, o terminar lo que está abierto, sin abrir la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez de vous connecter, ou de terminer ce qui est ouvert, sans ouvrir l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi di connetterti, o di terminare ciò che è aperto, senza aprire l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appを開かずに、接続したり、開いているものを終了したりするよう頼めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 열지 않고 연결하거나 열려 있는 것을 종료해 달라고 요청하세요."
          }
