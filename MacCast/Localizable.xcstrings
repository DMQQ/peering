          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスにはパスコードも生体認証も設定されていないため、ロックを解除できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에는 암호나 생체 인식이 설정되어 있지 않아 잠금을 해제할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não tem código nem biometria configurados, então o bloqueio não pode ser respondido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве не настроены ни код-пароль, ни биометрия, поэтому блокировку снять нельзя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备未设置密码或生物识别，因此无法解锁。"
          }
        }
      }
    },
    "This device holds %lld Macs open at once. Close one to open another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hält %lld Macs gleichzeitig offen. Schließe einen, um einen anderen zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo mantiene %lld Mac abiertos a la vez. Cierra uno para abrir otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil garde %lld Mac ouverts à la fois. Fermez-en un pour en ouvrir un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo tiene %lld Mac aperti alla volta. Chiudine uno per aprirne un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは同時に%lld台のMacを開いたままにします。別のMacを開くには、1台閉じてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 Mac을 한 번에 %lld대까지 열어 둡니다. 다른 것을 열려면 하나를 닫으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo mantém %lld Macs abertos ao mesmo tempo. Feche um para abrir outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
