    "You did not accept this server's key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No aceptaste la clave de este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas accepté la clé de ce serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Schlüssel dieses Servers nicht akzeptiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não aceitou a chave deste servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバのキーを受け入れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버의 키를 수락하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有接受这台服务器的密钥。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не приняли ключ этого сервера."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai accettato la chiave di questo server."
          }
        }
      }
    },
    "The server's key has changed since you last connected. If this was not you, do not continue.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave del servidor ha cambiado desde la última vez que te conectaste. Si no fuiste tú, no continúes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé du serveur a changé depuis votre dernière connexion. Si ce n'était pas vous, ne continuez pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel des Servers hat sich seit deiner letzten Verbindung geändert. Warst du das nicht, fahre nicht fort."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave do servidor mudou desde a última vez que você se conectou. Se não foi você, não continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の接続以降、サーバのキーが変わりました。心当たりがない場合は、続行しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 연결한 이후 서버의 키가 바뀌었습니다. 본인이 한 일이 아니라면 계속하지 마세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自你上次连接以来，服务器的密钥已更改。如果这不是你所为，请不要继续。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ сервера изменился с момента вашего последнего подключения. Если это были не вы, не продолжайте."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave del server è cambiata dall'ultima volta che ti sei connesso. Se non sei stato tu, non proseguire."
          }
        }
      }
    },
    "The connection ended.": {
      "localizations": {
        "es": {
          "stringUnit": {
