          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa hai usato"
          }
        }
      }
    },
    "The Sessions tab counts relay time against the day's allowance, so the meter is visible before it runs out.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pestaña Sesiones cuenta el tiempo de relay contra el cupo del día, así el medidor se ve antes de agotarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'onglet Sessions compte le temps de relais par rapport au quota du jour, pour que le compteur soit visible avant d'être épuisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tab Sitzungen zählt Relay-Zeit gegen das Tageskontingent, sodass die Anzeige sichtbar ist, bevor sie aufgebraucht ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aba Sessões conta o tempo de relay contra a cota do dia, então o medidor fica visível antes de acabar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「セッション」タブがリレー時間を1日の枠に対して数えるので、なくなる前にメーターが見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 탭이 릴레이 시간을 하루 허용량에 대해 세므로, 다 되기 전에 미터가 보입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“会话”标签页把中继时间与当天额度相比计数，所以在用完之前就能看到计量表。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка «Сеансы» считает время релея против дневного лимита, так что счётчик виден до того, как закончится."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda Sessioni conta il tempo di relay rispetto alla quota del giorno, così il contatore è visibile prima che finisca."
          }
        }
      }
    },
