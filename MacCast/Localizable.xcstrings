    "The Mac is running an older version of Peering than this app. Update it there, then pair again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac ejecuta una versión de Peering más antigua que esta app. Actualízalo allí y vuelve a emparejar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac exécute une version de Peering plus ancienne que cette app. Mettez-le à jour là-bas, puis associez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Mac läuft eine ältere Version von Peering als diese App. Aktualisiere sie dort und koppele erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
