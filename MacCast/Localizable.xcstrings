    "%@ will ask for a password the next time you open a shell. Nothing on the server itself is touched, and any key already in `authorized_keys` stays there.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pedirá una contraseña la próxima vez que abras un shell. No se toca nada en el propio servidor, y cualquier clave que ya esté en `authorized_keys` se queda ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demandera un mot de passe à la prochaine ouverture d'un shell. Rien n'est modifié sur le serveur, et toute clé déjà présente dans `authorized_keys` y reste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fragt beim nächsten Öffnen einer Shell nach einem Passwort. Auf dem Server selbst wird nichts angetastet, und jeder Schlüssel, der schon in `authorized_keys` steht, bleibt dort."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pedirá uma senha na próxima vez que você abrir um shell. Nada no servidor é alterado, e qualquer chave que já esteja em `authorized_keys` continua lá."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にシェルを開くとき、%@はパスワードを求めます。サーバ自体には何も変更を加えず、すでに`authorized_keys`にあるキーもそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 셸을 열 때 %@이(가) 비밀번호를 요청합니다. 서버 자체는 건드리지 않으며, 이미 `authorized_keys`에 있는 키는 그대로 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开 Shell 时，%@会要求输入密码。服务器本身不会有任何改动，已在 `authorized_keys` 中的密钥也会保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запросит пароль при следующем открытии shell. На самом сервере ничего не меняется, а любой ключ, уже лежащий в `authorized_keys`, остаётся там."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chiederà una password la prossima volta che apri una shell. Sul server non viene toccato nulla, e qualsiasi chiave già in `authorized_keys` resta lì."
          }
        }
      }
    },
