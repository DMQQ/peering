    "No virtual displays. Add one to give your iPhone a screen of its own on the Mac, the shape of this phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay pantallas virtuales. Añade una para dar a tu iPhone una pantalla propia en el Mac, con la forma de este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun écran virtuel. Ajoutez-en un pour donner à votre iPhone son propre écran sur le Mac, à la forme de ce téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine virtuellen Displays. Füge eines hinzu, damit dein iPhone einen eigenen Bildschirm am Mac hat, in der Form dieses Telefons."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tela virtual. Adicione uma para dar ao iPhone uma tela própria no Mac, no formato deste telefone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想ディスプレイはありません。追加すると、このiPhoneの形をした専用の画面をMac上に作れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 디스플레이가 없습니다. 추가하면 이 휴대폰 모양의 전용 화면을 Mac에서 iPhone에 줄 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有虚拟显示器。添加一个，就能在 Mac 上为 iPhone 提供专属屏幕，形状与这部手机一致。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет виртуальных дисплеев. Добавьте один, чтобы у вашего iPhone был собственный экран на Mac формы этого телефона."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun display virtuale. Aggiungine uno per dare al tuo iPhone uno schermo tutto suo sul Mac, della forma di questo telefono."
          }
        }
      }
    },
