            "state": "translated",
            "value": "Sie lässt sich aus dem Papierkorb deines Macs zurücklegen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ser restaurado pela Lixeira do seu Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのゴミ箱から元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 휴지통에서 되돌릴 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以从你的 Mac 的废纸篓中放回。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
