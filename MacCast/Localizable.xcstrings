    "Renews automatically. Cancel any time in your App Store settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente. Cancela cuando quieras en los ajustes de la App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle automatiquement. Résiliez à tout moment dans les réglages de l'App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch. Jederzeit in den App-Store-Einstellungen kündbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova automaticamente. Cancele quando quiser nos ajustes da App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動的に更新されます。App Storeの設定からいつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 갱신됩니다. App Store 설정에서 언제든 취소할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动续订。可随时在 App Store 设置中取消。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевается автоматически. Отменить можно в любой момент в настройках App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova automaticamente. Disdici quando vuoi dalle impostazioni dell'App Store."
          }
        }
      }
    },
    "Questions or suggestions? [support@getpeering.app](mailto:support@getpeering.app)": {
      "localizations": {
