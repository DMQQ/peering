          "stringUnit": {
            "state": "translated",
            "value": "HEVC非対応"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC 미지원"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持 HEVC"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC не поддерживается"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC non supportato"
          }
        }
      }
    },
    "This device can decode H.265. Enable HEVC on the Mac for better quality at lower bandwidth.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo puede decodificar H.265. Activa HEVC en el Mac para mejor calidad con menos ancho de banda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil peut décoder le H.265. Activez HEVC sur le Mac pour une meilleure qualité avec moins de bande passante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann H.265 dekodieren. Aktiviere HEVC am Mac für bessere Qualität bei geringerer Bandbreite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo decodifica H.265. Ative o HEVC no Mac para melhor qualidade com menos banda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはH.265をデコードできます。MacでHEVCを有効にすると、少ない帯域でより高品質になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 H.265를 디코딩할 수 있습니다. Mac에서 HEVC를 켜면 더 낮은 대역폭으로 더 나은 품질을 얻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备可以解码 H.265。在 Mac 上启用 HEVC，可在更低带宽下获得更好的画质。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство может декодировать H.265. Включите HEVC на Mac для лучшего качества при меньшей пропускной способности."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo può decodificare H.265. Abilita HEVC sul Mac per una qualità migliore con meno banda."
          }
        }
      }
    },
    "This device cannot hardware-decode H.265. Use H.264 on the Mac for best performance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede decodificar H.265 por hardware. Usa H.264 en el Mac para el mejor rendimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas décoder le H.265 en matériel. Utilisez le H.264 sur le Mac pour de meilleures performances."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann H.265 nicht per Hardware dekodieren. Nutze H.264 am Mac für die beste Leistung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não decodifica H.265 por hardware. Use H.264 no Mac para o melhor desempenho."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはH.265をハードウェアでデコードできません。最高のパフォーマンスのため、MacではH.264を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 H.265를 하드웨어로 디코딩할 수 없습니다. 최상의 성능을 위해 Mac에서 H.264를 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法硬件解码 H.265。请在 Mac 上使用 H.264 以获得最佳性能。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не может аппаратно декодировать H.265. Используйте H.264 на Mac для лучшей производительности."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non può decodificare H.265 in hardware. Usa H.264 sul Mac per le migliori prestazioni."
          }
        }
      }
    },
