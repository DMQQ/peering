    "Peering can keep a live view of your Mac floating over other apps.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering puede mantener una vista en vivo de tu Mac flotando sobre otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering peut garder une vue en direct de votre Mac flottant au-dessus des autres apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering kann eine Live-Ansicht deines Macs über anderen Apps schweben lassen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering pode manter uma visualização ao vivo do seu Mac flutuando sobre outros apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peeringは、Macのライブ映像を他のAppの上に浮かせたままにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering은 Mac의 실시간 화면을 다른 앱 위에 띄워 둘 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering 可以让 Mac 的实时画面浮在其他 App 之上。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering может держать живой вид вашего Mac плавающим поверх других приложений."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering può tenere una vista dal vivo del tuo Mac che fluttua sopra le altre app."
          }
        }
      }
    },
    "It is part of %@, with sound from the Mac and files that move both ways.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma parte de %@, junto con el sonido del Mac y los archivos que van en ambos sentidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait partie de %@, avec le son du Mac et les fichiers qui circulent dans les deux sens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gehört zu %@, zusammen mit Ton vom Mac und Dateien, die in beide Richtungen wandern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz parte do %@, junto com o som do Mac e arquivos que vão e voltam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは%@の一部で、Macの音声や双方向のファイル転送も含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 %@의 일부이며, Mac의 소리와 양방향으로 오가는 파일도 포함됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它是%@的一部分，同时包括来自 Mac 的声音和双向传输的文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это часть %@ наряду со звуком с Mac и файлами, которые идут в обе стороны."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa parte di %@, insieme al suono dal Mac e ai file che viaggiano in entrambe le direzioni."
          }
        }
      }
    },
