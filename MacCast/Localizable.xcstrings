    "Shows session status and duration on the Lock Screen and in Dynamic Island.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el estado y la duración de la sesión en la pantalla de bloqueo y en la Dynamic Island."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l'état et la durée de la session sur l'écran verrouillé et dans la Dynamic Island."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Sitzungsstatus und Dauer auf dem Sperrbildschirm und in der Dynamic Island."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o estado e a duração da sessão na Tela Bloqueada e na Dynamic Island."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面とDynamic Islandにセッションの状態と時間を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면과 Dynamic Island에 세션 상태와 지속 시간을 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定屏幕和灵动岛上显示会话状态和时长。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает состояние и длительность сеанса на экране блокировки и в Dynamic Island."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra stato e durata della sessione nella schermata di blocco e nella Dynamic Island."
          }
        }
      }
    },
