        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) Mac에 유지되는 동안 연결이 끝났습니다. 아직 그곳에 유지되고 있을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
