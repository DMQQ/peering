            "value": "Esse arquivo não pôde ser lido: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのファイルを読み込めませんでした: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
