    "Leave empty to keep the saved one" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, um das gespeicherte zu behalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo vacío para conservar la guardada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisser vide pour conserver celui enregistré"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto per mantenere quella salvata"
          }
        },
        "ja" : {
          "stringUnit" : {
