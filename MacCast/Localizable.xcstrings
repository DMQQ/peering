          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он появляется среди подсказок в каждом новом чате."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
