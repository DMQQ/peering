    "No picture yet. PiP mirrors the video layer, so a session has to be running.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay imagen. PiP refleja la capa de vídeo, así que tiene que haber una sesión en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'image. PiP reflète la couche vidéo, il faut donc qu'une session soit en cours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Bild. PiP spiegelt die Videoebene, also muss eine Sitzung laufen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem imagem. O PiP espelha a camada de vídeo, então uma sessão precisa estar em execução."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像がまだありません。PiPは映像レイヤーをミラーするので、セッションが動いている必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 화면이 없습니다. PiP는 비디오 레이어를 미러링하므로 세션이 실행 중이어야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有画面。PiP 镜像的是视频图层，所以必须有会话在运行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет картинки. PiP зеркалирует слой видео, поэтому должен идти сеанс."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna immagine. PiP rispecchia il livello video, quindi deve esserci una sessione in esecuzione."
          }
        }
      }
    },
