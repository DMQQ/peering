        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 두 번 탭하세요. 팁 %lld/%lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两下以继续。提示 %lld/%lld。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь дважды, чтобы продолжить. Совет %lld из %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per continuare. Suggerimento %lld di %lld."
          }
        }
