    "The last commands sent to a shell, one tap from the input field. A command the shell did not recognise is dropped from the list.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los últimos comandos enviados a un shell, a un toque del campo de entrada. Un comando que el shell no reconoció se quita de la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dernières commandes envoyées à un shell, à un toucher du champ de saisie. Une commande que le shell n'a pas reconnue est retirée de la liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zuletzt an eine Shell gesendeten Befehle, einen Tipp vom Eingabefeld entfernt. Ein Befehl, den die Shell nicht erkannt hat, wird aus der Liste entfernt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os últimos comandos enviados a um shell, a um toque do campo de entrada. Um comando que o shell não reconheceu é removido da lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェルに最近送ったコマンドが、入力欄からワンタップで呼び出せます。シェルが認識しなかったコマンドは一覧から外れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셸에 마지막으로 보낸 명령이 입력란에서 탭 한 번 거리에 있습니다. 셸이 인식하지 못한 명령은 목록에서 빠집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近发送到 Shell 的命令，离输入框只有一次轻点。Shell 不认识的命令会从列表中移除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние команды, отправленные в shell, на расстоянии касания от поля ввода. Команда, которую shell не распознал, убирается из списка."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ultimi comandi inviati a una shell, a un tocco dal campo di input. Un comando che la shell non ha riconosciuto viene tolto dalla lista."
          }
        }
      }
    },
