          }
        }
      }
    },
    "Dim the Mac's own displays while you work, so nobody standing there watches along.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenúa las pantallas del propio Mac mientras trabajas, para que nadie que esté allí mire contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atténuez les écrans du Mac pendant que vous travaillez, pour que personne sur place ne regarde avec vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkle die eigenen Displays des Macs ab, während du arbeitest, damit niemand dort mitsieht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escureça as próprias telas do Mac enquanto você trabalha, para que ninguém ali assista junto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中にMac自身のディスプレイを暗くして、その場にいる誰にも一緒に見られないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업하는 동안 Mac 자체 디스플레이를 어둡게 해서, 그 자리에 선 누구도 함께 보지 못하게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你工作时调暗 Mac 自己的显示器，这样站在那里的人就不会跟着看。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняйте собственные дисплеи Mac, пока работаете, чтобы никто рядом не смотрел вместе с вами."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscura i display del Mac mentre lavori, così nessuno lì accanto guarda con te."
          }
        }
      }
    },
    "Screenshots": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturas de pantalla"
          }
        },
        "fr": {
