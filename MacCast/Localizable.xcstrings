    "Peering is not allowed to use the camera.\nAllow Camera in Settings, or enter the six-digit code instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering no tiene permiso para usar la cámara.\nPermite la cámara en Ajustes, o introduce el código de seis dígitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering n'est pas autorisé à utiliser l'appareil photo.\nAutorisez l'appareil photo dans Réglages, ou saisissez le code à six chiffres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering darf die Kamera nicht verwenden.\nErlaube die Kamera in den Einstellungen oder gib stattdessen den sechsstelligen Code ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering não tem permissão para usar a câmera.\nPermita a Câmera em Ajustes, ou digite o código de seis dígitos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peeringはカメラの使用を許可されていません。\n設定でカメラを許可するか、6桁のコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering이 카메라를 사용할 수 없습니다.\n설정에서 카메라를 허용하거나 여섯 자리 코드를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering 不被允许使用相机。\n请在“设置”中允许相机，或改为输入六位数字代码。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering не разрешено использовать камеру.\nРазрешите камеру в Настройках или введите шестизначный код."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering non è autorizzato a usare la fotocamera.\nConsenti la Fotocamera in Impostazioni, oppure inserisci il codice a sei cifre."
          }
        }
      }
    },
    "Camera unavailable\nEnter the six-digit code instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara no disponible\nIntroduce el código de seis dígitos."
