{
  "sourceLanguage": "en",
  "strings": {
    "Peering is locked": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering está bloqueado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering est verrouillé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering ist gesperrt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering está bloqueado"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peeringはロックされています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering이 잠겨 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering 已锁定"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering заблокирован"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering è bloccato"
          }
        }
      }
    },
    "Your device passcode is accepted too.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se acepta el código de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code de votre appareil est aussi accepté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code deines Geräts wird ebenfalls akzeptiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código do seu dispositivo também é aceito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのパスコードも使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 암호도 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以使用设备的密码。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код-пароль устройства тоже подходит."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene accettato anche il codice del dispositivo."
          }
        }
      }
    },
    "This device has no passcode or biometrics set up, so the lock cannot be answered.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene código ni biometría configurados, así que no se puede responder al bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n'a ni code ni biométrie configurés, le verrouillage ne peut donc pas être levé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät sind weder Code noch Biometrie eingerichtet, die Sperre kann also nicht beantwortet werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem código nem biometria configurados, então o bloqueio não pode ser respondido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはパスコードも生体認証も設定されていないため、ロックを解除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에는 암호나 생체 인식이 설정되어 있지 않아 잠금을 해제할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备未设置密码或生物识别，因此无法解锁。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве не настроены ни код-пароль, ни биометрия, поэтому блокировку снять нельзя."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha codice né biometria configurati, quindi il blocco non può essere sbloccato."
          }
        }
      }
    },
    "Unlock with %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquear con %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouiller avec %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %@ entsperren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquear com %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で解除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 잠금 해제"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用%@解锁"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировать с помощью %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca con %@"
          }
        }
      }
    },
    "Turn the lock off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar el bloqueo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver le verrouillage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperre ausschalten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar o bloqueio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックをオフにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 끄기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭锁定"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить блокировку"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva il blocco"
          }
        }
      }
    },
    "Clear the clipboard history?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar el historial del portapapeles?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer l'historique du presse-papiers ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf der Zwischenablage löschen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar o histórico da área de transferência?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードの履歴を消去しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록을 지울까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除剪贴板历史记录？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить историю буфера обмена?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellare la cronologia degli appunti?"
          }
        }
      }
    },
    "Text copied from the Mac lands here, so the next copy does not lose it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto copiado desde el Mac llega aquí, para que la siguiente copia no lo pierda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte copié depuis le Mac arrive ici, pour que la copie suivante ne le perde pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Mac kopierter Text landet hier, damit er beim nächsten Kopieren nicht verloren geht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto copiado do Mac chega aqui, para que a próxima cópia não o perca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでコピーしたテキストはここに届くので、次のコピーで失われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 복사한 텍스트가 여기에 저장되어, 다음 복사에도 사라지지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Mac 复制的文本会保存在这里，下次复制时不会丢失。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст, скопированный на Mac, попадает сюда, чтобы следующее копирование его не потеряло."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo copiato dal Mac arriva qui, così la copia successiva non lo perde."
          }
        }
      }
    },
