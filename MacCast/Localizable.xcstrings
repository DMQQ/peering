          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering의 모든 기능 보기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解 Peering 的全部功能"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что умеет Peering"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri tutto ciò che fa Peering"
          }
        }
      }
    },
    "%@ until cancelled, whichever plan you choose. You can cancel any time in your App Store settings. Payment is taken from your Apple Account when you confirm.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasta que canceles, elijas el plan que elijas. Puedes cancelar en cualquier momento en los ajustes de la App Store. El pago se carga a tu cuenta de Apple al confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jusqu'à résiliation, quelle que soit la formule. Vous pouvez résilier à tout moment dans les réglages de l'App Store. Le paiement est prélevé sur votre compte Apple à la confirmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bis zur Kündigung, egal welchen Tarif du wählst. Du kannst jederzeit in den App-Store-Einstellungen kündigen. Die Zahlung wird bei Bestätigung deinem Apple-Account belastet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ até o cancelamento, qualquer que seja o plano. Você pode cancelar a qualquer momento nos ajustes da App Store. O pagamento é cobrado da sua conta Apple na confirmação."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのプランを選んでも、解約するまで%@。App Storeの設定からいつでも解約できます。お支払いは、確定時にAppleアカウントに請求されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 플랜을 선택하든 취소할 때까지 %@. App Store 설정에서 언제든 취소할 수 있습니다. 결제는 확인 시 Apple 계정으로 청구됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论选择哪种套餐，%@，直到取消为止。你可以随时在 App Store 设置中取消。确认时将从你的 Apple 账户扣款。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ до отмены, какой бы тариф вы ни выбрали. Отменить можно в любой момент в настройках App Store. Оплата списывается с вашей учётной записи Apple при подтверждении."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fino alla disdetta, qualunque piano tu scelga. Puoi disdire in qualsiasi momento dalle impostazioni dell'App Store. Il pagamento viene addebitato sul tuo ID Apple alla conferma."
          }
        }
      }
    },
