    "Type a port, or pick one that is answering now. Only localhost and 127.0.0.1 on the Mac can be opened." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen Port ein oder wähle einen, der gerade antwortet. Es lassen sich nur localhost und 127.0.0.1 auf dem Mac öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un puerto o elige uno que esté respondiendo ahora. Solo se pueden abrir localhost y 127.0.0.1 del Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un port ou choisissez-en un qui répond en ce moment. Seuls localhost et 127.0.0.1 sur le Mac peuvent être ouverts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita una porta o scegline una che sta rispondendo ora. Si possono aprire solo localhost e 127.0.0.1 sul Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポート番号を入力するか、現在応答しているポートを選んでください。開けるのはMac上のlocalhostと127.0.0.1のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포트를 입력하거나 지금 응답 중인 포트를 선택하세요. Mac의 localhost와 127.0.0.1만 열 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite uma porta ou escolha uma que esteja respondendo agora. Só é possível abrir localhost e 127.0.0.1 do Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите порт или выберите тот, который сейчас отвечает. Открыть можно только localhost и 127.0.0.1 на Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
