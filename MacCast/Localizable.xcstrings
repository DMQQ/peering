          }
        }
      }
    },
    "The name Macs see for this device. iOS 16+ restricts apps from reading your custom device name without a special entitlement, so setting it here ensures Macs show the right name.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre que ven los Mac para este dispositivo. iOS 16+ impide que las apps lean el nombre personalizado del dispositivo sin un permiso especial, así que definirlo aquí garantiza que los Mac muestren el nombre correcto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom que les Mac voient pour cet appareil. iOS 16+ interdit aux apps de lire le nom personnalisé de l'appareil sans autorisation spéciale ; le définir ici garantit que les Mac affichent le bon nom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name, den Macs für dieses Gerät sehen. iOS 16+ verbietet Apps ohne besondere Berechtigung, den eigenen Gerätenamen zu lesen; ihn hier zu setzen sorgt dafür, dass Macs den richtigen Namen zeigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome que os Macs veem para este dispositivo. O iOS 16+ impede que apps leiam o nome personalizado do dispositivo sem uma permissão especial, então defini-lo aqui garante que os Macs mostrem o nome certo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがこのデバイスに対して表示する名前。iOS 16以降では、特別な権限なしにアプリがデバイスのカスタム名を読み取れないため、ここで設定するとMacに正しい名前が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 이 기기에 대해 표시되는 이름입니다. iOS 16 이상에서는 특별한 권한 없이는 앱이 사용자 지정 기기 이름을 읽을 수 없으므로, 여기에 설정하면 Mac에 올바른 이름이 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 看到的此设备名称。iOS 16 及更高版本限制 App 在没有特殊权限时读取自定设备名称，因此在这里设置可确保 Mac 显示正确的名称。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя, которое Mac видят для этого устройства. iOS 16+ запрещает приложениям читать пользовательское имя устройства без специального разрешения, поэтому задание его здесь гарантирует, что Mac покажут правильное имя."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome che i Mac vedono per questo dispositivo. iOS 16+ impedisce alle app di leggere il nome personalizzato del dispositivo senza un'autorizzazione speciale, quindi impostarlo qui garantisce che i Mac mostrino il nome giusto."
          }
        }
      }
    },
    "Device name": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre del dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom de l'appareil"
          }
        },
        "de": {
