    "This Mac will be removed from Trusted Macs. You can re-pair it at any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac se quitará de Mac de confianza. Puedes volver a emparejarlo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac sera retiré des Mac de confiance. Vous pourrez l'associer à nouveau à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac wird aus den vertrauenswürdigen Macs entfernt. Du kannst ihn jederzeit erneut koppeln."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac será removido dos Macs confiáveis. Você pode pareá-lo de novo quando quiser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacは信頼済みのMacから削除されます。いつでも再度ペアリングできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 신뢰하는 Mac에서 제거됩니다. 언제든 다시 페어링할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 将从受信任的 Mac 中移除。你可以随时重新配对。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac будет удалён из доверенных. Вы можете связать его снова в любой момент."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac verrà rimosso dai Mac attendibili. Puoi associarlo di nuovo in qualsiasi momento."
          }
        }
      }
    },
    "The new name is only used on this device. The Mac keeps its own name.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo nombre solo se usa en este dispositivo. El Mac conserva su propio nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau nom n'est utilisé que sur cet appareil. Le Mac garde son propre nom."
