    },
    "The port another app on this phone will connect to. `localhost:%@` is what you point it at." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Port, mit dem sich eine andere App auf diesem Telefon verbindet. `localhost:%@` ist das, worauf du sie richtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puerto al que se conectará otra app de este teléfono. `localhost:%@` es a lo que la apuntas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le port auquel une autre app de ce téléphone se connectera. `localhost:%@` est ce vers quoi vous la pointez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La porta a cui si connetterà un'altra app di questo telefono. `localhost:%@` è ciò a cui la punti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhone上の別のAppが接続するポートです。`localhost:%@`がそのAppに指定する接続先です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone의 다른 앱이 연결할 포트입니다. `localhost:%@`이(가) 그 앱이 가리키는 곳입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A porta à qual outro app deste telefone vai se conectar. `localhost:%@` é para onde você o aponta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порт, к которому будет подключаться другое приложение на этом телефоне. `localhost:%@` это то, на что вы его направляете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这部手机上的另一个 App 将连接的端口。`localhost:%@` 就是你让它指向的地方。"
          }
        }
      }
    },
    "The preview can only open plain pages on localhost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorschau kann nur einfache Seiten auf localhost öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vista previa solo puede abrir páginas simples en localhost."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aperçu ne peut ouvrir que des pages simples sur localhost."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'anteprima può aprire solo pagine semplici su localhost."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューで開けるのは、localhost上の通常のページだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기에서는 localhost의 일반 페이지만 열 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pré-visualização só consegue abrir páginas simples no localhost."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпросмотр открывает только обычные страницы на localhost."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预览只能打开 localhost 上的普通页面。"
          }
        }
      }
    },
    "The private half, not the public one. If what you have starts with `ssh-ed25519`, that is the half the server wants." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die private Hälfte, nicht die öffentliche. Beginnt das, was du hast, mit `ssh-ed25519`, ist das die Hälfte, die der Server will."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mitad privada, no la pública. Si lo que tienes empieza por `ssh-ed25519`, esa es la mitad que quiere el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La moitié privée, pas la publique. Si ce que vous avez commence par `ssh-ed25519`, c'est la moitié que veut le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La metà privata, non quella pubblica. Se ciò che hai inizia con `ssh-ed25519`, quella è la metà che vuole il server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開鍵ではなく、秘密鍵の半分です。お持ちのものが`ssh-ed25519`で始まっているなら、それはサーバが求める半分です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공개 키가 아니라 개인 키 절반입니다. 가진 것이 `ssh-ed25519`로 시작한다면, 그것이 서버가 원하는 절반입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A metade privada, não a pública. Se o que você tem começa com `ssh-ed25519`, essa é a metade que o servidor quer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрытая половина, а не открытая. Если то, что у вас есть, начинается с `ssh-ed25519`, это половина, которая нужна серверу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是私钥那一半，而不是公钥。如果你手上的内容以 `ssh-ed25519` 开头，那就是服务器需要的那一半。"
          }
        }
      }
    },
    "The push did not happen" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Push hat nicht stattgefunden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El push no se realizó"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le push n'a pas eu lieu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il push non è avvenuto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プッシュは行われませんでした"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "푸시가 실행되지 않았습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O push não aconteceu"
          }
        },
        "ru" : {
          "stringUnit" : {
