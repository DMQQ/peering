          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può essere rimessa a posto dal Cestino del tuo Mac."
          }
        }
      }
    },
    "The shell running in it stops. Your Mac and the rest of the terminals are left alone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El shell que se ejecuta en él se detiene. Tu Mac y el resto de los terminales no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le shell qui y tourne s'arrête. Votre Mac et les autres terminaux ne sont pas touchés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die darin laufende Shell wird beendet. Dein Mac und die übrigen Terminals bleiben unberührt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O shell que roda nele para. Seu Mac e os demais terminais não são tocados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その中で動いているシェルは停止します。Macと他のターミナルには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 안에서 실행 중인 셸이 중지됩니다. Mac과 나머지 터미널은 건드리지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中运行的 Shell 会停止。你的 Mac 和其余终端不受影响。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работающий в нём shell останавливается. Ваш Mac и остальные терминалы не затрагиваются."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La shell che vi gira si ferma. Il tuo Mac e gli altri terminali non vengono toccati."
          }
        }
      }
