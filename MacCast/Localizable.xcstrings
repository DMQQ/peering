    },
    "Your free relay time is used up": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó tu tiempo de relay gratuito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre temps de relais gratuit est épuisé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine kostenlose Relay-Zeit ist aufgebraucht"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu tempo de relay grátis acabou"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のリレー時間を使い切りました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 릴레이 시간을 모두 사용했습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的免费中继时间已用完"
          }
        },
        "ru": {
