    "Drag anywhere in the circle to move the Mac's pointer. The keys beside it send Return and Back." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe irgendwo im Kreis, um den Zeiger des Macs zu bewegen. Die Tasten daneben senden Return und Back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra en cualquier parte del círculo para mover el puntero del Mac. Las teclas de al lado envían Return y Back."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser n'importe où dans le cercle pour déplacer le pointeur du Mac. Les touches à côté envoient Return et Back."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina ovunque nel cerchio per muovere il puntatore del Mac. I tasti accanto inviano Return e Back."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "円の中をドラッグするとMacのポインタが動きます。隣のキーはReturnとBackを送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원 안 아무 곳이나 드래그하여 Mac 포인터를 움직입니다. 옆의 키는 Return과 Back을 보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste em qualquer ponto do círculo para mover o ponteiro do Mac. As teclas ao lado enviam Return e Back."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведите в любом месте круга, чтобы двигать указатель Mac. Клавиши рядом отправляют Return и Back."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在圆内任意位置拖动即可移动 Mac 指针。旁边的按键发送 Return 和 Back。"
          }
        }
      }
    },
    "Drag to nudge the cursor, tap for left click, hold for right click, tap twice to change speed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, um den Cursor zu bewegen, tippen für Linksklick, halten für Rechtsklick, zweimal tippen, um die Geschwindigkeit zu ändern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para mover el cursor, toca para clic izquierdo, mantén para clic derecho, toca dos veces para cambiar la velocidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour déplacer le curseur, touchez pour un clic gauche, maintenez pour un clic droit, touchez deux fois pour changer la vitesse"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per spostare il cursore, tocca per il clic sinistro, tieni premuto per il clic destro, tocca due volte per cambiare velocità"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグでカーソルを動かし、タップで左クリック、長押しで右クリック、2回タップで速度を変更します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 커서 이동, 탭하여 왼쪽 클릭, 길게 눌러 오른쪽 클릭, 두 번 탭하여 속도 변경"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para mover o cursor, toque para clique esquerdo, segure para clique direito, toque duas vezes para mudar a velocidade"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите, чтобы сдвинуть курсор, коснитесь для левого клика, удерживайте для правого, коснитесь дважды, чтобы сменить скорость"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以移动光标，轻点为左键点按，按住为右键点按，轻点两下可更改速度"
          }
        }
      }
    },
