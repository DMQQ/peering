            "state": "translated",
            "value": "A imagem"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면"
          }
        },
        "zh-Hans": {
