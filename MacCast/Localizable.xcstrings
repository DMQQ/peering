    "Relay connects across networks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay verbindet über Netzwerke hinweg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El relay conecta entre redes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le relais connecte entre réseaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il relay connette tra reti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リレーはネットワークをまたいで接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "릴레이는 네트워크를 넘어 연결합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relay conecta entre redes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Релей соединяет между сетями."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中继可跨网络连接。"
          }
        }
      }
    },
    "Relay connects across networks. Privacy mode dims the Mac's displays without stopping the stream." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay verbindet über Netzwerke hinweg. Der Privatmodus dunkelt die Displays des Macs ab, ohne den Stream zu stoppen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El relay conecta entre redes. El modo privado atenúa las pantallas del Mac sin detener la transmisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le relais connecte entre réseaux. Le mode confidentiel atténue les écrans du Mac sans arrêter le flux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il relay connette tra reti. La modalità privacy attenua i display del Mac senza interrompere lo streaming."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リレーはネットワークをまたいで接続します。プライバシーモードは、ストリームを止めずにMacのディスプレイを暗くします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "릴레이는 네트워크를 넘어 연결합니다. 개인정보 보호 모드는 스트림을 멈추지 않고 Mac의 디스플레이를 어둡게 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relay conecta entre redes. O Modo Privacidade escurece as telas do Mac sem interromper a transmissão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Релей соединяет между сетями. Режим конфиденциальности затемняет дисплеи Mac, не останавливая поток."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中继可跨网络连接。隐私模式会在不中断串流的情况下调暗 Mac 的显示器。"
          }
        }
      }
    },
    "Relay quota reached. Your subscription is active; please try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relay-Kontingent erreicht. Dein Abo ist aktiv; versuche es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cupo de relay alcanzado. Tu suscripción está activa; inténtalo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quota du relais atteint. Votre abonnement est actif ; réessayez plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quota del relay raggiunta. Il tuo abbonamento è attivo; riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リレーの利用枠に達しました。購読は有効です。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "릴레이 허용량에 도달했습니다. 구독은 활성 상태이니 나중에 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cota do relay atingida. Sua assinatura está ativa; tente novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лимит релея достигнут. Ваша подписка активна; повторите попытку позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已达到中继额度。你的订阅有效；请稍后再试。"
          }
        }
      }
    },
