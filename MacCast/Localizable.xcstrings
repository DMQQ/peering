          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App auf diesem Gerät aktualisieren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o app deste dispositivo"
          }
        },
