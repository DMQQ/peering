    "Double tap to continue. Tip %lld of %lld.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para continuar. Consejo %lld de %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour continuer. Astuce %lld sur %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Fortfahren doppeltippen. Tipp %lld von %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para continuar. Dica %lld de %lld."
          }
        },
        "ja": {
