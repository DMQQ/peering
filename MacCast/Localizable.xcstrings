    "Open any display, app, window, or Space and switch between them without reconnecting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre cualquier pantalla, app, ventana o Space y cambia entre ellos sin reconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez n'importe quel écran, app, fenêtre ou Space et passez de l'un à l'autre sans reconnexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne jedes Display, jede App, jedes Fenster oder jeden Space und wechsle zwischen ihnen, ohne dich neu zu verbinden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra qualquer tela, app, janela ou Space e alterne entre eles sem reconectar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あらゆるディスプレイ、App、ウインドウ、Spaceを開き、再接続せずに切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 디스플레이, 앱, 윈도우, Space든 열고 재연결 없이 전환하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开任何显示器、App、窗口或 Space，无需重新连接即可在它们之间切换。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте любой дисплей, приложение, окно или Space и переключайтесь между ними без переподключения."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri qualsiasi display, app, finestra o Space e passa dall'uno all'altro senza riconnetterti."
          }
        }
      }
    },
