    "Remote access is turned off in Settings. Turn it on to reach a Mac from another network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso remoto está desactivado en Ajustes. Actívalo para llegar a un Mac desde otra red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
