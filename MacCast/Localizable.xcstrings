            "state": "translated",
            "value": "Conexão"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        },
        "ru": {
          "stringUnit": {
