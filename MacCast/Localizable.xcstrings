    "The Mac is running a newer version of Peering than this app. Update Peering from the App Store, then connect again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac ejecuta una versión de Peering más reciente que esta app. Actualiza Peering desde la App Store y vuelve a conectarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac exécute une version de Peering plus récente que cette app. Mettez à jour Peering depuis l'App Store, puis reconnectez-vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Mac läuft eine neuere Version von Peering als diese App. Aktualisiere Peering über den App Store und verbinde dich erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac executa uma versão do Peering mais nova que este app. Atualize o Peering pela App Store e conecte de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacではこのAppより新しいバージョンのPeeringが動いています。App StoreでPeeringを更新してから、もう一度接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 이 앱보다 최신 버전의 Peering을 실행 중입니다. App Store에서 Peering을 업데이트한 다음 다시 연결하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 运行的 Peering 版本比此 App 更新。请从 App Store 更新 Peering，然后重新连接。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Mac запущена более новая версия Peering, чем это приложение. Обновите Peering из App Store и подключитесь снова."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac esegue una versione di Peering più recente di questa app. Aggiorna Peering dall'App Store, poi connettiti di nuovo."
          }
        }
      }
    },
