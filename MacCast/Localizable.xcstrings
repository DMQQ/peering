    "Remote access is turned off in Settings, so a Mac on another network cannot be reached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso remoto está desactivado en Ajustes, así que no se puede llegar a un Mac de otra red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à distance est désactivé dans Réglages, un Mac sur un autre réseau ne peut donc pas être joint."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernzugriff ist in den Einstellungen ausgeschaltet, ein Mac in einem anderen Netzwerk ist also nicht erreichbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso remoto está desativado em Ajustes, então um Mac em outra rede não pode ser alcançado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でリモートアクセスがオフになっているため、別のネットワークにあるMacには届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 원격 접근이 꺼져 있어 다른 네트워크의 Mac에는 닿을 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”中已关闭远程访问，所以无法连接其他网络上的 Mac。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённый доступ отключён в Настройках, поэтому Mac в другой сети недоступен."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso remoto è disattivato in Impostazioni, quindi un Mac su un'altra rete non può essere raggiunto."
          }
        }
      }
    },
    "“%@” is not a port number.": {
      "localizations": {
