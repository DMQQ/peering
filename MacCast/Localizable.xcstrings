      }
    },
    "A Mac on this network appears here while Peering is running on it. Tap one to connect and pair." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Mac in diesem Netzwerk erscheint hier, solange Peering darauf läuft. Tippe einen an, um ihn zu verbinden und zu koppeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Mac en esta red aparece aquí mientras Peering se ejecuta en él. Toca uno para conectarte y emparejarlo."
          }
