    "%@ Free includes %@ of relay a day. Any paid plan removes the limit." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Kostenlos enthält %@ Relay pro Tag. Jeder bezahlte Tarif hebt das Limit auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Lo gratuito incluye %@ de relay al día. Cualquier plan de pago elimina el límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Le gratuit comprend %@ de relais par jour. Toute formule payante supprime la limite."
