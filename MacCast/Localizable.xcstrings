          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot"
          }
        }
      }
    },
    "Capture what you are looking at and send it through the usual share sheet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura lo que estás viendo y envíalo con la hoja de compartir habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturez ce que vous regardez et envoyez-le par la feuille de partage habituelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm auf, was du ansiehst, und sende es über das übliche Teilen-Menü."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture o que você está vendo e envie pela folha de compartilhamento de sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見ているものを取り込み、いつもの共有シートで送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고 있는 것을 캡처해 평소의 공유 시트로 보냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕捉你正在看的内容，并通过常用的共享表单发送。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте снимок того, на что смотрите, и отправьте через привычное меню «Поделиться»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cattura ciò che stai guardando e invialo tramite il solito foglio di condivisione."
          }
        }
      }
    },
    "Driving it": {
      "localizations": {
        "es": {
