            "value": "Bei Textfeldern öffnen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir em campos de texto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストフィールドで開く"
          }
        },
        "ko": {
