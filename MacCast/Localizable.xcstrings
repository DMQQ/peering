    "Chats from Terminal on your Mac show under History with their full conversation. Paused chats wait there too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats aus dem Terminal auf deinem Mac erscheinen mit dem ganzen Gespräch im Verlauf. Pausierte Chats warten dort ebenfalls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los chats del Terminal de tu Mac aparecen en Historial con toda la conversación. Los chats en pausa esperan allí también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
