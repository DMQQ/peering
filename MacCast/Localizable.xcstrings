    "Scan the code a Mac shows to pair without ever being on the same network as it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code, den ein Mac anzeigt, um zu koppeln, ohne je im selben Netzwerk zu sein."
          }
        },
        "es" : {
          "stringUnit" : {
