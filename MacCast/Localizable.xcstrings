    "Saved hosts, passwords in the Keychain, the fingerprint shown the first time, and a Face ID or passcode lock you can put on any one of them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts guardados, contraseñas en el llavero, la huella mostrada la primera vez y un bloqueo con Face ID o código que puedes poner a cualquiera de ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôtes enregistrés, mots de passe dans le trousseau, empreinte affichée la première fois, et un verrouillage par Face ID ou code que vous pouvez poser sur chacun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Hosts, Passwörter im Schlüsselbund, der Fingerabdruck beim ersten Mal und eine Face-ID- oder Codesperre, die du auf jeden legen kannst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts salvos, senhas no Chaveiro, a impressão digital mostrada na primeira vez e um bloqueio por Face ID ou código que você pode pôr em qualquer um deles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したホスト、キーチェーン内のパスワード、初回に表示されるフィンガープリント、どれにも付けられるFace IDまたはパスコードのロック。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 호스트, 키체인의 비밀번호, 처음 표시되는 지문, 그리고 어느 것에나 걸 수 있는 Face ID 또는 암호 잠금."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的主机、钥匙串中的密码、首次显示的指纹，以及可加在任何一台上的面容 ID 或密码锁。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые хосты, пароли в связке ключей, отпечаток, показанный в первый раз, и блокировка по Face ID или коду, которую можно поставить на любой из них."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Host salvati, password nel Portachiavi, l'impronta mostrata la prima volta e un blocco con Face ID o codice che puoi mettere su ognuno."
          }
        }
      }
    },
    "Browse by tapping": {
      "localizations": {
        "es": {
