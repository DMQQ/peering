    "Nothing can be paired until this is fixed. Peering will try again the next time it starts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede emparejar nada hasta que esto se arregle. Peering lo intentará de nuevo la próxima vez que se inicie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne peut être associé tant que ce n'est pas corrigé. Peering réessaiera au prochain démarrage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange das nicht behoben ist, kann nichts gekoppelt werden. Peering versucht es beim nächsten Start erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada pode ser pareado até que isso seja corrigido. O Peering tentará de novo na próxima vez que iniciar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが解決するまで、何もペアリングできません。Peeringは次回起動時にもう一度試します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문제가 해결될 때까지 아무것도 페어링할 수 없습니다. Peering은 다음에 시작할 때 다시 시도합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此问题解决之前无法配对任何设备。Peering 会在下次启动时重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока это не исправлено, ничего связать нельзя. Peering повторит попытку при следующем запуске."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può associare nulla finché non viene risolto. Peering riproverà al prossimo avvio."
          }
        }
      }
    },
