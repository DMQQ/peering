          }
        }
      }
    },
    "A display, an app, or one window": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pantalla, una app o una ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écran, une app ou une fenêtre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Display, eine App oder ein Fenster"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tela, um app ou uma janela"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイ、App、または1つのウインドウ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이, 앱 또는 윈도우 하나"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一块显示器、一个 App 或一个窗口"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дисплей, приложение или одно окно"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un display, un'app o una finestra"
          }
        }
      }
    },
    "Every display the Mac is attached to, a single application, or one window. Switch between them without reconnecting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pantalla a la que está conectado el Mac, una sola aplicación o una ventana. Cambia entre ellas sin reconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque écran auquel le Mac est connecté, une seule application ou une fenêtre. Passez de l'un à l'autre sans reconnexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Display, an dem der Mac hängt, eine einzelne Anwendung oder ein Fenster. Wechsle zwischen ihnen, ohne dich neu zu verbinden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tela a que o Mac está conectado, um único aplicativo ou uma janela. Alterne entre eles sem reconectar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがつながっているすべてのディスプレイ、1つのアプリケーション、または1つのウインドウ。再接続せずに切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 연결된 모든 디스플레이, 하나의 응용 프로그램 또는 윈도우 하나. 재연결 없이 전환합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 连接的每块显示器、单个应用程序或一个窗口。无需重新连接即可在它们之间切换。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый дисплей, подключённый к Mac, одно приложение или одно окно. Переключайтесь между ними без переподключения."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni display a cui il Mac è collegato, una singola applicazione o una finestra. Passa dall'uno all'altro senza riconnetterti."
          }
        }
      }
    },
    "Every desktop you have": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus escritorios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous vos bureaux"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Schreibtisch, den du hast"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as suas mesas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデスクトップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 데스크탑"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的每个桌面"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый ваш рабочий стол"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni scrivania che hai"
          }
        }
      }
    },
    "All your Spaces, each drawn as a picture rather than as a number to guess at. Tap one to move the Mac to it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus Spaces, cada uno dibujado como una imagen en lugar de un número que adivinar. Toca uno para llevar el Mac a él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous vos Spaces, chacun dessiné comme une image plutôt que comme un numéro à deviner. Touchez-en un pour y amener le Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle deine Spaces, jeder als Bild gezeichnet statt als Nummer zum Raten. Tippe einen an, um den Mac dorthin zu bringen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os seus Spaces, cada um desenhado como imagem em vez de um número para adivinhar. Toque em um para levar o Mac a ele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのSpaceを、当てずっぽうの番号ではなく画像として描きます。1つタップするとMacがそこへ移ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Space를 추측해야 하는 번호가 아니라 그림으로 그립니다. 하나를 탭하면 Mac이 그리로 이동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你所有的 Space，每个都画成图片，而不是要你去猜的数字。轻点一个，Mac 就会移到那里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ваши Spaces, каждый нарисован как картинка, а не как номер, который надо угадывать. Коснитесь одного, чтобы перенести на него Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi Spaces, ciascuno disegnato come immagine invece che come numero da indovinare. Toccane uno per portare il Mac su di esso."
          }
        }
      }
    },
    "Open an app you forgot to launch": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una app que olvidaste lanzar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir une app que vous avez oublié de lancer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App öffnen, die du vergessen hast zu starten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um app que você esqueceu de iniciar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動し忘れたAppを開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행하는 것을 잊은 앱 열기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开你忘了启动的 App"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение, которое забыли запустить"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un'app che hai dimenticato di avviare"
          }
        }
      }
    },
    "The list includes applications that are installed but not running. Tap one and the Mac opens it, then it becomes a source like any other.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista incluye aplicaciones instaladas pero que no se están ejecutando. Toca una y el Mac la abre, y luego pasa a ser una fuente como cualquier otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste comprend les applications installées mais non lancées. Touchez-en une et le Mac l'ouvre, puis elle devient une source comme les autres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste enthält Anwendungen, die installiert sind, aber nicht laufen. Tippe eine an, und der Mac öffnet sie, dann wird sie eine Quelle wie jede andere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista inclui aplicativos instalados mas que não estão em execução. Toque em um e o Mac o abre, e então ele vira uma fonte como qualquer outra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧には、インストール済みで実行中でないアプリケーションも含まれます。タップするとMacが開き、他と同じようにソースになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에는 설치되어 있지만 실행 중이 아닌 응용 프로그램도 포함됩니다. 하나를 탭하면 Mac이 열고, 그다음 다른 것과 똑같은 소스가 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表包含已安装但未运行的应用程序。轻点一个，Mac 会打开它，然后它就和其他来源一样成为一个来源。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список включает приложения, которые установлены, но не запущены. Коснитесь одного, и Mac откроет его, после чего оно станет источником, как любой другой."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista include applicazioni installate ma non in esecuzione. Toccane una e il Mac la apre, poi diventa una sorgente come le altre."
          }
        }
      }
    },
    "Which path the picture took": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué camino tomó la imagen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel chemin l'image a pris"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welchen Weg das Bild genommen hat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual caminho a imagem seguiu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像が通った経路"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 지나간 경로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面走了哪条路径"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каким путём шла картинка"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale percorso ha preso l'immagine"
          }
        }
      }
    },
    "The session's info panel names the path in use and shows the round trip of the lane the picture is on, separately from the control connection's, so a session going straight is not measured by the relay's numbers.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel de información de la sesión nombra el camino en uso y muestra el tiempo de ida y vuelta del carril por el que va la imagen, por separado del de la conexión de control, así una sesión directa no se mide con los números del relay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau d'infos de la session nomme le chemin utilisé et montre l'aller-retour de la voie qu'emprunte l'image, séparément de celui de la connexion de contrôle, si bien qu'une session directe n'est pas mesurée avec les chiffres du relais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Infofenster der Sitzung nennt den benutzten Weg und zeigt die Umlaufzeit der Spur, auf der das Bild läuft, getrennt von der der Steuerverbindung, sodass eine direkte Sitzung nicht an den Zahlen des Relays gemessen wird."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel de informações da sessão nomeia o caminho em uso e mostra o tempo de ida e volta da faixa em que a imagem está, separado do da conexão de controle, então uma sessão direta não é medida pelos números do relay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの情報パネルには使用中の経路が表示され、映像が通るレーンの往復時間が制御用の接続とは別に表示されるので、直接のセッションがリレーの数値で測られることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션의 정보 패널은 사용 중인 경로를 알려 주고, 화면이 지나는 경로의 왕복 시간을 제어 연결과 별도로 보여 주므로, 직접 연결된 세션이 릴레이의 수치로 측정되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话的信息面板会指明正在使用的路径，并单独显示画面所在通道的往返时间，与控制连接分开，所以直连的会话不会用中继的数字来衡量。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Информационная панель сеанса называет используемый путь и показывает время прохождения туда и обратно по линии, по которой идёт картинка, отдельно от управляющего соединения, так что прямой сеанс не измеряется цифрами релея."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pannello info della sessione nomina il percorso in uso e mostra il tempo di andata e ritorno della corsia su cui viaggia l'immagine, separatamente da quello della connessione di controllo, così una sessione diretta non è misurata con i numeri del relay."
          }
        }
      }
    },
    "The sharpest picture over the relay": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen más nítida por el relay"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image la plus nette via le relais"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das schärfste Bild über das Relay"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem mais nítida pelo relay"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレー経由で最も鮮明な映像"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이를 거쳐도 가장 선명한 화면"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经中继的最清晰画面"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самая чёткая картинка через релей"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'immagine più nitida via relay"
          }
        }
      }
    },
    "A relayed session climbs to 20 Mbps, five times what it reaches without this. On your own network nothing is capped on any plan, because those bytes are not going through anything of ours.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión por relay sube hasta 20 Mbps, cinco veces lo que alcanza sin esto. En tu propia red nada tiene tope en ningún plan, porque esos bytes no pasan por nada nuestro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session par relais monte jusqu'à 20 Mbit/s, cinq fois ce qu'elle atteint sans cela. Sur votre propre réseau, rien n'est plafonné sur aucune formule, car ces octets ne passent par rien qui nous appartienne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Relay-Sitzung steigt auf 20 Mbit/s, das Fünffache dessen, was sie ohne das erreicht. In deinem eigenen Netzwerk ist in keinem Tarif etwas begrenzt, weil diese Bytes nicht durch etwas von uns laufen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão por relay sobe a 20 Mbps, cinco vezes o que alcança sem isto. Na sua própria rede nada tem limite em nenhum plano, porque esses bytes não passam por nada nosso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレー経由のセッションは20 Mbpsまで上がり、これがない場合の5倍になります。自分のネットワークでは、そのバイトは当社のものを何も通らないので、どのプランでも上限はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이 세션은 20 Mbps까지 올라가며, 이것이 없을 때의 다섯 배입니다. 내 네트워크에서는 그 바이트가 우리 쪽 어떤 것도 거치지 않으므로 어떤 플랜에서도 제한이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经中继的会话可提升到 20 Mbps，是没有这一项时的五倍。在你自己的网络上，任何套餐都不设上限，因为这些字节不经过我们的任何东西。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс через релей поднимается до 20 Мбит/с, в пять раз больше того, чего достигает без этого. В вашей собственной сети ничто не ограничено ни на одном тарифе, потому что эти байты не идут ни через что наше."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione via relay sale a 20 Mbps, cinque volte quanto raggiunge senza questo. Sulla tua rete nulla ha un tetto su nessun piano, perché quei byte non passano da niente di nostro."
          }
        }
      }
    },
    "Picture matched to the network": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagen ajustada a la red"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image adaptée au réseau"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild an das Netzwerk angepasst"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagem ajustada à rede"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークに合わせた映像"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크에 맞춘 화면"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面与网络匹配"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Картинка под сеть"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagine adattata alla rete"
          }
        }
      }
    },
    "The bitrate follows what the connection can carry, so a weak link degrades instead of stalling. You can also pin it to Low, Medium or High yourself.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tasa de bits sigue lo que la conexión puede llevar, así un enlace débil se degrada en lugar de bloquearse. También puedes fijarla tú en Baja, Media o Alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le débit suit ce que la connexion peut porter, si bien qu'un lien faible se dégrade au lieu de se bloquer. Vous pouvez aussi le fixer vous-même sur Faible, Moyen ou Élevé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bitrate folgt dem, was die Verbindung tragen kann, sodass eine schwache Verbindung abbaut statt zu stocken. Du kannst sie auch selbst auf Niedrig, Mittel oder Hoch festlegen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa de bits acompanha o que a conexão aguenta, então um link fraco degrada em vez de travar. Você também pode fixá-la em Baixa, Média ou Alta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビットレートは接続が運べる量に追従するので、弱い回線は止まらずに劣化します。低、中、高に固定することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비트레이트가 연결이 전달할 수 있는 양을 따라가므로, 약한 회선은 멈추는 대신 품질이 떨어집니다. 낮음, 중간, 높음으로 직접 고정할 수도 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "码率会跟随连接能够承载的量，所以较弱的链路会降级而不是卡住。你也可以自己把它固定为低、中或高。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Битрейт следует тому, что способно нести соединение, так что слабая линия деградирует, а не зависает. Можно также закрепить его на Низком, Среднем или Высоком самостоятельно."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bitrate segue ciò che la connessione può portare, così un collegamento debole degrada invece di bloccarsi. Puoi anche fissarlo tu su Bassa, Media o Alta."
          }
        }
      }
    },
    "Hear what is playing on the Mac, from music you left running to the alert it makes in answer to a key you sent it. One switch in the session panel, and turning it off only drops the sound here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oye lo que suena en el Mac, desde la música que dejaste sonando hasta el aviso que hace en respuesta a una tecla que enviaste. Un interruptor en el panel de sesión, y desactivarlo solo descarta el sonido aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendez ce que joue le Mac, de la musique laissée en route à l'alerte qu'il émet en réponse à une touche que vous avez envoyée. Un seul interrupteur dans le panneau de session, et le couper n'abandonne le son qu'ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höre, was auf dem Mac läuft, von der Musik, die du laufen ließest, bis zum Signalton, den er als Antwort auf eine gesendete Taste macht. Ein Schalter im Sitzungsbereich, und das Ausschalten verwirft den Ton nur hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouça o que toca no Mac, da música que você deixou tocando ao alerta que ele faz em resposta a uma tecla que você enviou. Um botão no painel da sessão, e desligá-lo só descarta o som aqui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで鳴っているものを聞けます。流しっぱなしの音楽から、送ったキーに対して鳴らす通知音まで。スイッチはセッションパネルに1つだけで、オフにしても音がここで破棄されるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 재생되는 소리를 들으세요. 틀어 둔 음악부터 내가 보낸 키에 대한 응답으로 내는 알림음까지. 세션 패널의 스위치 하나이며, 끄면 여기서 소리만 버려집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听到 Mac 上正在播放的声音，从你留着播放的音乐，到它为响应你发送的按键而发出的提示音。会话面板里只有一个开关，关闭它只是在这里丢弃声音。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушайте, что играет на Mac, от оставленной музыки до сигнала в ответ на отправленную клавишу. Один переключатель в панели сеанса, и его выключение лишь отбрасывает звук здесь."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta ciò che suona sul Mac, dalla musica lasciata in esecuzione all'avviso che emette in risposta a un tasto che hai inviato. Un solo interruttore nel pannello di sessione, e disattivarlo scarta il suono solo qui."
          }
        }
      }
    },
    "Keep the Mac's screen floating over other apps while you do something else.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la pantalla del Mac flotando sobre otras apps mientras haces otra cosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez l'écran du Mac flottant au-dessus des autres apps pendant que vous faites autre chose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass den Bildschirm des Macs über anderen Apps schweben, während du etwas anderes tust."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a tela do Mac flutuando sobre outros apps enquanto você faz outra coisa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のことをしている間も、Macの画面を他のAppの上に浮かせたままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 일을 하는 동안 Mac의 화면을 다른 앱 위에 띄워 두세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你做别的事时，让 Mac 的屏幕保持浮在其他 App 之上。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите экран Mac плавающим поверх других приложений, пока занимаетесь другим."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni lo schermo del Mac che fluttua sopra le altre app mentre fai altro."
          }
        }
      }
    },
    "The last twelve things that crossed between the two machines, waiting to be pasted again. Copying and pasting themselves are on every plan.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las últimas doce cosas que pasaron entre las dos máquinas, listas para pegarse de nuevo. Copiar y pegar en sí están en todos los planes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les douze dernières choses passées entre les deux machines, prêtes à être recollées. Copier et coller eux-mêmes sont sur toutes les formules."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten zwölf Dinge, die zwischen den beiden Maschinen gewandert sind, bereit zum erneuten Einfügen. Kopieren und Einfügen selbst gibt es in jedem Tarif."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As últimas doze coisas que passaram entre as duas máquinas, prontas para colar de novo. Copiar e colar em si estão em todos os planos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2台の間でやり取りした直近12件が、もう一度ペーストできる状態で待っています。コピーとペースト自体はどのプランでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 머신 사이에서 오간 최근 열두 개가 다시 붙여넣을 수 있게 기다립니다. 복사와 붙여넣기 자체는 모든 플랜에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这两台机器之间传输过的最近十二项内容，等待再次粘贴。拷贝和粘贴本身在所有套餐中都有。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние двенадцать вещей, прошедших между двумя машинами, ждут повторной вставки. Само копирование и вставка есть на каждом тарифе."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ultime dodici cose passate tra le due macchine, pronte per essere incollate di nuovo. Copiare e incollare in sé sono su ogni piano."
          }
        }
      }
    },
    "Privacy mode": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo privado"
          }
        },
        "fr": {
