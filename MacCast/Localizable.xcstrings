    "This device could not prove who it is. Check that the clock is right and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät konnte sich nicht ausweisen. Prüfe, ob die Uhrzeit stimmt, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no pudo demostrar quién es. Comprueba que la hora sea correcta e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n'a pas pu prouver son identité. Vérifiez que l'heure est correcte et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non è riuscito a dimostrare la propria identità. Controlla che l'ora sia corretta e riprova."
