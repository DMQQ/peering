            "value": "Formules"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarife"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planos"
          }
        },
        "ja": {
