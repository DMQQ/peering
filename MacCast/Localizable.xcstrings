    "That is not a pairing code. Point the camera at the code shown on your Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es un código de emparejamiento. Apunta la cámara al código que muestra tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un code d'association. Pointez l'appareil photo vers le code affiché sur votre Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Kopplungscode. Richte die Kamera auf den Code, den dein Mac anzeigt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não é um código de pareamento. Aponte a câmera para o código mostrado no seu Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それはペアリングコードではありません。Macに表示されているコードにカメラを向けてください。"
