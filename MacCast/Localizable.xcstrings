    "A one-line command that does it from the server's own shell:\n`echo '%@' >> ~/.ssh/authorized_keys`": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando de una línea que lo hace desde el propio shell del servidor:\n`echo '%@' >> ~/.ssh/authorized_keys`"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une commande d'une ligne qui le fait depuis le shell du serveur :\n`echo '%@' >> ~/.ssh/authorized_keys`"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzeiliger Befehl, der das in der Shell des Servers erledigt:\n`echo '%@' >> ~/.ssh/authorized_keys`"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um comando de uma linha que faz isso no shell do próprio servidor:\n`echo '%@' >> ~/.ssh/authorized_keys`"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ自身のシェルからこれを行う1行のコマンド:\n`echo '%@' >> ~/.ssh/authorized_keys`"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 셸에서 이를 수행하는 한 줄 명령:\n`echo '%@' >> ~/.ssh/authorized_keys`"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在服务器自己的 Shell 中完成此操作的单行命令：\n`echo '%@' >> ~/.ssh/authorized_keys`"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Однострочная команда, которая делает это из shell самого сервера:\n`echo '%@' >> ~/.ssh/authorized_keys`"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando di una riga che lo fa dalla shell del server stesso:\n`echo '%@' >> ~/.ssh/authorized_keys`"
          }
        }
      }
    },
