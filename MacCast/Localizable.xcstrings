    "Pick your Mac from the list it broadcasts, or type an address when the network hides it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu Mac de la lista que emite, o escribe una dirección cuando la red lo oculta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre Mac dans la liste qu'il diffuse, ou saisissez une adresse quand le réseau la cache."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deinen Mac aus der Liste, die er aussendet, oder tippe eine Adresse ein, wenn das Netzwerk sie verbirgt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha seu Mac na lista que ele transmite, ou digite um endereço quando a rede o esconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが発信するリストから選ぶか、ネットワークがそれを隠しているときはアドレスを入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 알리는 목록에서 고르거나, 네트워크가 숨길 때는 주소를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Mac 广播的列表中选择它，或在网络隐藏它时输入地址。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите Mac из списка, который он объявляет, или введите адрес, когда сеть его скрывает."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il tuo Mac dall'elenco che trasmette, oppure digita un indirizzo quando la rete lo nasconde."
          }
        }
      }
    },
    "Reachable from another network": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesible desde otra red"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignable depuis un autre réseau"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus einem anderen Netzwerk erreichbar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessível de outra rede"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のネットワークからも到達可能"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 네트워크에서도 접근 가능"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可从其他网络访问"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступен из другой сети"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiungibile da un'altra rete"
          }
        }
      }
    },
    "The relay finds your Mac when it is somewhere else. It carries the session without being able to read it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relay encuentra tu Mac cuando está en otro lugar. Lleva la sesión sin poder leerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais trouve votre Mac quand il est ailleurs. Il porte la session sans pouvoir la lire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Relay findet deinen Mac, wenn er woanders ist. Es trägt die Sitzung, ohne sie lesen zu können."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relay encontra seu Mac quando ele está em outro lugar. Leva a sessão sem poder lê-la."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが別の場所にあるとき、リレーがそれを見つけます。内容を読めないままセッションを運びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 다른 곳에 있을 때 릴레이가 찾아 줍니다. 읽을 수 없는 채로 세션을 전달합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Mac 在别处时，中继会找到它。它承载会话，却无法读取内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Релей находит ваш Mac, когда он в другом месте. Он несёт сеанс, не имея возможности его прочитать."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relay trova il tuo Mac quando è altrove. Porta la sessione senza poterla leggere."
          }
        }
      }
    },
    "Straight between the two": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Directo entre los dos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Directement entre les deux"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt zwischen beiden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Direto entre os dois"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのデバイスの間を直接"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 사이에 직접"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两者之间直连"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напрямую между двумя"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Direttamente tra i due"
          }
        }
      }
    },
    "When the networks allow it, the picture takes a path the two devices find for themselves, and only the control connection goes through the relay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando las redes lo permiten, la imagen toma un camino que los dos dispositivos encuentran por sí mismos, y solo la conexión de control pasa por el relay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand les réseaux le permettent, l'image emprunte un chemin que les deux appareils trouvent d'eux-mêmes, et seule la connexion de contrôle passe par le relais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Netzwerke es erlauben, nimmt das Bild einen Weg, den die beiden Geräte selbst finden, und nur die Steuerverbindung läuft über das Relay."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando as redes permitem, a imagem segue um caminho que os dois dispositivos encontram sozinhos, e só a conexão de controle passa pelo relay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークが許せば、映像は2つのデバイスが自分たちで見つけた経路を通り、制御用の接続だけがリレーを通ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크가 허용하면 화면은 두 기기가 스스로 찾은 경로로 가고, 제어 연결만 릴레이를 거칩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当网络允许时，画面走两台设备自己找到的路径，只有控制连接经过中继。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда сети позволяют, картинка идёт по пути, который два устройства находят сами, а через релей идёт только управляющее соединение."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando le reti lo permettono, l'immagine prende un percorso che i due dispositivi trovano da soli, e solo la connessione di controllo passa dal relay."
          }
        }
      }
    },
    "Pair a Mac that is not nearby": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja un Mac que no está cerca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associer un Mac qui n'est pas à proximité"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Mac koppeln, der nicht in der Nähe ist"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parear um Mac que não está por perto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くにないMacをペアリング"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처에 없는 Mac 페어링"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对不在附近的 Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связать Mac, которого нет поблизости"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associa un Mac che non è vicino"
          }
        }
      }
    },
    "Scan the code a Mac shows to pair without ever being on the same network as it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código que muestra un Mac para emparejar sin estar nunca en la misma red que él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code qu'un Mac affiche pour l'associer sans jamais être sur le même réseau que lui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Code, den ein Mac anzeigt, um zu koppeln, ohne je im selben Netzwerk zu sein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código que um Mac mostra para parear sem nunca estar na mesma rede que ele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが表示するコードをスキャンして、同じネットワークにいなくてもペアリングできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 표시하는 코드를 스캔해, 같은 네트워크에 있어 본 적 없이도 페어링합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描 Mac 显示的代码，即可在从不处于同一网络的情况下配对。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте код, который показывает Mac, чтобы связаться, никогда не находясь с ним в одной сети."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice che un Mac mostra per associarti senza mai essere sulla stessa rete."
          }
        }
      }
    },
    "Your Macs, named how you like": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus Mac, con el nombre que quieras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos Mac, nommés comme vous voulez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Macs, so benannt, wie du willst"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus Macs, com o nome que você quiser"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macに好きな名前を"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 이름의 Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你喜欢的方式命名你的 Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши Mac, названные как вам нравится"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi Mac, con il nome che vuoi"
          }
        }
      }
    },
    "Rename a paired Mac to something you recognise, or forget one you are done with. Both are on the row itself, in the list you connect from.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renombra un Mac emparejado con algo que reconozcas, u olvida uno que ya no uses. Ambas cosas están en la propia fila, en la lista desde la que te conectas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renommez un Mac associé avec un nom que vous reconnaissez, ou oubliez-en un dont vous n'avez plus besoin. Les deux se font sur la ligne elle-même, dans la liste d'où vous vous connectez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benenne einen gekoppelten Mac in etwas um, das du wiedererkennst, oder entferne einen, den du nicht mehr brauchst. Beides geht in der Zeile selbst, in der Liste, aus der du dich verbindest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomeie um Mac pareado para algo que você reconheça, ou esqueça um que você não usa mais. Ambos estão na própria linha, na lista de onde você se conecta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのMacを分かりやすい名前に変えたり、使わなくなったものを削除したりできます。どちらも、接続元のリストにあるその行で行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 Mac의 이름을 알아보기 쉽게 바꾸거나, 쓰지 않는 것은 삭제하세요. 둘 다 연결하는 목록의 해당 행에서 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把已配对的 Mac 重命名为你能认出的名称，或移除不再使用的。两者都在该行本身上进行，就在你用来连接的列表中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименуйте связанный Mac во что-то узнаваемое или забудьте тот, который больше не нужен. И то и другое прямо в строке, в списке, откуда вы подключаетесь."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina un Mac associato con qualcosa che riconosci, o dimentica uno che non usi più. Entrambe le cose sono sulla riga stessa, nella lista da cui ti connetti."
          }
        }
      }
    },
    "Says so when the network goes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa cuando la red falla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dit quand le réseau tombe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt Bescheid, wenn das Netzwerk weg ist"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa quando a rede cai"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークが切れたら知らせます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크가 끊기면 알려 줍니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络断开时会告诉你"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает, когда сеть пропадает"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo dice quando la rete cade"
          }
        }
      }
    },
    "A session the network has stopped carrying ends and tells you rather than sitting on a frozen picture, so you can reconnect instead of waiting on a screen that will never move again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión que la red ha dejado de llevar termina y te lo dice en lugar de quedarse en una imagen congelada, así puedes reconectarte en vez de esperar una pantalla que nunca volverá a moverse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session que le réseau a cessé de porter se termine et vous le dit au lieu de rester sur une image figée, pour que vous puissiez vous reconnecter plutôt que d'attendre un écran qui ne bougera plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sitzung, die das Netzwerk nicht mehr trägt, endet und sagt es dir, statt auf einem eingefrorenen Bild zu stehen, sodass du dich neu verbinden kannst, statt auf einen Bildschirm zu warten, der sich nie mehr bewegt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão que a rede deixou de carregar termina e avisa você em vez de ficar numa imagem congelada, para você se reconectar em vez de esperar uma tela que nunca mais vai se mover."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークが運ばなくなったセッションは、固まった映像のまま居座るのではなく、終了してお知らせします。二度と動かない画面を待たずに、再接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크가 더 이상 전달하지 않는 세션은 멈춘 화면에 앉아 있는 대신 종료되고 알려 주므로, 다시는 움직이지 않을 화면을 기다리지 않고 재연결할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络不再承载的会话会结束并告诉你，而不是停在冻结的画面上，这样你可以重新连接，而不是等待一块永远不会再动的屏幕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс, который сеть перестала нести, завершается и сообщает вам об этом, а не остаётся на замершей картинке, так что вы можете переподключиться, а не ждать экран, который больше никогда не сдвинется."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione che la rete ha smesso di portare termina e te lo dice invece di restare su un'immagine congelata, così puoi riconnetterti invece di aspettare uno schermo che non si muoverà mai più."
          }
        }
      }
    },
    "Biometrics to open": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometría para abrir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biométrie pour ouvrir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrie zum Öffnen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometria para abrir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開くときに生体認証"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열 때 생체 인식"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用生物识别打开"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Биометрия для открытия"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometria per aprire"
          }
        }
      }
    },
    "Require Face ID or Touch ID each time the app comes back, so a locked phone is the only thing that unlocks the Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige Face ID o Touch ID cada vez que la app vuelve, así un teléfono bloqueado es lo único que desbloquea el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigez Face ID ou Touch ID à chaque retour dans l'app, pour qu'un téléphone verrouillé soit la seule chose qui déverrouille le Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlange Face ID oder Touch ID bei jeder Rückkehr in die App, damit ein gesperrtes Telefon das Einzige ist, was den Mac entsperrt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exija Face ID ou Touch ID toda vez que o app voltar, para que um telefone bloqueado seja a única coisa que desbloqueia o Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに戻るたびにFace IDまたはTouch IDを要求するので、ロックされたiPhoneがMacをロック解除する唯一の手段になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 돌아올 때마다 Face ID나 Touch ID를 요구해, 잠긴 iPhone이 Mac의 잠금을 해제하는 유일한 수단이 되게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次 App 回来时都要求面容 ID 或触控 ID，这样解锁 Mac 的唯一途径就是已解锁的手机。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуйте Face ID или Touch ID при каждом возвращении в приложение, чтобы заблокированный телефон был единственным, что разблокирует Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi Face ID o Touch ID ogni volta che l'app torna, così un telefono bloccato è l'unica cosa che sblocca il Mac."
          }
        }
      }
    },
    "Wake a sleeping Mac": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despertar un Mac dormido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réveiller un Mac en veille"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen schlafenden Mac aufwecken"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Despertar um Mac em repouso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ中のMacを起動"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기 중인 Mac 깨우기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唤醒休眠的 Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разбудить спящий Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risveglia un Mac in stop"
          }
        }
      }
    },
    "Send a wake-up packet, then connect. It reaches a Mac on your own network, not one across the internet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un paquete de reactivación y luego conecta. Llega a un Mac de tu propia red, no a uno al otro lado de internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un paquet de réveil, puis connectez-vous. Il atteint un Mac de votre propre réseau, pas un Mac de l'autre côté d'Internet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende ein Weckpaket und verbinde dich dann. Es erreicht einen Mac in deinem eigenen Netzwerk, keinen auf der anderen Seite des Internets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie um pacote de despertar e depois conecte. Ele alcança um Mac na sua própria rede, não um do outro lado da internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動パケットを送ってから接続します。インターネットの向こうではなく、自分のネットワーク上のMacに届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨우기 패킷을 보낸 다음 연결합니다. 인터넷 너머가 아니라 내 네트워크의 Mac에 닿습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送唤醒数据包，然后连接。它到达的是你自己网络上的 Mac，而不是互联网另一端的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте пакет пробуждения, затем подключитесь. Он достигает Mac в вашей собственной сети, а не по ту сторону интернета."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un pacchetto di riattivazione, poi connettiti. Raggiunge un Mac sulla tua rete, non uno dall'altra parte di internet."
          }
        }
      }
    },
    "The picture": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen"
          }
        },
        "fr": {
          "stringUnit": {
