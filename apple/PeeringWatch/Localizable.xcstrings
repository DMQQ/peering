    "The Mac did not take the answer. Try again, or answer on your iPhone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac did not take the answer. Try again, or answer on your iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mac hat die Antwort nicht angenommen. Versuche es erneut oder antworte auf dem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac no aceptó la respuesta. Inténtalo de nuevo o responde en el iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mac n'a pas pris la réponse. Réessayez ou répondez sur l'iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Mac non ha accettato la risposta. Riprova o rispondi dall'iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macが回答を受け付けませんでした。もう一度試すか、iPhoneで答えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac이 답변을 받지 못했습니다. 다시 시도하거나 iPhone에서 답해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mac não aceitou a resposta. Tente de novo ou responda no iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac не принял ответ. Повторите попытку или ответьте на iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 没有接收这次回答。请重试，或在 iPhone 上回答。"
          }
        }
      }
    },
    "Your iPhone is not reachable. Open Peering on it and try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone is not reachable. Open Peering on it and try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iPhone ist nicht erreichbar. Öffne Peering darauf und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu iPhone no está disponible. Abre Peering en él e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre iPhone est injoignable. Ouvrez Peering dessus et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo iPhone non è raggiungibile. Apri Peering e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneに接続できません。iPhoneでPeeringを開いてもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에 연결할 수 없습니다. iPhone에서 Peering을 열고 다시 시도해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu iPhone não está acessível. Abra o Peering nele e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone недоступен. Откройте на нём Peering и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 iPhone。请在 iPhone 上打开 Peering 后重试。"
          }
        }
      }
    },
    "Your iPhone is not reachable. Questions that arrive while it is away still show up here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone is not reachable. Questions that arrive while it is away still show up here."
          }
        },
        "de" : {
          "stringUnit" : {
