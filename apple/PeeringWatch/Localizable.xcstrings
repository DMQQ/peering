    "Open Peering on your iPhone to answer this one." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Peering on your iPhone to answer this one."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Peering auf deinem iPhone, um diese zu beantworten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Peering en tu iPhone para responder a esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Peering sur votre iPhone pour répondre à celle-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Peering sul tuo iPhone per rispondere a questa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この質問にはiPhoneでPeeringを開いて答えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 질문은 iPhone에서 Peering을 열어 답해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o Peering no iPhone para responder a esta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Peering на iPhone, чтобы ответить на этот вопрос."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 iPhone 上打开 Peering 来回答这个问题。"
          }
        }
      }
    },
    "Questions from your agents show up here." : {
