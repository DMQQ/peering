    "Turn on Microphone and Speech Recognition for Peering in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Microphone and Speech Recognition for Peering in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere in den Einstellungen Mikrofon und Spracherkennung für Peering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el micrófono y el reconocimiento de voz para Peering en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le micro et la reconnaissance vocale pour Peering dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva microfono e riconoscimento vocale per Peering in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でPeeringのマイクと音声認識をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 Peering의 마이크와 음성 인식을 켜 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o microfone e o reconhecimento de fala do Peering em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите микрофон и распознавание речи для Peering в настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中为 Peering 打开麦克风和语音识别。"
          }
        }
      }
    },
