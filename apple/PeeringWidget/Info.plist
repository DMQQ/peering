<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Peering</string>
	<key>CFBundleName</key>
	<string>Peering</string>
	<!--
	  Carried here as well as in the app, though the extension is not the bundle App Store
	  Connect asks about and does no encryption of its own beyond reading the App Group. The
	  answer is the app's answer, and the reasoning behind it is written out in full in
	  Config/Peering-Info.plist. It is here so that a tool reading this plist on its own
	  cannot come away thinking the question was left unanswered.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
</dict>
</plist>
