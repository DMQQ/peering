    "If discovery is blocked where you are, enter %@:%u on your iPhone by hand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Erkennung dort, wo du bist, blockiert ist, gib %@:%u von Hand auf deinem iPhone ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el descubrimiento está bloqueado donde estás, introduce %@:%u a mano en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la découverte est bloquée là où vous êtes, saisissez %@:%u à la main sur votre iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il rilevamento è bloccato dove ti trovi, inserisci %@:%u a mano su iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの場所でデバイスの検出がブロックされている場合は、iPhoneで%@:%uを手動で入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "있는 곳에서 검색이 차단되어 있다면, iPhone에서 %@:%u을(를) 직접 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a descoberta estiver bloqueada onde você está, digite %@:%u à mão no iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если обнаружение заблокировано там, где вы находитесь, введите %@:%u на iPhone вручную."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你所在的地方发现功能被阻止，请在 iPhone 上手动输入 %@:%u。"
          }
        }
      }
    },
    "If discovery is blocked where you are, enter this Mac's address and port %@ by hand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
