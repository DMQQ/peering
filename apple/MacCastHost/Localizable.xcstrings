        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요약과 목록은 최근 20개 세션을 대상으로 합니다. 바이트는 호스트가 보낸 비디오 스트림입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O resumo e a lista cobrem as últimas 20 sessões. Os bytes são o vídeo que o host enviou."
          }
        },
        "ru" : {
          "stringUnit" : {
