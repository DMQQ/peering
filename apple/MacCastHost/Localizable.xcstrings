    "Could not %@ (%@). If you are running the app from outside your Applications folder, move it there and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nicht möglich (%@). Wenn du die App von außerhalb des Ordners Programme ausführst, verschiebe sie dorthin und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo %@ (%@). Si ejecutas la app desde fuera de la carpeta Aplicaciones, muévela allí e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de %@ (%@). Si vous exécutez l'app depuis un autre endroit que le dossier Applications, déplacez-la-y et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile %@ (%@). Se esegui l'app da fuori della cartella Applicazioni, spostala lì e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@できませんでした（%@）。アプリを「アプリケーション」フォルダの外から実行している場合は、そこに移動してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@할 수 없었습니다(%@). 앱을 응용 프로그램 폴더 밖에서 실행 중이라면 그곳으로 옮긴 다음 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível %@ (%@). Se você executa o app fora da pasta Aplicativos, mova-o para lá e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось: %@ (%@). Если вы запускаете приложение не из папки «Программы», переместите его туда и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法%@（%@）。如果你是从“应用程序”文件夹之外运行 App，请把它移到那里再试一次。"
          }
        }
      }
    },
