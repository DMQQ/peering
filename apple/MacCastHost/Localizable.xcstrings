    "Let this Mac sleep on its own again; the switches are still set as you left them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass diesen Mac wieder von selbst schlafen; die Schalter bleiben so, wie du sie gelassen hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que este Mac vuelva a dormir por sí solo; los interruptores siguen como los dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez ce Mac se remettre en veille tout seul ; les interrupteurs restent comme vous les avez laissés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che questo Mac torni ad andare in stop da solo; gli interruttori restano come li hai lasciati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacを再び自動でスリープさせます。スイッチは設定したままです。"
          }
        },
        "ko" : {
