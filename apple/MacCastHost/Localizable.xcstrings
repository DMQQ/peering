          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте код в боковой панели с помощью Peering. После связывания этот Mac остаётся доступным через релей в любой сети."
          }
        },
        "zh-Hans" : {
