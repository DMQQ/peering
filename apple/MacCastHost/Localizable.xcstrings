          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code de la barre latérale avec Peering. Une fois associé, ce Mac reste joignable via le relais sur n'importe quel réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona il codice nella barra laterale con Peering. Una volta associato, questo Mac resta raggiungibile tramite il relay su qualsiasi rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバーのコードをPeeringでスキャンしてください。ペアリング後は、このMacはどのネットワークからでもリレー経由で接続できます。"
          }
