  "strings" : {
    "" : {},
    " The lid-close switch below needs its administrator rule before this can release it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Der Deckel-Schalter unten braucht seine Administratorregel, bevor dies ihn lösen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " El interruptor de la tapa de abajo necesita su regla de administrador antes de que esto pueda soltarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " L'interrupteur du capot ci-dessous a besoin de sa règle d'administrateur avant que ceci puisse le relâcher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " L'interruttore del coperchio qui sotto ha bisogno della sua regola di amministratore prima che questo possa rilasciarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 下の蓋のスイッチには管理者ルールが必要で、それがないとこれを解除できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 아래의 덮개 스위치에는 관리자 규칙이 필요하며, 그래야 이것이 해제할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " O botão da tampa abaixo precisa da regra de administrador dele antes que isto possa soltá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Переключателю крышки ниже нужно его правило администратора, прежде чем это сможет его отпустить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 下面的合盖开关需要它的管理员规则，之后这个才能将其释放。"
          }
        }
      }
    },
    "%@ can now reconnect automatically." : {
      "localizations" : {
