    "That transfer stopped sending, so this Mac dropped it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Übertragung hat nichts mehr gesendet, daher hat dieser Mac sie verworfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transferencia dejó de enviar datos, así que este Mac la descartó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le transfert a cessé d'envoyer des données, ce Mac l'a donc abandonné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
