    "HEVC saves bandwidth on supported devices. Applies when the next stream starts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEVC spart Bandbreite auf unterstützten Geräten. Gilt beim Start des nächsten Streams."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEVC ahorra ancho de banda en dispositivos compatibles. Se aplica al iniciar la siguiente transmisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEVC économise de la bande passante sur les appareils compatibles. S'applique au démarrage du prochain flux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEVC risparmia banda sui dispositivi compatibili. Si applica all'avvio del prossimo streaming."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEVCは対応デバイスで帯域を節約します。次のストリーム開始時に反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEVC는 지원되는 기기에서 대역폭을 절약합니다. 다음 스트림이 시작될 때 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O HEVC economiza banda em dispositivos compatíveis. Vale quando a próxima transmissão começa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEVC экономит трафик на поддерживаемых устройствах. Применяется при запуске следующего потока."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEVC 在受支持的设备上节省带宽。在下一次串流开始时生效。"
          }
        }
      }
    },
