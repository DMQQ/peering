          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no respondió a tiempo. Puede que la carpeta esté en un disco que no responde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac n'a pas répondu à temps. Le dossier se trouve peut-être sur un disque qui ne répond pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac non ha risposto in tempo. La cartella potrebbe trovarsi su un disco che non risponde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacが時間内に応答しませんでした。フォルダが応答しないドライブにある可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac이 제때 응답하지 않았습니다. 폴더가 응답하지 않는 드라이브에 있을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac não respondeu a tempo. A pasta pode estar em um disco que não está respondendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac не ответил вовремя. Возможно, папка находится на диске, который не отвечает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 未能及时响应。该文件夹可能位于无响应的磁盘上。"
          }
        }
      }
    },
    "This Mac is busy with other file requests. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac ist mit anderen Dateianfragen beschäftigt. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac está ocupado con otras solicitudes de archivos. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac est occupé par d'autres requêtes de fichiers. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac è occupato con altre richieste di file. Riprova tra un attimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacは他のファイル要求の処理中です。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac이 다른 파일 요청을 처리하는 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac está ocupado com outras solicitações de arquivos. Tente novamente em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac занят другими запросами к файлам. Повторите попытку через минуту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 正忙于处理其他文件请求。请稍后再试。"
          }
        }
      }
    },
    "This Mac's disk is not keeping up, so that transfer was stopped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Festplatte dieses Mac kommt nicht hinterher, daher wurde die Übertragung gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco de este Mac no da abasto, así que se detuvo la transferencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque de ce Mac ne suit pas, le transfert a donc été arrêté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disco di questo Mac non regge il ritmo, quindi il trasferimento è stato interrotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacのディスクが追いつかないため、転送を停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 디스크가 따라가지 못해 전송을 중단했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O disco deste Mac não está acompanhando, então a transferência foi interrompida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск этого Mac не справляется, поэтому передача остановлена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 的磁盘跟不上，因此已停止传输。"
          }
        }
      }
    },
    "≈ %@ CPU · %@" : {
      "shouldTranslate" : false
    },
    "3/4 captures at 75% width and height (~56% of pixels). Half is a quarter of the pixels. Applies when the next stream starts, which is a change of source or the next connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4 nimmt mit 75 % Breite und Höhe auf (~56 % der Pixel). Die Hälfte ist ein Viertel der Pixel. Gilt beim Start des nächsten Streams, also bei einem Quellenwechsel oder der nächsten Verbindung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4 captura al 75 % de ancho y alto (~56 % de los píxeles). La mitad es un cuarto de los píxeles. Se aplica al iniciar la siguiente transmisión, que es un cambio de fuente o la siguiente conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4 capture à 75 % de la largeur et de la hauteur (~56 % des pixels). La moitié représente un quart des pixels. S'applique au démarrage du prochain flux, c'est-à-dire à un changement de source ou à la prochaine connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4 cattura al 75% di larghezza e altezza (~56% dei pixel). La metà è un quarto dei pixel. Si applica all'avvio del prossimo streaming, cioè a un cambio di sorgente o alla prossima connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4は幅と高さを75%でキャプチャします（ピクセル数の約56%）。1/2はピクセル数の4分の1です。次のストリーム開始時、つまりソースの変更または次の接続時に反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4는 가로와 세로 75%로 캡처합니다(픽셀의 약 56%). 절반은 픽셀의 4분의 1입니다. 다음 스트림이 시작될 때, 즉 소스가 바뀌거나 다음 연결 시 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4 captura com 75% da largura e da altura (~56% dos pixels). Metade é um quarto dos pixels. Vale quando a próxima transmissão começa, ou seja, numa troca de fonte ou na próxima conexão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4 захватывает 75% ширины и высоты (~56% пикселей). Половина это четверть пикселей. Применяется при запуске следующего потока: при смене источника или следующем подключении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4 以 75% 的宽高捕捉（约 56% 的像素）。一半是四分之一的像素。在下一次串流开始时生效，即更换来源或下次连接时。"
          }
        }
      }
    },
    "30 fps" : {
      "shouldTranslate" : false
    },
    "30 fps saves bandwidth and battery. 60 fps is the standard. 120 fps only gains anything on a ProMotion display and doubles what must be sent. Applies when the next stream starts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 fps spart Bandbreite und Akku. 60 fps ist der Standard. 120 fps bringt nur auf einem ProMotion-Display etwas und verdoppelt, was gesendet werden muss. Gilt beim Start des nächsten Streams."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 fps ahorra ancho de banda y batería. 60 fps es lo estándar. 120 fps solo aporta algo en una pantalla ProMotion y duplica lo que hay que enviar. Se aplica al iniciar la siguiente transmisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 i/s économise la bande passante et la batterie. 60 i/s est le standard. 120 i/s n'apporte quelque chose que sur un écran ProMotion et double ce qu'il faut envoyer. S'applique au démarrage du prochain flux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 fps risparmia banda e batteria. 60 fps è lo standard. 120 fps ha senso solo su un display ProMotion e raddoppia ciò che va inviato. Si applica all'avvio del prossimo streaming."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 fpsは帯域とバッテリーを節約します。60 fpsが標準です。120 fpsはProMotionディスプレイでしか効果がなく、送るデータが倍になります。次のストリーム開始時に反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30fps는 대역폭과 배터리를 절약합니다. 60fps가 표준입니다. 120fps는 ProMotion 디스플레이에서만 의미가 있고 보내야 할 양이 두 배가 됩니다. 다음 스트림이 시작될 때 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 fps economiza banda e bateria. 60 fps é o padrão. 120 fps só traz algo em uma tela ProMotion e dobra o que precisa ser enviado. Vale quando a próxima transmissão começa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 к/с экономит трафик и батарею. 60 к/с это стандарт. 120 к/с даёт что-то только на дисплее ProMotion и удваивает то, что нужно отправлять. Применяется при запуске следующего потока."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 fps 节省带宽和电量。60 fps 是标准。120 fps 仅在 ProMotion 显示器上有意义，并且需要发送的数据翻倍。在下一次串流开始时生效。"
          }
        }
      }
    },
    "60 fps" : {
      "shouldTranslate" : false
    },
    "120 fps" : {
      "shouldTranslate" : false
    },
