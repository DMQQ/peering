          }
        }
      }
    },
    "The administrator rule covers only %@ and %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Administratorregel gilt nur für %@ und %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
