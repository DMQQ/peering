          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리자 규칙은 %@ 및 %@만 포함합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
