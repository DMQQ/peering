          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面全体をライブでストリーミング中。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 화면을 실시간으로 스트리밍 중."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
