    },
    "The whole screen, streaming live." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ganze Bildschirm, live gestreamt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda la pantalla, transmitiendo en vivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écran entier, diffusé en direct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
