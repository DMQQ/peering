            "value" : "À l'écoute sur le port %u sous le nom « %@ »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ascolto sulla porta %u come “%@”"
          }
        },
        "ja" : {
          "stringUnit" : {
