    "Accessibility is picked up straight away. Screen Recording needs a relaunch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen werden sofort erkannt. Bildschirmaufnahme braucht einen Neustart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La accesibilidad se detecta enseguida. La grabación de pantalla requiere reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accessibilité est prise en compte immédiatement. L'enregistrement d'écran nécessite un relancement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accessibilità viene rilevata subito. La registrazione schermo richiede un riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティはすぐに反映されます。画面収録は再起動が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용은 바로 반영됩니다. 화면 기록은 다시 열어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Acessibilidade é detectada de imediato. A Gravação de Tela precisa de reabertura."
          }
        },
        "ru" : {
          "stringUnit" : {
