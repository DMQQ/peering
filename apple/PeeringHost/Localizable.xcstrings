    "%@ can now reconnect automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann sich jetzt automatisch wieder verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya puede reconectarse automáticamente."
          }
        },
