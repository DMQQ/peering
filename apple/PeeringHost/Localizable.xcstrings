          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правило администратора распространяется только на %@ и %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
