<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Peering</string>
	<key>CFBundleName</key>
	<string>Peering</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>pl.dmq.peering.host</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>peering-host</string>
			</array>
		</dict>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_remotedesktop._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Peering accepts screen-sharing connections from devices you have paired with it.</string>
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://getpeering.app/updates/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>upn2nq1RFvoZVaug6TqhKto+H7XwH5vJ9fCfT/DBtzM=</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!--
	  The same declaration the iOS app makes, and here it is about exporting rather than about
	  App Store Connect: this Mac ships by download, and putting software on a web server is an
	  export whether or not a store is involved. The reasoning is the app's own and is written
	  out in full in Config/MacCast-Info.plist: standard algorithms, implemented by the
	  operating system, and no third-party crypto in the bundle.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
