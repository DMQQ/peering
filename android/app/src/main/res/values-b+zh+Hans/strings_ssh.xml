    <string name="ssh_forwards_title">端口转发</string>
    <string name="ssh_forwards_footer_idle">要建立的隧道列表。每条隧道只在这部手机上监听，因此手机上的其他 App 可以访问服务器能看到的服务。</string>
    <string name="ssh_forwards_footer_live">转发只在此连接存续期间运行。关闭连接，或离开 App 足够长的时间，转发就会结束，这里没有任何机制能让它在后台保持运行。</string>
    <string name="ssh_forward_add">添加转发</string>
    <string name="ssh_forward_title">端口转发</string>
    <string name="ssh_forward_name">名称（可选）</string>
    <string name="ssh_forward_local_card">这部手机</string>
    <string name="ssh_forward_local_footer">手机上其他 App 将要连接的端口。把它指向 localhost:%1$s 即可。</string>
    <string name="ssh_forward_local">本地端口</string>
    <string name="ssh_forward_remote_card">服务器一侧</string>
    <string name="ssh_forward_remote_footer">服务器要连接的目标，以服务器的视角来看。对于只在服务器本机监听的服务，可以是 127.0.0.1；也可以是只有服务器才能解析的名称。</string>
    <string name="ssh_forward_remote_host">主机</string>
    <string name="ssh_forward_remote_port">端口</string>
    <string name="ssh_forward_when_card">打开 shell 时</string>
    <string name="ssh_forward_when_footer">转发只在与此服务器的连接存续期间运行。无法让它在后台保持运行。</string>
    <string name="ssh_forward_enabled">随连接一起启动</string>
    <string name="ssh_forward_running">运行中</string>
    <string name="ssh_forward_stopped">已停止</string>
    <string name="ssh_forward_delete">删除转发</string>
    <string name="ssh_forward_err_local_nan">本地端口必须是数字。</string>
    <string name="ssh_forward_err_local_range">本地端口必须在 1 到 65535 之间。</string>
    <string name="ssh_forward_err_remote_nan">服务器上的端口必须是数字。</string>
    <string name="ssh_forward_err_remote_range">服务器上的端口必须在 1 到 65535 之间。</string>
    <string name="ssh_forward_err_host_empty">请指明服务器应连接到哪台机器。它是隧道另一端的机器，由服务器负责发起连接。</string>
    <string name="ssh_forward_err_host_invalid">这不是主机名或地址。只能包含字母、数字、点、冒号、下划线和连字符。</string>
    <string name="ssh_forward_err_used">此服务器已经在转发 %1$d。两个转发不能监听同一个端口，因此其中一个永远无法启动。</string>
