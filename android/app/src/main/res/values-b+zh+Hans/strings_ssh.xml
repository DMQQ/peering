    <string name="ssh_signin_password_footer">打开 shell 时会要求输入密码。在该提示中选择“记住密码”，可将其保存在这部手机的安全存储中。</string>
    <string name="ssh_signin_key_footer">密钥会取代此服务器的密码，而不是与密码并存。私钥部分保存在这部手机的安全存储中；公钥部分则是你要写入服务器 ~/.ssh/authorized_keys 的那一行。</string>
    <string name="ssh_signin_key_missing">选择密钥</string>

    <string name="ssh_key_title">密钥</string>
    <string name="ssh_key_public">公钥</string>
    <string name="ssh_key_public_footer">请把这一行追加到服务器的 ~/.ssh/authorized_keys 中。私钥部分保留在这部手机的安全存储中，除作为签名外，绝不会发送到任何地方。</string>
    <string name="ssh_key_copy">拷贝公钥</string>
    <string name="ssh_key_copied">公钥已拷贝</string>
    <string name="ssh_key_where">来源</string>
    <string name="ssh_key_generate">生成新密钥</string>
    <string name="ssh_key_import_file">导入密钥文件</string>
    <string name="ssh_key_paste">粘贴密钥</string>
    <string name="ssh_key_from_generate">适用于尚未设置密钥的服务器。这是 ed25519 密钥，也是 OpenSSH 默认生成的类型。</string>
    <string name="ssh_key_from_paste">需要的是私钥部分，而不是公钥。如果你手上的内容以 ssh-ed25519 开头，那是服务器需要的那一半。</string>
    <string name="ssh_key_name">名称</string>
    <string name="ssh_key_name_footer">仅作标签。服务器会把它显示在密钥旁，让你区分这把密钥和你笔记本电脑所用的密钥。</string>
    <string name="ssh_key_text">私钥</string>
    <string name="ssh_key_has_passphrase">它有口令</string>
    <string name="ssh_key_passphrase">口令</string>
    <string name="ssh_key_passphrase_footer">仅当密钥设有口令时才需要。它会与密钥一同保存在这部手机的安全存储中，因为手机上没有可询问的 ssh-agent。</string>
    <string name="ssh_key_use">使用此密钥</string>
    <string name="ssh_key_err_not_private">这不是私钥。私钥以 -----BEGIN OPENSSH PRIVATE KEY----- 开头。如果你粘贴的是以 ssh-ed25519 开头的一行，那是公钥，应放在服务器上，而不是这里。</string>
    <string name="ssh_key_err_malformed">无法读取此密钥：%1$s</string>
    <string name="ssh_key_err_needs_passphrase">此密钥设有口令。请输入口令，以便 App 在连接时解锁密钥。</string>
    <string name="ssh_key_err_wrong_passphrase">该口令无法解锁此密钥。</string>
    <string name="ssh_key_err_file">无法读取该文件。</string>

    <string name="ssh_hostkey_title">这是正确的机器吗？</string>
    <string name="ssh_hostkey_body">这是你第一次连接 %1$s。请将其指纹与服务器本身核对。大多数服务商会在其控制台中显示指纹，也可以在机器上用 ssh-keygen -lf 打印。</string>
    <string name="ssh_hostkey_trust">信任</string>
    <string name="ssh_changed_title">服务器的密钥已更改</string>
    <string name="ssh_changed_body">自你上次连接以来，服务器的密钥已更改。如果不是你所为，请不要继续。</string>
    <string name="ssh_changed_known">已存储：%1$s %2$s</string>
    <string name="ssh_changed_offered">当前提供：%1$s %2$s</string>
    <string name="ssh_changed_help">如果你重装了服务器，或知道密钥为何更改，请使用服务器菜单中的“忘记其密钥”，然后重新连接。如果不知道原因，可能有人正位于你与服务器之间。</string>

