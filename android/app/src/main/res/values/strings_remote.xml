    <string name="panel_lock">Lock computer · unlock locally</string>
    <string name="panel_lock_title">Lock this computer?</string>
    <string name="panel_lock_message">The computer will lock immediately. macOS does not let a remote app past its login screen, so someone must unlock it there. Peering reconnects after it wakes or is unlocked.</string>
    <string name="panel_lock_confirm">Lock computer</string>
    <string name="panel_state_connected">Connected</string>
    <string name="panel_state_connecting">Connecting</string>
    <string name="panel_state_reconnecting">Offline, reconnecting</string>
    <string name="panel_state_not_streaming">Not streaming</string>
    <string name="panel_stream">Stream</string>
    <string name="panel_display_app_window">Display, app or window</string>
    <string name="panel_quality_automatic">Automatic</string>
    <string name="panel_quality_manual">Manual</string>
    <string name="panel_quality_auto_note">Peering picks the rate and moves it as the connection does: down when frames arrive late or are dropped, up again after a stretch of clean ones. Low is 2 Mbps, Medium is 8, High is 20.</string>
    <string name="panel_quality_manual_note">The computer sends the picture at the rate you chose and holds it whatever the network does. A connection with less room than that shows it as stutter rather than a softer picture: Low is 2 Mbps, Medium is 8, High is 20.</string>
    <string name="panel_hevc_yes">HEVC supported</string>
    <string name="panel_hevc_yes_note">This phone can decode H.265. Enable HEVC on the computer for better quality at lower bandwidth.</string>
    <string name="panel_hevc_no">HEVC not supported</string>
    <string name="panel_hevc_no_note">This phone cannot decode H.265. Use H.264 on the computer for the best performance.</string>
    <string name="panel_panels">Panels</string>
    <string name="panel_panels_note">The Apps panel puts itself away once you have picked a source, a desktop or an application. Shortcuts stays open either way: its buttons are key presses rather than choices, and a panel that shut after every one would have to be reopened for the next.</string>
    <string name="panel_privacy">Privacy</string>
    <string name="panel_allow_relay">Allow the relay</string>
    <string name="panel_allow_relay_note">On: when your computer is not on this network, Peering reaches it through a relay server. The connection is still end-to-end encrypted and the relay cannot read it, but the computer\'s device ID and the times you connect do pass through that server. Off: Peering only ever connects directly, over a network you are both on.</string>
    <string name="panel_darken">Darken the computer\'s displays</string>
    <string name="panel_darken_note">Privacy mode darkens the computer\'s displays without stopping the stream. Everything is restored when you turn it off or disconnect.</string>
