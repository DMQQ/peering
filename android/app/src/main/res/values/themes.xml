<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Peering" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/backdrop</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Opaque, with no windowAnimationStyle and no translucency, so the system's own activity transitions play. -->
    <style name="Theme.Peering.Hub" parent="Theme.Peering" />

    <style name="Theme.Peering.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/backdrop</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Peering</item>
    </style>
</resources>
