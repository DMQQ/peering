    <string name="panel_lock">Verrouiller l\'ordinateur · déverrouiller sur place</string>
    <string name="panel_lock_title">Verrouiller cet ordinateur ?</string>
    <string name="panel_lock_message">L\'ordinateur se verrouillera immédiatement. macOS ne laisse pas une app distante passer son écran de connexion, donc quelqu\'un doit le déverrouiller sur place. Peering se reconnecte après sa sortie de veille ou son déverrouillage.</string>
    <string name="panel_lock_confirm">Verrouiller l\'ordinateur</string>
