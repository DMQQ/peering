    <string name="ssh_server_card">서버</string>
    <string name="ssh_server_footer">이름은 목록에 표시되는 이름이며, 비워 두면 호스트가 사용됩니다. 서버가 다르게 안내하지 않는 한 포트는 22입니다.</string>
    <string name="ssh_field_name">이름(선택)</string>
