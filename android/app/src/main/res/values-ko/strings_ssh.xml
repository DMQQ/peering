    <string name="ssh_close">닫기</string>
    <string name="ssh_end_title">연결을 종료할까요?</string>
    <string name="ssh_end_body">서버의 셸과 그 안에서 실행 중인 모든 것이 중지됩니다.</string>
    <string name="ssh_end_confirm">종료</string>
    <string name="ssh_back">서버 목록으로 돌아가기</string>
    <string name="ssh_files_ended">이 연결이 종료되었습니다. 파일을 보려면 서버를 다시 여세요.</string>
    <string name="ssh_forwards_title">포트 포워드</string>
    <string name="ssh_forwards_footer_idle">설정할 터널 목록입니다. 각 터널은 이 휴대전화에서만 수신하므로, 휴대전화의 다른 앱이 서버에서 보이는 서비스에 접근할 수 있습니다.</string>
    <string name="ssh_forwards_footer_live">포워딩은 이 연결이 유지되는 동안만 실행됩니다. 연결을 닫거나 앱을 오래 떠나면 종료되며, 여기에서는 백그라운드에서 유지할 수 없습니다.</string>
    <string name="ssh_forward_add">포워드 추가</string>
    <string name="ssh_forward_title">포트 포워딩</string>
    <string name="ssh_forward_name">이름(선택)</string>
    <string name="ssh_forward_local_card">이 휴대전화</string>
    <string name="ssh_forward_local_footer">이 휴대전화의 다른 앱이 연결할 포트입니다. localhost:%1$s로 지정하면 됩니다.</string>
    <string name="ssh_forward_local">로컬 포트</string>
    <string name="ssh_forward_remote_card">서버 쪽</string>
    <string name="ssh_forward_remote_footer">서버에서 본 서버의 연결 대상입니다. 서버 자체에서만 수신하는 서비스는 127.0.0.1, 서버에서만 확인되는 이름도 가능합니다.</string>
    <string name="ssh_forward_remote_host">호스트</string>
    <string name="ssh_forward_remote_port">포트</string>
    <string name="ssh_forward_when_card">셸이 열릴 때</string>
    <string name="ssh_forward_when_footer">포워딩은 이 서버와의 연결이 유지되는 동안만 실행됩니다. 백그라운드에서 유지할 방법은 없습니다.</string>
    <string name="ssh_forward_enabled">연결과 함께 시작</string>
    <string name="ssh_forward_running">실행 중</string>
    <string name="ssh_forward_stopped">중지됨</string>
    <string name="ssh_forward_delete">앞으로 삭제</string>
    <string name="ssh_forward_err_local_nan">로컬 포트는 숫자여야 합니다.</string>
    <string name="ssh_forward_err_local_range">로컬 포트는 1에서 65535 사이여야 합니다.</string>
    <string name="ssh_forward_err_remote_nan">서버의 포트는 숫자여야 합니다.</string>
    <string name="ssh_forward_err_remote_range">서버의 포트는 1에서 65535 사이여야 합니다.</string>
    <string name="ssh_forward_err_host_empty">서버가 어느 머신에 연결할지 입력하세요. 터널 반대쪽 끝의 머신이며, 연결을 만드는 쪽은 서버입니다.</string>
    <string name="ssh_forward_err_host_invalid">호스트 이름이나 주소가 아닙니다. 영문자, 숫자, 점, 콜론, 밑줄, 하이픈만 사용할 수 있습니다.</string>
    <string name="ssh_forward_err_used">이 서버는 이미 %1$d번을 포워딩합니다. 같은 포트에서 두 포워딩이 수신할 수 없으므로 하나는 시작되지 않습니다.</string>
</resources>
