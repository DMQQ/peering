# peeringd, as a service.
#
# Install: see "Keeping it running" in Relay/README.md.
#
# This file exists because of a specific afternoon. The relay stopped, and nobody knew: the first
# sign was the site answering 502, found by hand, hours later. A process started from a shell
# dies with the shell; a unit with `Restart=always` gets up again in two seconds and, more to the
# point, can be *asked* whether it is up.
#
# **This file describes the machine it runs on, and that is a correction.** Until it was installed
# by the deploy script it had never been installed here at all, and the copy in the repository had
# drifted from the one actually running in four ways, each of which stops the service outright: a
# `User=` that does not exist on the box, an `ExecStart=` and a `WorkingDirectory=` under `/opt`
# that were never created, and an `EnvironmentFile=` in a directory nobody made. Installing it took
# the relay down. What follows is what the box actually runs, and the deploy script ships it, so
# the two cannot drift again.

[Unit]
Description=Peering relay (peeringd)
Documentation=https://getpeering.app/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# **Root, and it is not laziness.** The signalling listener terminates TLS with the Let's Encrypt
# certificate, and `privkey.pem` is mode 600 owned by root. A dedicated service user would have to
# be given read access to it, which means either loosening the key or an ACL, and neither is worth
# doing to drop a privilege that a service reading every byte of two devices' traffic does not much
# benefit from. What actually limits this process is the hardening below, which is about what it can
# reach rather than who it is.
#
# There is deliberately no `WorkingDirectory=`. The path the repository named was never created, and
# nothing here depends on the working directory: the site root in the environment file is absolute.

# The relay-time counter's home. systemd creates it, and under `ProtectSystem=strict` below it is
# the one path that stays writable, which is why this is a `StateDirectory` rather than a directory
# an install step has to create and get the ownership of right. See "Relay time is remembered" in
# the README.
StateDirectory=peeringd

# Where the counter goes, spelled from the state directory above so that moving the state directory
# moves this too. **Before the `EnvironmentFile` rather than after it**, and the order is the whole
# of the decision: systemd applies these in the order they appear, so a value in the operator's file
# wins over this line, where the other way round the file would be quietly overruled by a default.
Environment=PEERINGD_USAGE_LOG=%S/peeringd/usage.log

# Every setting the relay takes, in one root-owned file, so this unit can stay in version control
# without carrying a certificate path or an API key. See the environment table in the README.
#
# **`/etc/peeringd.env`, not `/etc/peeringd/peeringd.env`.** The README used to describe a directory
# and an install step to create it; the step was never run and the file has been at this path since
# the first deploy. The path in this file is the path that exists.
EnvironmentFile=/etc/peeringd.env

ExecStart=/usr/local/bin/peeringd

# The whole reason this file exists. `Restart=always` rather than `on-failure`, because a clean
# exit is also an outage: a signal, an operator's mistake, a panic that unwound tidily.
Restart=always
RestartSec=2

# The relay's design principle is that it should be too stupid to break the property it exists to
# provide: it copies bytes it cannot read. These settings are the same idea applied from the
# outside, so that a bug in it has very little to work with. None of them names a user, so none of
# them needs the service to stop being root.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# There is no `AmbientCapabilities=` here, and there was in the version this replaced: it granted
# `CAP_NET_BIND_SERVICE` for a listener on port 443, which this box does not have. nginx holds 443
# and proxies to the relay on 8443 and 8080, and `CapabilityBoundingSet=` would have taken away
# every other capability from a process that was otherwise root. A setting that is wrong about the
# machine is worse than no setting.
ReadOnlyPaths=/etc/peeringd.env /etc/letsencrypt /srv/peering/site

# Logs go to the journal, where `journalctl -u peeringd` finds them and where a restart is
# visible as its own line.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=peeringd

[Install]
WantedBy=multi-user.target
