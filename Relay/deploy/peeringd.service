# peeringd, as a service.
#
# Install: see "Keeping it running" in Relay/README.md.
#
# This file exists because of a specific afternoon. The relay stopped, and nobody knew: the first
# sign was the site answering 502, found by hand, hours later. A process started from a shell
# dies with the shell; a unit with `Restart=always` gets up again in two seconds and, more to the
# point, can be *asked* whether it is up.

[Unit]
Description=Peering relay (peeringd)
Documentation=https://getpeering.app/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# A user of its own. The relay has no reason to be root: it reads a site directory and a
# certificate, and the only thing it writes is the day's relay-time counter.
User=peeringd
Group=peeringd
WorkingDirectory=/opt/peeringd

# The counter's home. systemd creates it owned by the service user and, under the
# `ProtectSystem=strict` below, it is the one path that stays writable, which is why this is a
# `StateDirectory` rather than a directory an install step has to make and get the ownership of
# right. See "Relay time is remembered" in the README.
StateDirectory=peeringd

# Where the counter goes, spelled after the `StateDirectory` above so that changing the directory
# changes this too. **Before the `EnvironmentFile` rather than after it**, and the order is the
# whole of the decision: systemd applies these in the order they appear, so a value in the
# operator's file wins over this line, where the other way round the file would be quietly
# overruled by a default.
Environment=PEERINGD_USAGE_LOG=%S/peeringd/usage.log

# Every setting the relay takes, in one root-owned file — so the unit file can stay in version
# control without carrying a certificate path or an API key. See the environment table in the
# README for what goes in it.
EnvironmentFile=/etc/peeringd/peeringd.env

ExecStart=/opt/peeringd/peeringd

# The whole reason this file exists. `Restart=always` rather than `on-failure`, because a clean
# exit is also an outage — a signal, an operator's mistake, a panic that unwound tidily.
Restart=always
RestartSec=2

# The README suggests binding 443 when it is free, since it is the one port that guest and
# corporate networks never block. That is below 1024, which a non-root process cannot bind
# without this — and with it, it can bind nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The relay's design principle is that it should be too stupid to break the property it exists to
# provide — it copies bytes it cannot read. These settings are the same idea applied from the
# outside: if it cannot write anywhere, spawn anything, or see the rest of the machine, then a
# bug in it has very little to work with.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# The site is read-only, and so is everything else except the state directory `StateDirectory=`
# above declares. `ProtectSystem=strict` makes the filesystem read-only, and the state directory
# is the one hole systemd opens in it for this service. The certificate directory has to be
# readable, which it is: read-only is not hidden, and the site and the certificate both are.
ReadOnlyPaths=/opt/peeringd /etc/peeringd /etc/letsencrypt

# Logs go to the journal, where `journalctl -u peeringd` finds them and where a restart is
# visible as its own line.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=peeringd

[Install]
WantedBy=multi-user.target
