        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non maintenu : ce Mac se met en veille tout seul"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gehalten: Dieser Mac schläft von selbst"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não mantido: este Mac repousa sozinho"
