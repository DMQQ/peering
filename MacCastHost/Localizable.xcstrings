    "%@ reached this Mac over the relay. Read the six digits out to whoever is holding it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ llegó a este Mac a través del relay. Lee los seis dígitos a quien lo tenga en la mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a joint ce Mac via le relais. Lisez les six chiffres à la personne qui le tient."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat diesen Mac über das Relay erreicht. Lies die sechs Ziffern der Person vor, die es in der Hand hält."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ alcançou este Mac pelo relay. Leia os seis dígitos para quem está com ele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がリレー経由でこのMacに到達しました。持っている人に6桁の数字を読み上げてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 릴레이를 통해 이 Mac에 접속했습니다. 가지고 있는 사람에게 여섯 자리 숫자를 읽어 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已通过中继访问这台 Mac。请把六位数字读给拿着它的人。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ подключился к этому Mac через релей. Назовите шесть цифр тому, у кого он в руках."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha raggiunto questo Mac tramite il relay. Leggi le sei cifre a chi lo ha in mano."
          }
        }
      }
    },
    "Scan this code with Peering, or enter the six digits on %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código con Peering, o introduce los seis dígitos en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce code avec Peering, ou saisissez les six chiffres sur %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen Code mit Peering oder gib die sechs Ziffern auf %@ ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie este código com o Peering, ou digite os seis dígitos em %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peeringでこのコードをスキャンするか、%@に6桁の数字を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering으로 이 코드를 스캔하거나 %@에 여섯 자리 숫자를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Peering 扫描此代码，或在%@上输入这六位数字。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте этот код в Peering или введите шесть цифр на %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona questo codice con Peering, oppure inserisci le sei cifre su %@."
          }
        }
      }
    },
