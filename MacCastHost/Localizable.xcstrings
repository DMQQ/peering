    "Could not %@ (%@). If you are running the app from outside your Applications folder, move it there and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo %@ (%@). Si ejecutas la app desde fuera de la carpeta Aplicaciones, muévela allí e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de %@ (%@). Si vous exécutez l'app depuis un autre endroit que le dossier Applications, déplacez-la-y et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nicht möglich (%@). Wenn du die App von außerhalb des Ordners Programme ausführst, verschiebe sie dorthin und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível %@ (%@). Se você executa o app fora da pasta Aplicativos, mova-o para lá e tente de novo."
