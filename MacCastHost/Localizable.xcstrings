    "After allowing Screen Recording in System Settings, relaunch Peering to apply it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras permitir la Grabación de pantalla en Ajustes del Sistema, reinicia Peering para aplicarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir autorisé l'Enregistrement d'écran dans Réglages Système, relancez Peering pour l'appliquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Peering neu, nachdem du Bildschirmaufnahme in den Systemeinstellungen erlaubt hast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de permitir a Gravação de Tela em Ajustes do Sistema, reabra o Peering para aplicá-la."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で画面収録を許可したあと、Peeringを再起動して反映してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 화면 기록을 허용한 뒤 Peering을 다시 열어 적용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“系统设置”中允许“屏幕录制”后，请重新打开 Peering 使其生效。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После разрешения «Записи экрана» в Системных настройках перезапустите Peering, чтобы применить его."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver consentito Registrazione schermo in Impostazioni di Sistema, riavvia Peering per applicarla."
          }
        }
      }
    },
    "Peering will continue automatically as soon as both permissions are allowed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering continuará automáticamente en cuanto se permitan ambos permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering continuera automatiquement dès que les deux autorisations seront accordées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering macht automatisch weiter, sobald beide Berechtigungen erteilt sind."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering continuará automaticamente assim que as duas permissões forem permitidas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の許可が与えられると、Peeringは自動的に続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 권한이 모두 허용되는 즉시 Peering이 자동으로 계속합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两项权限都允许后，Peering 会自动继续。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering продолжит автоматически, как только будут даны оба разрешения."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering proseguirà automaticamente non appena entrambe le autorizzazioni saranno concesse."
          }
        }
      }
    },
