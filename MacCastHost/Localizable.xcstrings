    "Peering needs Screen Recording and Accessibility before a phone can connect.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering necesita Grabación de pantalla y Accesibilidad antes de que un teléfono pueda conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering a besoin de l'Enregistrement d'écran et de l'Accessibilité avant qu'un téléphone puisse se connecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering braucht Bildschirmaufnahme und Bedienungshilfen, bevor sich ein Telefon verbinden kann."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering precisa de Gravação de Tela e Acessibilidade antes que um telefone possa se conectar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneが接続できるようになる前に、Peeringには画面収録とアクセシビリティが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 연결되려면 먼저 Peering에 화면 기록과 손쉬운 사용이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机连接之前，Peering 需要“屏幕录制”和“辅助功能”权限。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering нужны «Запись экрана» и «Универсальный доступ», прежде чем телефон сможет подключиться."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering ha bisogno di Registrazione schermo e Accessibilità prima che un telefono possa connettersi."
          }
        }
      }
    },
