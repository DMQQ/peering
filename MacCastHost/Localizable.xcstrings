      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un dispositivo conectado pero no ha elegido qué mostrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil est connecté mais n'a pas choisi quoi montrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gerät ist verbunden, hat aber noch nicht gewählt, was es zeigen soll."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dispositivo está conectado, mas não escolheu o que mostrar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスは接続されていますが、何を表示するかまだ選んでいません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 연결되어 있지만 무엇을 보여 줄지 아직 선택하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有设备已连接，但尚未选择要显示的内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство подключено, но ещё не выбрало, что показывать."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo è connesso ma non ha scelto cosa mostrare."
          }
        }
