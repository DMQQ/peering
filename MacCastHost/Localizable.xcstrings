    "Press Start to make this Mac available.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Iniciar para que este Mac esté disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
