          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke Start, um diesen Mac verfügbar zu machen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione Iniciar para deixar este Mac disponível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始を押すと、このMacが利用可能になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
