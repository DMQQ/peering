    "%@ can now reconnect automatically.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya puede reconectarse automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ peut maintenant se reconnecter automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann sich jetzt automatisch wieder verbinden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ agora pode se reconectar automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は自動的に再接続できるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이제 자동으로 다시 연결할 수 있습니다."
          }
        },
        "zh-Hans": {
