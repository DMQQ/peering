    "This Mac is available on your network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac está disponible en tu red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac est disponible sur votre réseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac ist in deinem Netzwerk verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac está disponível na sua rede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはネットワーク上で利用可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 네트워크에서 사용할 수 있습니다."
          }
        },
