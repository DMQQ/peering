    "Press Start first. A Mac that is not hosting is not registered with the relay, so no device can reach it by this ID.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Iniciar primero. Un Mac que no está alojando no está registrado en el relay, así que ningún dispositivo puede alcanzarlo con este ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez d'abord sur Démarrer. Un Mac qui n'héberge pas n'est pas enregistré auprès du relais, aucun appareil ne peut donc le joindre avec cet ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke zuerst Start. Ein Mac, der nicht hostet, ist nicht beim Relay registriert, daher kann ihn kein Gerät über diese ID erreichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione Iniciar primeiro. Um Mac que não está hospedando não está registrado no relay, então nenhum dispositivo o alcança por este ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず開始を押してください。ホストしていないMacはリレーに登録されないため、このIDでは誰も接続できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 시작을 누르세요. 호스팅하지 않는 Mac은 릴레이에 등록되지 않으므로 어떤 기기도 이 ID로 접속할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先按“开始”。未托管的 Mac 不会在中继注册，因此没有设备能通过此 ID 访问它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала нажмите «Пуск». Mac, который не размещает, не зарегистрирован на релее, поэтому ни одно устройство не доберётся до него по этому ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi prima Avvia. Un Mac che non fa hosting non è registrato sul relay, quindi nessun dispositivo può raggiungerlo con questo ID."
          }
        }
      }
    },
    "Copies the device ID on its own, for pasting into Peering on the iPhone": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia solo el ID de dispositivo, para pegarlo en Peering en el iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie uniquement l'ID d'appareil, à coller dans Peering sur l'iPhone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert nur die Geräte-ID, zum Einfügen in Peering auf dem iPhone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia só o ID do dispositivo, para colar no Peering do iPhone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスIDだけをコピーします。iPhoneのPeeringに貼り付けられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 ID만 복사합니다. iPhone의 Peering에 붙여넣을 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅拷贝设备 ID，以便粘贴到 iPhone 上的 Peering"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирует только ID устройства, чтобы вставить в Peering на iPhone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia solo l'ID dispositivo, da incollare in Peering sull'iPhone"
          }
        }
      }
    },
