            "state": "translated",
            "value": "Autoriser Peering à accéder à ce Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering Zugriff auf diesen Mac erlauben"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que o Peering acesse este Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PeeringにこのMacへのアクセスを許可"
          }
        },
        "ko": {
