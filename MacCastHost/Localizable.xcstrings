          "stringUnit": {
            "state": "translated",
            "value": "Continuar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua"
          }
        }
      }
    },
    "After a restart": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras un reinicio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après un redémarrage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Neustart"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após uma reinicialização"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動後"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시동 후"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动后"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После перезагрузки"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo un riavvio"
          }
        }
      }
    },
    "Peering has to be running to be reached. Open it at login if this Mac should be reachable after it restarts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering tiene que estar en ejecución para poder alcanzarse. Ábrelo al iniciar sesión si este Mac debe ser accesible tras reiniciarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering doit être en cours d'exécution pour être joignable. Ouvrez-le à l'ouverture de session si ce Mac doit rester joignable après un redémarrage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering muss laufen, um erreichbar zu sein. Öffne es bei der Anmeldung, wenn dieser Mac nach einem Neustart erreichbar sein soll."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering precisa estar em execução para ser alcançado. Abra-o ao iniciar a sessão se este Mac deve ficar acessível depois de reiniciar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peeringは起動していないと接続できません。再起動後もこのMacに接続できるようにするには、ログイン時に開くようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering이 실행 중이어야 접속할 수 있습니다. 재시동 후에도 이 Mac에 접속하려면 로그인 시 열리도록 설정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering 必须在运行才能被访问。如果希望这台 Mac 重新启动后仍可访问，请设为登录时打开。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering должен быть запущен, чтобы до него можно было достучаться. Открывайте его при входе, если этот Mac должен быть доступен после перезагрузки."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering deve essere in esecuzione per essere raggiungibile. Aprilo all'accesso se questo Mac deve restare raggiungibile dopo un riavvio."
          }
        }
      }
    },
    "Leaving this Mac at home": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar este Mac en casa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser ce Mac à la maison"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Mac zu Hause lassen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixando este Mac em casa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacを自宅に置いたまま"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac을 집에 두고"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这台 Mac 留在家里"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставить этот Mac дома"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciare questo Mac a casa"
          }
        }
      }
    },
    "Optional, and all off to begin with. Turn them on to close the lid, walk out, and still reach this Mac from your iPhone. Change these anytime from Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional, y todo desactivado al principio. Actívalo para cerrar la tapa, salir y seguir accediendo a este Mac desde tu iPhone. Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif, et tout est désactivé au départ. Activez-les pour fermer le capot, partir et continuer à joindre ce Mac depuis votre iPhone. Modifiable à tout moment dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional, und zu Beginn alles aus. Schalte es ein, um den Deckel zu schließen, wegzugehen und diesen Mac trotzdem von deinem iPhone zu erreichen. Jederzeit in den Einstellungen änderbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional, e tudo desligado no início. Ligue para fechar a tampa, sair e ainda acessar este Mac pelo iPhone. Mude quando quiser em Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意で、最初はすべてオフです。オンにすると、蓋を閉じて外出しても、iPhoneからこのMacに接続できます。設定からいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이며, 처음에는 모두 꺼져 있습니다. 켜면 덮개를 닫고 나가도 iPhone에서 이 Mac에 접속할 수 있습니다. 설정에서 언제든 바꿀 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选，一开始全部关闭。打开后，合上盖子出门，仍能从 iPhone 访问这台 Mac。可随时在“设置”中更改。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно, и вначале всё выключено. Включите, чтобы закрыть крышку, уйти и всё равно подключаться к этому Mac с iPhone. Изменить можно в любой момент в Настройках."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo, e tutto disattivato all'inizio. Attivalo per chiudere il coperchio, uscire e raggiungere comunque questo Mac dal tuo iPhone. Modificabile in qualsiasi momento in Impostazioni."
          }
        }
      }
    },
