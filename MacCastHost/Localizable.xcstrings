    "Disconnect %@. It stays trusted and can reconnect": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar %@. Sigue siendo de confianza y puede reconectarse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter %@. Il reste de confiance et peut se reconnecter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trennen. Das Gerät bleibt vertrauenswürdig und kann sich wieder verbinden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar %@. Continua confiável e pode se reconectar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を切断します。信頼済みのままで、再接続できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 연결 해제. 신뢰는 유지되며 다시 연결할 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开 %@。它仍受信任，可以重新连接"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить %@. Он остаётся доверенным и может переподключиться"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnetti %@. Resta attendibile e può riconnettersi"
          }
        }
      }
    },
    "Forget %@. It will have to pair again": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar %@. Tendrá que emparejarse de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier %@. Il devra s'associer à nouveau"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entfernen. Es muss erneut gekoppelt werden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer %@. Precisará parear de novo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を削除します。もう一度ペアリングが必要になります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 삭제. 다시 페어링해야 합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@。它将需要重新配对"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть %@. Ему придётся связываться заново"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimentica %@. Dovrà associarsi di nuovo"
          }
        }
      }
    },
    "Copy all": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar todo"
          }
        },
        "fr": {
