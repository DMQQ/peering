    "Not on this Wi-Fi? Scan this from Peering on your iPhone, or type the ID in by hand.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No estás en este Wi-Fi? Escanea esto desde Peering en tu iPhone, o escribe el ID a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas sur ce Wi-Fi ? Scannez ceci depuis Peering sur votre iPhone, ou saisissez l'ID à la main."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht in diesem WLAN? Scanne dies in Peering auf deinem iPhone oder gib die ID von Hand ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está neste Wi-Fi? Escaneie isto no Peering do iPhone, ou digite o ID à mão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このWi-Fiにいませんか？iPhoneのPeeringでこれをスキャンするか、IDを手で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Wi-Fi에 없나요? iPhone의 Peering에서 이것을 스캔하거나 ID를 직접 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
