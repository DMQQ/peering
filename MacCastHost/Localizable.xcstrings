          }
        }
      }
    },
    "If discovery is blocked where you are, enter this Mac's address and port %@ by hand.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el descubrimiento está bloqueado donde estás, introduce a mano la dirección de este Mac y el puerto %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la découverte est bloquée là où vous êtes, saisissez à la main l'adresse de ce Mac et le port %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Erkennung dort, wo du bist, blockiert ist, gib die Adresse dieses Macs und den Port %@ von Hand ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a descoberta estiver bloqueada onde você está, digite à mão o endereço deste Mac e a porta %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いの場所でデバイスの検出がブロックされている場合は、このMacのアドレスとポート%@を手動で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "있는 곳에서 검색이 차단되어 있다면, 이 Mac의 주소와 포트 %@을(를) 직접 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你所在的地方发现功能被阻止，请手动输入这台 Mac 的地址和端口 %@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если обнаружение заблокировано там, где вы находитесь, введите вручную адрес этого Mac и порт %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il rilevamento è bloccato dove ti trovi, inserisci a mano l'indirizzo di questo Mac e la porta %@."
          }
        }
      }
    },
