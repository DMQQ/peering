        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@できませんでした（%@）。アプリを「アプリケーション」フォルダの外から実行している場合は、そこに移動してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@할 수 없었습니다(%@). 앱을 응용 프로그램 폴더 밖에서 실행 중이라면 그곳으로 옮긴 다음 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法%@（%@）。如果你是从“应用程序”文件夹之外运行 App，请把它移到那里再试一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось: %@ (%@). Если вы запускаете приложение не из папки «Программы», переместите его туда и повторите попытку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile %@ (%@). Se esegui l'app da fuori della cartella Applicazioni, spostala lì e riprova."
          }
        }
      }
    },
    "Could not run %@: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo ejecutar %@: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'exécuter %@ : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht ausgeführt werden: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível executar %@: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を実行できませんでした: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 실행할 수 없었습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法运行 %@：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить %@: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eseguire %@: %@"
          }
        }
      }
    },
    "Could not change the sleep setting (sudo exited %d).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar el ajuste de reposo (sudo terminó con %d)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier le réglage de veille (sudo s'est terminé avec %d)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ruhezustandseinstellung konnte nicht geändert werden (sudo endete mit %d)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alterar o ajuste de repouso (o sudo terminou com %d)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ設定を変更できませんでした（sudoが%dで終了しました）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기 설정을 변경할 수 없었습니다(sudo가 %d(으)로 종료됨)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改休眠设置（sudo 以 %d 退出）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось изменить настройку сна (sudo завершился с кодом %d)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile modificare l'impostazione di stop (sudo è terminato con %d)."
          }
        }
      }
    },
    "Peering needs to install a rule that lets it stop this Mac sleeping with the lid closed. The rule allows two commands: pmset -a disablesleep 1, and pmset -a disablesleep 0.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering necesita instalar una regla que le permita impedir que este Mac duerma con la tapa cerrada. La regla permite dos comandos: pmset -a disablesleep 1 y pmset -a disablesleep 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering doit installer une règle qui lui permet d'empêcher ce Mac de dormir capot fermé. La règle autorise deux commandes : pmset -a disablesleep 1 et pmset -a disablesleep 0."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering muss eine Regel installieren, die es erlaubt, diesen Mac am Schlafen bei geschlossenem Deckel zu hindern. Die Regel erlaubt zwei Befehle: pmset -a disablesleep 1 und pmset -a disablesleep 0."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering precisa instalar uma regra que o deixa impedir este Mac de repousar com a tampa fechada. A regra permite dois comandos: pmset -a disablesleep 1 e pmset -a disablesleep 0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peeringは、蓋を閉じたときにこのMacがスリープしないようにするためのルールをインストールする必要があります。このルールで許可されるコマンドは2つだけです: pmset -a disablesleep 1 と pmset -a disablesleep 0。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering은 덮개를 닫았을 때 이 Mac이 잠자기하지 않도록 하는 규칙을 설치해야 합니다. 이 규칙은 두 가지 명령만 허용합니다: pmset -a disablesleep 1 그리고 pmset -a disablesleep 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering 需要安装一条规则，使它能阻止这台 Mac 在合盖时休眠。该规则只允许两条命令：pmset -a disablesleep 1 和 pmset -a disablesleep 0。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering нужно установить правило, позволяющее ему не давать этому Mac засыпать при закрытой крышке. Правило разрешает две команды: pmset -a disablesleep 1 и pmset -a disablesleep 0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering deve installare una regola che gli permette di impedire a questo Mac di andare in stop a coperchio chiuso. La regola consente due comandi: pmset -a disablesleep 1 e pmset -a disablesleep 0."
          }
        }
      }
    },
    "Peering will remove its administrator rule and let this Mac sleep normally again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering quitará su regla de administrador y dejará que este Mac duerma con normalidad otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering retirera sa règle d'administrateur et laissera ce Mac dormir normalement à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering entfernt seine Administratorregel und lässt diesen Mac wieder normal schlafen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering removerá sua regra de administrador e deixará este Mac repousar normalmente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peeringは管理者ルールを削除し、このMacを再び通常どおりスリープさせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering이 관리자 규칙을 제거하고 이 Mac이 다시 정상적으로 잠자기하게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering 将移除它的管理员规则，并让这台 Mac 再次正常休眠。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering удалит своё правило администратора и снова позволит этому Mac спать как обычно."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering rimuoverà la sua regola di amministratore e lascerà che questo Mac vada di nuovo in stop normalmente."
          }
        }
      }
    },
    "Peering will wake this Mac at %@ every day.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering despertará este Mac a las %@ todos los días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering réveillera ce Mac à %@ chaque jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering weckt diesen Mac jeden Tag um %@ auf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering despertará este Mac às %@ todos os dias."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peeringは毎日%@にこのMacを起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering이 매일 %@에 이 Mac을 깨웁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering 每天会在 %@ 唤醒这台 Mac。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering будет будить этот Mac в %@ каждый день."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering risveglierà questo Mac alle %@ ogni giorno."
          }
        }
      }
    },
    "Peering will take away the daily wake it set for this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering quitará el despertar diario que configuró para este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering retirera le réveil quotidien qu'il a défini pour ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering nimmt das tägliche Aufwachen zurück, das es für diesen Mac festgelegt hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering retirará o despertar diário que definiu para este Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peeringは、このMacに設定した毎日の起動を取り除きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering이 이 Mac에 설정한 매일 깨우기를 제거합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering 将取消它为这台 Mac 设置的每日唤醒。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering уберёт ежедневное пробуждение, которое он задал для этого Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering toglierà la riattivazione giornaliera che ha impostato per questo Mac."
          }
        }
      }
    },
    "The administrator prompt did not finish (osascript exited %d).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud de administrador no terminó (osascript terminó con %d)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande d'administrateur ne s'est pas terminée (osascript s'est terminé avec %d)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Administratorabfrage wurde nicht abgeschlossen (osascript endete mit %d)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pedido de administrador não terminou (o osascript terminou com %d)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者の確認が完了しませんでした（osascriptが%dで終了しました）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 확인이 끝나지 않았습니다(osascript가 %d(으)로 종료됨)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理员提示未完成（osascript 以 %d 退出）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос администратора не завершился (osascript завершился с кодом %d)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta di amministratore non si è conclusa (osascript è terminato con %d)."
          }
        }
      }
    },
    "This Mac stays awake from %@ to %@, and sleeps the rest of the time unless you are connected to it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac se mantiene despierto de %@ a %@, y duerme el resto del tiempo salvo que estés conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac reste éveillé de %@ à %@, et dort le reste du temps sauf si vous y êtes connecté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac bleibt von %@ bis %@ wach und schläft die übrige Zeit, außer du bist mit ihm verbunden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac fica acordado das %@ às %@, e repousa no resto do tempo, a menos que você esteja conectado a ele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacは%@から%@まで起動したままで、それ以外の時間は、接続していない限りスリープします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 %@부터 %@까지 깨어 있고, 그 외 시간에는 연결되어 있지 않은 한 잠자기합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 从 %@ 到 %@ 保持唤醒，其余时间会休眠，除非你已连接到它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac бодрствует с %@ до %@ и спит остальное время, если вы не подключены к нему."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac resta sveglio dalle %@ alle %@, e va in stop il resto del tempo a meno che tu non sia connesso."
          }
        }
      }
    },
    " The lid-close switch below needs its administrator rule before this can release it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " El interruptor de la tapa de abajo necesita su regla de administrador antes de que esto pueda soltarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " L'interrupteur du capot ci-dessous a besoin de sa règle d'administrateur avant que ceci puisse le relâcher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Der Deckel-Schalter unten braucht seine Administratorregel, bevor dies ihn lösen kann."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " O botão da tampa abaixo precisa da regra de administrador dele antes que isto possa soltá-lo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 下の蓋のスイッチには管理者ルールが必要で、それがないとこれを解除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 아래의 덮개 스위치에는 관리자 규칙이 필요하며, 그래야 이것이 해제할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 下面的合盖开关需要它的管理员规则，之后这个才能将其释放。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Переключателю крышки ниже нужно его правило администратора, прежде чем это сможет его отпустить."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " L'interruttore del coperchio qui sotto ha bisogno della sua regola di amministratore prima che questo possa rilasciarlo."
          }
        }
      }
    },
    "Off. The switches above keep this Mac awake all day and all night.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. Los interruptores de arriba mantienen este Mac despierto todo el día y toda la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé. Les interrupteurs ci-dessus gardent ce Mac éveillé jour et nuit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus. Die Schalter oben halten diesen Mac Tag und Nacht wach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado. Os botões acima mantêm este Mac acordado dia e noite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ。上のスイッチは、このMacを昼も夜も起動したままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐. 위의 스위치들이 이 Mac을 밤낮으로 깨어 있게 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关。上面的开关会让这台 Mac 昼夜保持唤醒。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл. Переключатели выше держат этот Mac бодрствующим днём и ночью."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato. Gli interruttori sopra tengono questo Mac sveglio giorno e notte."
          }
        }
      }
    },
    "Off. Once this Mac has slept, nothing can reach it until something wakes it, and nothing here will.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. Una vez que este Mac ha dormido, nada puede alcanzarlo hasta que algo lo despierte, y nada de aquí lo hará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé. Une fois que ce Mac s'est mis en veille, rien ne peut l'atteindre jusqu'à ce que quelque chose le réveille, et rien ici ne le fera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus. Sobald dieser Mac geschlafen hat, kann ihn nichts erreichen, bis ihn etwas aufweckt, und nichts hier wird es tun."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado. Depois que este Mac repousa, nada pode alcançá-lo até que algo o desperte, e nada aqui fará isso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ。このMacが一度スリープすると、何かが起こすまで何も届かず、ここには起こすものがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐. 이 Mac이 한 번 잠자기하면 무언가가 깨울 때까지 아무것도 닿을 수 없고, 여기에는 깨울 것이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关。这台 Mac 一旦休眠，在有东西唤醒它之前什么都无法访问它，而这里没有任何东西会唤醒它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл. Когда этот Mac заснёт, ничто не сможет его достичь, пока что-то его не разбудит, и ничто здесь этого не сделает."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato. Una volta che questo Mac è andato in stop, nulla può raggiungerlo finché qualcosa non lo risveglia, e nulla qui lo farà."
          }
        }
      }
    },
    "Peering uses this to turn gestures and keys from your iPhone into input on this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering lo usa para convertir los gestos y las teclas de tu iPhone en entrada en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering s'en sert pour transformer les gestes et les touches de votre iPhone en saisie sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering nutzt dies, um Gesten und Tasten von deinem iPhone in Eingaben auf diesem Mac umzusetzen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering usa isto para transformar gestos e teclas do iPhone em entrada neste Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peeringはこれを使って、iPhoneからのジェスチャーやキーをこのMacへの入力に変換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering은 이것으로 iPhone의 제스처와 키를 이 Mac의 입력으로 바꿉니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering 用它把你的 iPhone 上的手势和按键转换为这台 Mac 上的输入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering использует это, чтобы превращать жесты и клавиши с вашего iPhone в ввод на этом Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering lo usa per trasformare i gesti e i tasti del tuo iPhone in input su questo Mac."
          }
        }
      }
    },
    "Without it, you can see the Mac but cannot control it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin él, puedes ver el Mac pero no controlarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans elle, vous voyez le Mac mais ne pouvez pas le contrôler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne sie siehst du den Mac, kannst ihn aber nicht steuern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem isso, você vê o Mac mas não consegue controlá-lo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これがないと、Macは見えても操作できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것이 없으면 Mac을 볼 수는 있지만 제어할 수는 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有它，你能看到 Mac，但无法控制它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без него вы видите Mac, но не можете им управлять."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza, puoi vedere il Mac ma non controllarlo."
          }
        }
      }
    },
    "Peering uses this to send a live picture of this Mac to your iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering lo usa para enviar una imagen en vivo de este Mac a tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering s'en sert pour envoyer une image en direct de ce Mac vers votre iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering nutzt dies, um ein Live-Bild dieses Macs an dein iPhone zu senden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Peering usa isto para enviar uma imagem ao vivo deste Mac ao seu iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peeringはこれを使って、このMacのライブ映像をiPhoneに送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering은 이것으로 이 Mac의 실시간 화면을 iPhone으로 보냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering 用它把这台 Mac 的实时画面发送到你的 iPhone。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering использует это, чтобы отправлять живую картинку этого Mac на ваш iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peering lo usa per inviare un'immagine dal vivo di questo Mac al tuo iPhone."
          }
        }
      }
    },
    "Without it, your iPhone connects to a black screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin él, tu iPhone se conecta a una pantalla negra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans elle, votre iPhone se connecte à un écran noir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne sie verbindet sich dein iPhone mit einem schwarzen Bildschirm."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem isso, seu iPhone se conecta a uma tela preta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これがないと、iPhoneは黒い画面に接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것이 없으면 iPhone은 검은 화면에 연결됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有它，你的 iPhone 会连接到黑屏。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без него ваш iPhone подключается к чёрному экрану."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza, il tuo iPhone si connette a uno schermo nero."
          }
        }
      }
    }
  },
  "version": "1.0"
}